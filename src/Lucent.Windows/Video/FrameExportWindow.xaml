<Window x:Class="Lucent.FrameExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Lucent.Windows"
        Title="Save frames - Lucent"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The same look as Record video's (VideoExportWindow.xaml). -->
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Saves a stretch of a video in the editor as images, or as an animated GIF (EditorWindow.Video.cs). -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <StackPanel>
            <!-- Title bar -->
            <Grid Height="40">
                <TextBlock x:Name="Heading" Text="SAVE FRAMES" Margin="20,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <StackPanel x:Name="OptionsArea" Margin="20,0,20,0">
                <TextBlock x:Name="RangeText" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,0"
                           Foreground="{DynamicResource TextBrush}" />

                <!-- Images -->
                <StackPanel x:Name="FramesPanel">
                    <TextBlock Style="{StaticResource OptionLabel}" Text="Frames" />
                    <w:RoundedBorder Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Rate" Tag="0" Content="Every frame" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Rate" Tag="10" Content="10 a second" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Rate" Tag="5" Content="5 a second" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Rate" Tag="1" Content="1 a second" Click="OnOptionChosen" />
                        </UniformGrid>
                    </w:RoundedBorder>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Format" />
                    <w:RoundedBorder Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Format" Tag="Png" Content="PNG" Click="OnOptionChosen" />
                            <RadioButton x:Name="JpegChoice" Style="{StaticResource SegmentButton}" GroupName="Format" Tag="Jpeg" Content="JPEG" Click="OnOptionChosen" />
                        </UniformGrid>
                    </w:RoundedBorder>
                    <TextBlock x:Name="FramesHint" Style="{StaticResource OptionHint}" />

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Save in" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="CHANGE" Margin="10,0,0,0"
                                Click="OnChooseFolder" />
                        <TextBlock x:Name="FolderText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                    <TextBlock x:Name="FolderHint" Style="{StaticResource OptionHint}" />
                </StackPanel>

                <!-- GIF -->
                <StackPanel x:Name="GifPanel">
                    <TextBlock Style="{StaticResource OptionLabel}" Text="Width" />
                    <w:RoundedBorder Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Width" Tag="320" Content="320" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Width" Tag="480" Content="480" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Width" Tag="640" Content="640" Click="OnOptionChosen" />
                            <RadioButton x:Name="FullWidthChoice" Style="{StaticResource SegmentButton}" GroupName="Width" Tag="0" Content="Full" Click="OnOptionChosen" />
                        </UniformGrid>
                    </w:RoundedBorder>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Frame rate" />
                    <w:RoundedBorder Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="GifRate" Tag="10" Content="10 fps" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="GifRate" Tag="15" Content="15 fps" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="GifRate" Tag="24" Content="24 fps" Click="OnOptionChosen" />
                        </UniformGrid>
                    </w:RoundedBorder>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Plays" />
                    <w:RoundedBorder Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loop" Tag="True" Content="Over and over" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Loop" Tag="False" Content="Once" Click="OnOptionChosen" />
                        </UniformGrid>
                    </w:RoundedBorder>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Dithering" />
                    <w:RoundedBorder Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Dither" Tag="True" Content="On" Click="OnOptionChosen" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Dither" Tag="False" Content="Off" Click="OnOptionChosen" />
                        </UniformGrid>
                    </w:RoundedBorder>
                    <TextBlock x:Name="GifHint" Style="{StaticResource OptionHint}" />

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Save as" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="CHANGE" Margin="10,0,0,0"
                                Click="OnChooseFile" />
                        <TextBlock x:Name="FileText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>

            <DockPanel Margin="20,18,20,18" LastChildFill="False">
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnSave">
                    <TextBlock Text="Save" FontWeight="SemiBold" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Cancel" Click="OnCancel" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
