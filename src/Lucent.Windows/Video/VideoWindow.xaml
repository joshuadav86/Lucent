<Window x:Class="WinampInspiredVisualizer.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:WinampInspiredVisualizer.Windows"
        Title="Video - Lucent"
        Icon="Assets/Lucent.ico"
        Width="640" Height="396" MinWidth="320" MinHeight="216"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        Closing="OnClosing"
        Closed="OnClosed">

    <!-- Same custom title bar as the main window, with native resizing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot" Background="{DynamicResource PanelSheenBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: what's playing, lock, full screen and close. -->
        <DockPanel Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <w:LockButton Style="{StaticResource PanelToggle}" Padding="8,0" Margin="0,0,2,0" VerticalAlignment="Center" />
                <Button x:Name="FullScreenButton" Style="{StaticResource CaptionButton}" Height="36"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="FullScreenIcon" Style="{StaticResource CaptionIcon}" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Height="36" ToolTip="Close (P)"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="/Assets/Lucent-64.png" Width="14" Height="14" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="VIDEO" Margin="9,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TitleText" Margin="12,0,8,0" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
        </DockPanel>

        <!-- The picture, as big as fits, letterboxed in black. Click to play or pause, double-click for full screen,
             right-click for the menu. -->
        <Grid x:Name="Picture" Grid.Row="1" Background="Black" Cursor="Arrow"
              MouseLeftButtonDown="OnPictureMouseDown" MouseLeftButtonUp="OnPictureMouseUp"
              MouseRightButtonUp="OnPictureRightClick" MouseMove="OnPictureMouseMove">
            <Image x:Name="VideoImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="Linear" />
            <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                    <Path Data="{StaticResource VideoIcon}" Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="1"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Viewbox>
                <TextBlock x:Name="PlaceholderTitle" Text="No video playing" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#E6FFFFFF" />
                <TextBlock x:Name="PlaceholderText" Text="Videos and video stations play here, beside the visuals."
                           Margin="0,4,0,0" FontSize="11" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Foreground="#99FFFFFF" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
