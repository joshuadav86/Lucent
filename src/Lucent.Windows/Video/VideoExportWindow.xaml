<Window x:Class="Lucent.VideoExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record video - Lucent"
        Icon="Assets/Lucent.ico"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The same look as the converter's (ExportWindow.xaml). -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource HairlineBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentGradientBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <StackPanel>
            <!-- Title bar -->
            <Grid Height="40">
                <TextBlock Text="RECORD VIDEO" Margin="20,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseButton">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <StackPanel x:Name="OptionsArea" Margin="20,0,20,0">
                <TextBlock x:Name="TrackText" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,0"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBlock Style="{StaticResource OptionLabel}" Text="Visual" />
                <Button x:Name="VisualButton" Style="{StaticResource PickerButton}" HorizontalContentAlignment="Stretch"
                        Click="OnChooseVisual">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                        <TextBlock x:Name="VisualText" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <TextBlock x:Name="VisualHint" Style="{StaticResource OptionHint}" />

                <TextBlock Style="{StaticResource OptionLabel}" Text="Record" />
                <Border Style="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="WholeSong" Style="{StaticResource SegmentButton}" GroupName="Part"
                                     Content="The whole song" Click="OnPartChosen" />
                        <RadioButton x:Name="PartOfSong" Style="{StaticResource SegmentButton}" GroupName="Part"
                                     Content="Part of it" Click="OnPartChosen" />
                    </UniformGrid>
                </Border>
                <StackPanel x:Name="RangePanel">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="From" FontSize="12" Width="44" Margin="2,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="FromInput" Style="{StaticResource TextInput}" Width="96" TextChanged="OnRangeChanged" />
                        <TextBlock Text="to" FontSize="12" Margin="14,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="ToInput" Style="{StaticResource TextInput}" Width="96" HorizontalAlignment="Left"
                                 TextChanged="OnRangeChanged" />
                    </DockPanel>
                    <TextBlock x:Name="RangeHint" Style="{StaticResource OptionHint}" />
                </StackPanel>

                <TextBlock Style="{StaticResource OptionLabel}" Text="Size" />
                <Border Style="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Size" Tag="1080" Content="1080p" Click="OnOptionChosen" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Size" Tag="1440" Content="1440p" Click="OnOptionChosen" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Size" Tag="2160" Content="4K" Click="OnOptionChosen" />
                    </UniformGrid>
                </Border>

                <TextBlock Style="{StaticResource OptionLabel}" Text="Frame rate" />
                <Border Style="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="FrameRate" Tag="30" Content="30 fps" Click="OnOptionChosen" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="FrameRate" Tag="60" Content="60 fps" Click="OnOptionChosen" />
                    </UniformGrid>
                </Border>

                <TextBlock Style="{StaticResource OptionLabel}" Text="Quality" />
                <Border Style="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Quality" Tag="Good" Content="Good" Click="OnOptionChosen" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Quality" Tag="High" Content="High" Click="OnOptionChosen" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Quality" Tag="Best" Content="Best" Click="OnOptionChosen" />
                    </UniformGrid>
                </Border>
                <TextBlock x:Name="QualityHint" Style="{StaticResource OptionHint}" />

                <TextBlock Style="{StaticResource OptionLabel}" Text="Save as" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="CHANGE" Margin="10,0,0,0"
                            Click="OnChooseFile" />
                    <TextBlock x:Name="FileText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                </DockPanel>
                <TextBlock Style="{StaticResource OptionHint}"
                           Text="Drawn frame by frame with the detail and glow set in Options, so nothing is ever skipped: it can take more or less time than the song lasts. The visuals and music carry on as usual meanwhile." />
            </StackPanel>

            <!-- Progress and the result -->
            <StackPanel x:Name="ProgressArea" Margin="20,16,20,0" Visibility="Collapsed">
                <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}" />
                <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <DockPanel Margin="20,18,20,18" LastChildFill="False">
                <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnPrimary">
                    <TextBlock x:Name="PrimaryText" Text="Record" FontWeight="SemiBold" />
                </Button>
                <Button x:Name="SecondaryButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Cancel"
                        Click="OnSecondary" />
                <Button x:Name="ShowFileButton" DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Content="Show in folder"
                        Visibility="Collapsed" Click="OnShowFile" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
