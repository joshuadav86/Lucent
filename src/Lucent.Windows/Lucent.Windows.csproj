<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows 10 SDK version brings in the WinRT APIs, for Lucent's place in Windows' media controls
      (the volume flyout and lock screen, see Audio/MediaControls.cs). It still runs on any Windows 10 or 11:
      the version below (1809, the oldest .NET's WinRT support works on) is what the code is checked
      against, and on anything older the media controls quietly fall back to plain media-key hotkeys.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Lucent</AssemblyName>
    <Product>Lucent</Product>
    <ApplicationIcon>Assets\Lucent.ico</ApplicationIcon>
    <RootNamespace>WinampInspiredVisualizer</RootNamespace>
    <!-- CI sets the last number to the build number, so every build installs over the one before. -->
    <Version>0.1.0</Version>
    <!-- Program.Main, so Velopack can run before the app starts. -->
    <StartupObject>WinampInspiredVisualizer.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <!-- ONNX Runtime with DirectML, for the editor's stem splitter on any DirectX 12 graphics card (the same version as Lucent.Core's). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- libVLC, VLC's engine, for playing videos (Lucent.Core's Video/VideoStream.cs). 64-bit only, like Lucent. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!--
    libVLC's plugins that Lucent never uses, left out to keep the download smaller: streaming out, saving to files,
    and VLC's own visualizations and multi-screen video.
  -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Kept from those: the four that decode music only libVLC reads to a WAV for the editor (Lucent.Core's
      Audio/LibVlcAudioDecoder.cs): stream_out_transcode, stream_out_standard, access_output_file and mux_wav. And
      stream_out_smem, which hands the editor a video's pictures (Lucent.Core's Video/VideoPictureReader.cs).
    -->
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_out\libstream_out_autodel_plugin.dll;plugins\stream_out\libstream_out_bridge_plugin.dll;plugins\stream_out\libstream_out_chromaprint_plugin.dll;plugins\stream_out\libstream_out_chromecast_plugin.dll;plugins\stream_out\libstream_out_delay_plugin.dll;plugins\stream_out\libstream_out_description_plugin.dll;plugins\stream_out\libstream_out_display_plugin.dll;plugins\stream_out\libstream_out_dummy_plugin.dll;plugins\stream_out\libstream_out_duplicate_plugin.dll;plugins\stream_out\libstream_out_es_plugin.dll;plugins\stream_out\libstream_out_gather_plugin.dll;plugins\stream_out\libstream_out_mosaic_bridge_plugin.dll;plugins\stream_out\libstream_out_record_plugin.dll;plugins\stream_out\libstream_out_setid_plugin.dll;plugins\stream_out\libstream_out_stats_plugin.dll;plugins\access_output\libaccess_output_dummy_plugin.dll;plugins\access_output\libaccess_output_http_plugin.dll;plugins\access_output\libaccess_output_livehttp_plugin.dll;plugins\access_output\libaccess_output_rist_plugin.dll;plugins\access_output\libaccess_output_shout_plugin.dll;plugins\access_output\libaccess_output_srt_plugin.dll;plugins\access_output\libaccess_output_udp_plugin.dll;plugins\mux\libmux_asf_plugin.dll;plugins\mux\libmux_avi_plugin.dll;plugins\mux\libmux_dummy_plugin.dll;plugins\mux\libmux_mp4_plugin.dll;plugins\mux\libmux_mpjpeg_plugin.dll;plugins\mux\libmux_ogg_plugin.dll;plugins\mux\libmux_ps_plugin.dll;plugins\mux\libmux_ts_plugin.dll;plugins\visualization\%2A%2A;plugins\video_splitter\%2A%2A;lua\http\%2A%2A;libvlc.lib;libvlccore.lib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucent.Core\Lucent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Lucent.ico" />
    <Resource Include="Assets\Lucent-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The visuals and shaders, shared with the Mac app (content/). They're compiled when the app starts, so they ship as plain files people can edit. -->
    <None Include="..\..\content\Presets\*.hlsl" Link="Presets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\content\Presets\MilkDrop\*.milk;..\..\content\Presets\MilkDrop\CREDITS.md" Link="Presets\MilkDrop\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\content\Presets\AVS\*.avs;..\..\content\Presets\AVS\CREDITS.md" Link="Presets\AVS\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\content\Shaders\*.hlsl*" Link="Shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Copies inside Lucent.exe too, for when it's run without its folder (say, straight from the zip). -->
    <EmbeddedResource Include="..\..\content\Presets\*.hlsl" LogicalName="Presets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\content\Presets\MilkDrop\*.milk" LogicalName="Presets/MilkDrop/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\content\Presets\AVS\*.avs" LogicalName="Presets/AVS/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\content\Shaders\*.hlsl*" LogicalName="Shaders/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- libVLC's and LibVLCSharp's licence (LGPL 2.1), and where their source is, beside Lucent.exe. -->
  <ItemGroup>
    <None Include="..\..\assets\licenses\LICENSE-libVLC.txt" Link="Licenses\LICENSE-libVLC.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The WavPack and Monkey's Audio decoders are ports of theirs (BSD licences). -->
    <None Include="..\..\assets\licenses\LICENSE-WavPack.txt" Link="Licenses\LICENSE-WavPack.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\assets\licenses\LICENSE-MonkeysAudio.txt" Link="Licenses\LICENSE-MonkeysAudio.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- The song a first start puts in the library (see StarterMusic), beside Lucent.exe so it can be copied out. -->
  <ItemGroup>
    <None Include="..\..\content\StarterMusic\*.mp3" Link="StarterMusic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    The plugin helper that runs VST3 effects for the editor (src/PluginHost), when it has been built (see the
    README; CI always builds it). It's a program of its own, so it ships beside Lucent.exe.
  -->
  <ItemGroup Condition="Exists('..\..\build\PluginHost\Release\LucentPluginHost.exe')">
    <None Include="..\..\build\PluginHost\Release\LucentPluginHost.exe" Link="LucentPluginHost.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    The MP3 encoder (LAME, from NAudio.Lame) is a native DLL that NAudio.Lame loads from the app's folder.
    Keep it out of the single-file bundle so it ships beside Lucent.exe, where it can be found (and,
    as its LGPL licence asks, swapped for another build).
  -->
  <Target Name="KeepLameBesideTheApp" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Condition="'%(None.Filename)' == 'libmp3lame.32' Or '%(None.Filename)' == 'libmp3lame.64'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

  <!--
    WebView2's loader (for the Bandcamp sign-in page) is a native DLL that WebView2 loads from the app's
    folder. Like LAME, it ships beside Lucent.exe rather than inside the single-file bundle.
  -->
  <Target Name="KeepWebView2LoaderBesideTheApp" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)' == 'WebView2Loader'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <!-- ONNX Runtime looks for DirectML.dll beside itself, so both ship beside Lucent.exe too. -->
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)' == 'onnxruntime' Or '%(ResolvedFileToPublish.Filename)' == 'onnxruntime_providers_shared' Or '%(ResolvedFileToPublish.Filename)' == 'DirectML'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <!--
        libVLC loads its plugins from its own folder (libvlc\win-x64), so it ships beside Lucent.exe as it is. Its
        .NET side, LibVLCSharp.dll, ships beside it too: both are LGPL, so they must be replaceable.
      -->
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('libvlc')) Or '%(ResolvedFileToPublish.Filename)' == 'LibVLCSharp'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <!-- Their debugging builds, symbols and link libraries aren't needed to run. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'DirectML.Debug' Or ('%(Filename)' == 'DirectML' And '%(Extension)' == '.pdb') Or ('%(Filename)' == 'onnxruntime' And '%(Extension)' == '.lib')" />
    </ItemGroup>
  </Target>

</Project>
