<Window x:Class="Lucent.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicates"
        Width="560" Height="560" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Songs that are in the library more than once, each with its copies: the best one unticked, the rest
         ticked to go to the Recycle Bin. -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Border.Resources>
            <!-- A tick box beside each copy, like the visual picker's tag ticks. -->
            <Style x:Key="CopyCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Row" Padding="8,6" Margin="0,1" CornerRadius="{DynamicResource TinyCorner}" Background="Transparent">
                                <DockPanel>
                                    <Border x:Name="Box" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0"
                                            CornerRadius="4" BorderThickness="1.2" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource FaintTextBrush}" Background="Transparent">
                                        <Path x:Name="Tick" Data="{StaticResource CheckIcon}" Width="8" Height="7" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Visibility="Hidden" />
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Grid Margin="6,6,4,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,0,0,6" Height="34" Background="{DynamicResource TitleBarBrush}">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Click="OnClose">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUPLICATES" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="CountText" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource FaintTextBrush}" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="10,0,10,10" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupList" Margin="2,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Heading}" Margin="8,0,8,2" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource CopyCheck}" IsChecked="{Binding Remove}"
                                                      ToolTip="{Binding Item.Path}" MouseDoubleClick="OnCopyDoubleClick">
                                                <CheckBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Play" Click="OnPlayCopy" />
                                                        <MenuItem Header="Show in File Explorer" Click="OnShowCopy" />
                                                    </ContextMenu>
                                                </CheckBox.ContextMenu>
                                                <DockPanel>
                                                    <!-- The copy suggested for keeping. -->
                                                    <TextBlock x:Name="BestTag" DockPanel.Dock="Right" Text="BEST COPY" FontSize="10"
                                                               FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding Location}" FontSize="11" Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FaintTextBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </CheckBox>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                    <Setter TargetName="BestTag" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="10,10,6,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource PickerButton}" Content="Close" Height="32" Padding="16,0" Click="OnClose" />
                <Button x:Name="RemoveButton" Style="{StaticResource PickerButton}" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnRemove" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
