<local:ToolWindow x:Class="Lucent.LibraryWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:Lucent.Windows"
                  xmlns:core="clr-namespace:Lucent.Library;assembly=Lucent.Core"
                  Title="Lucent library"
                  Width="380" Height="560" MinWidth="280" MinHeight="200"
                  Background="{DynamicResource SurfaceBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Grid Margin="6,6,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,0,0,6" Height="34" Background="{DynamicResource TitleBarBrush}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Play the whole library in this order"
                            Click="OnPlayLibrary">
                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource PlaySmallIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Look for new music now" Click="OnRefreshLibrary">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource RefreshIcon}" />
                    </Button>
                    <Button x:Name="LibraryFoldersButton" Style="{StaticResource IconButton}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Choose which folders are in the library" Click="OnLibraryFolders">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource FolderIcon}" />
                    </Button>
                    <local:LockButton Style="{StaticResource PanelToggle}" Padding="8,0" Margin="0,0,2,0" />
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Hide the library (L)" Click="OnHideWindow">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LIBRARY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="LibraryCount" Text="No folder linked" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                </StackPanel>
            </DockPanel>

            <!-- Search: narrows the list to the songs with every typed word in their title, artist, album, album artist, genre, composer or file name. -->
            <Grid x:Name="SearchRow" Grid.Row="1" Margin="8,0,4,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" Tag="Search sounds, artists, and albums"
                         ToolTip="Find sounds by title, artist, album, genre, composer, or file name (Ctrl+F). Esc clears it."
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Width="22" Height="22"
                        HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed"
                        ToolTip="Clear the search (Esc)" Click="OnClearSearch">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <DockPanel x:Name="FilterRow" Grid.Row="2" Margin="8,0,4,8">
                <!-- Closes every folder heading at once, or opens them all again when they're all closed. -->
                <Button x:Name="FoldAllButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Margin="2,0,0,0" ToolTip="Close every folder" Click="OnFoldAllFolders">
                    <Path x:Name="FoldAllIcon" Style="{StaticResource LineIcon}" Data="{StaticResource CollapseAllIcon}" />
                </Button>
                <Button x:Name="GroupFoldersButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                        Content="FOLDERS" ToolTip="Headings by folder, artist, or album, or none" Click="OnToggleGroupFolders" />
                <Button x:Name="PlaylistsButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                        Content="PLAYLISTS" ToolTip="Show your saved playlists, or go back to your library folders" Click="OnTogglePlaylists" />
                <Button x:Name="FavoritesOnlyButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                        Content="FAVORITES" ToolTip="Show only your favorite sounds, or everything" Click="OnToggleFavoritesOnly" />
                <Button x:Name="SortButton" Style="{StaticResource PickerButton}" Height="28" Padding="10,0"
                        HorizontalAlignment="Left" ToolTip="Change the order" Click="OnSortMenu">
                    <!-- A DockPanel, so the label shortens with an ellipsis when the window is narrow. -->
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Style="{StaticResource LineIcon}" Data="{StaticResource SortIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                        <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                        <TextBlock x:Name="SortLabel" Text="Newest first" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
            </DockPanel>

            <!-- The tag columns' headings, when any are shown (LibraryWindow.Columns.cs): a click sorts by one and
                 another flips it, a drag moves one, and a right-click chooses them. They line up with the rows'
                 cells: the rows' padding (12) and cover (36 + 2 + 10) on the left, and the padding and scroll bar on the right. -->
            <Grid x:Name="ColumnHeader" Grid.Row="3" Margin="60,0,18,2" Visibility="Collapsed" Background="Transparent"
                  ContextMenuOpening="OnColumnHeaderMenuOpening">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu />
                </Grid.ContextMenu>
                <TextBlock x:Name="TitleHeading" Grid.Column="0" Text="Title" FontSize="11" Cursor="Hand"
                           ToolTip="Sort by title" MouseLeftButtonUp="OnTitleHeadingClick" />
                <StackPanel x:Name="ColumnHeadings" Grid.Column="1" Orientation="Horizontal" />
                <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource HairlineBrush}">
                    <TextBlock x:Name="LengthHeading" Text="Length" FontSize="11" Cursor="Hand" TextAlignment="Right"
                               ToolTip="Sort by length" MouseLeftButtonUp="OnLengthHeadingClick" />
                </Border>
            </Grid>

            <ListBox x:Name="LibraryView" Grid.Row="4" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Extended"
                     MouseDoubleClick="OnLibraryDoubleClick"
                     KeyDown="OnLibraryKeyDown"
                     SelectionChanged="OnLibrarySelectionChanged"
                     ContextMenuOpening="OnLibraryMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="LibraryMenu">
                        <MenuItem Header="Play now" Click="OnLibraryPlayNow" />
                        <MenuItem Header="Add to queue" Click="OnLibraryAddToQueue" />
                        <MenuItem x:Name="PlayFolderItem" Header="Play this folder" Click="OnLibraryPlayFolder" />
                        <Separator x:Name="SongMenuItemsStart" />
                        <MenuItem Header="Edit info…" InputGestureText="Ctrl+I" Click="OnLibraryEditInfo" />
                        <MenuItem x:Name="OpenInEditorItem" Header="Open in editor…" Click="OnLibraryOpenInEditor" />
                        <MenuItem Header="Convert to…" Click="OnLibraryConvert" />
                        <MenuItem Header="Show in File Explorer" Click="OnLibraryShowInExplorer" />
                        <Separator />
                        <MenuItem Header="Find duplicates…" Click="OnFindDuplicates" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <!-- A heading per folder. A store's folder (Bandcamp, Beatport) is one heading, with a
                     subheading for each folder inside; any other folder's songs sit right under its heading. -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyleSelector>
                            <local:FolderGroupStyleSelector>
                                <local:FolderGroupStyleSelector.Heading>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander Style="{StaticResource FolderExpander}" IsExpanded="True"
                                                              Loaded="OnFolderGroupLoaded"
                                                              PreviewMouseLeftButtonDown="OnFolderHeadingMouseDown"
                                                              Expanded="OnFolderGroupExpanded"
                                                              Collapsed="OnFolderGroupCollapsed">
                                                        <Expander.Header>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11"
                                                                           Margin="8,0,2,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource FaintTextBrush}" />
                                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </local:FolderGroupStyleSelector.Heading>
                                <local:FolderGroupStyleSelector.Subheading>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <!-- Set in under the store's heading; its songs line up with every other song. -->
                                                    <Expander Style="{StaticResource FolderExpander}" IsExpanded="True" Margin="14,0,0,0"
                                                              Loaded="OnFolderGroupLoaded"
                                                              PreviewMouseLeftButtonDown="OnFolderHeadingMouseDown"
                                                              Expanded="OnFolderGroupExpanded"
                                                              Collapsed="OnFolderGroupCollapsed">
                                                        <Expander.Header>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11"
                                                                           Margin="8,0,2,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource FaintTextBrush}" />
                                                                <TextBlock Text="{Binding Items[0].SubheadingLabel}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="-14,0,0,0" />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </local:FolderGroupStyleSelector.Subheading>
                                <local:FolderGroupStyleSelector.NoHeading>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <ItemsPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </local:FolderGroupStyleSelector.NoHeading>
                            </local:FolderGroupStyleSelector>
                        </GroupStyle.ContainerStyleSelector>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The song playing: a bar at the row's edge, as in a streaming playlist. -->
                            <local:RoundedBorder Grid.Column="0" Width="3" Margin="-9,2,0,2" HorizontalAlignment="Left" CornerRadius="1.5"
                                                 Background="{DynamicResource AccentGradientBrush}"
                                                 Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenTrue}}" />
                            <!-- An empty playlist's stand-in row is just words, with no cover. -->
                            <local:TrackThumb Margin="2,0,0,0" Path="{Binding Path}"
                                              Visibility="{Binding ShowsCover, Converter={StaticResource VisibleWhenTrue}}" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <!-- The tag columns chosen for the library, if any, each as wide as its heading. Each has a divider
                                 line on its left that runs through the row's padding (8) and margin (1), so the lines join up
                                 from row to row. -->
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}" Margin="0,-9" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:LibraryCell}">
                                        <Border Width="{Binding Width}" Padding="8,0" BorderThickness="1,0,0,0"
                                                BorderBrush="{DynamicResource HairlineBrush}">
                                            <TextBlock x:Name="Cell" Text="{Binding Text}" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding AlignRight}" Value="True">
                                                <Setter TargetName="Cell" Property="TextAlignment" Value="Right" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="TimeCell" Grid.Column="3" Margin="0,-9" BorderBrush="{DynamicResource HairlineBrush}">
                                <TextBlock Text="{Binding DurationText}" FontSize="11" MinWidth="44" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasCells}" Value="True">
                                <Setter TargetName="TimeCell" Property="BorderThickness" Value="1,0,0,0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyLibraryHint" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{StaticResource MusicIcon}" Fill="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyLibraryTitle" Text="Link a music folder" Margin="0,12,0,0" FontSize="13"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="EmptyLibraryText" Margin="0,4,0,0" FontSize="12" MaxWidth="220"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                           Text="Every sound inside it shows up here, newest first, and new files appear on their own." />
                <Button x:Name="LinkFolderButton" Style="{StaticResource PickerButton}" Margin="0,14,0,0" HorizontalAlignment="Center"
                        Click="OnLinkLibraryFolder">
                    <TextBlock Text="Choose a folder" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- A streaming playlist opened from PLAYLISTS: its songs, in place of the list, without playing anything.
                 Double-clicking a song plays it in the app, carrying on through the playlist. -->
            <DockPanel x:Name="RemotePlaylistPanel" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="32" Height="32"
                            ToolTip="Back to your playlists (Esc)" Click="OnCloseRemotePlaylist">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowLeftIcon}" />
                    </Button>
                    <Button x:Name="PlayRemotePlaylistButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Width="32" Height="32" Click="OnPlayRemotePlaylist">
                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource PlaySmallIcon}" />
                    </Button>
                    <StackPanel Margin="6,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RemotePlaylistName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="RemotePlaylistDetails" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
                <!-- How the songs are listed: the playlist's own order, by date added, title or artist, as in the queue. -->
                <Button x:Name="RemoteSortButton" DockPanel.Dock="Top" Style="{StaticResource PickerButton}" Height="28" Padding="10,0"
                        Margin="8,0,4,8" HorizontalAlignment="Left" Visibility="Collapsed"
                        ToolTip="List the playlist in its own order, by date added, by title or by artist. It still plays in its own order."
                        Click="OnRemoteSortMenu">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource SortIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="RemoteSortLabel" Text="Playlist order" FontSize="12" VerticalAlignment="Center" />
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="RemotePlaylistNote" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="10,6,8,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                <ListBox x:Name="RemotePlaylistView" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionMode="Single"
                         MouseDoubleClick="OnRemotePlaylistDoubleClick"
                         KeyDown="OnRemotePlaylistKeyDown"
                         ContextMenuOpening="OnRemoteSongMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RemoteSongPlayItem" Header="Play" Click="OnRemotePlaylistPlaySong" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:RoundedBorder Grid.Column="0" CornerRadius="1.5" Margin="0,2,0,2"
                                                     Background="{DynamicResource AccentGradientBrush}"
                                                     Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenTrue}}" />
                                <local:TrackThumb Grid.Column="1" Margin="8,0,0,0" Url="{Binding Track.ListArtUrl}" />
                                <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Track.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Track.Artist}" FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Track.DurationText}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Border>
</local:ToolWindow>
