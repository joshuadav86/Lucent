<Window x:Class="Lucent.ArtworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Lucent.Windows"
        Title="Artwork - Lucent"
        Icon="Assets/Lucent.ico"
        Width="420" Height="456" MinWidth="200" MinHeight="236"
        Background="{DynamicResource BackgroundBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        Closing="OnClosing"
        Closed="OnClosed">

    <!-- Same custom chrome as the main window: our own title bar, native resizing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: what's playing, keep on top, close. -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <w:LockButton Style="{StaticResource PanelToggle}" Padding="8,0" Margin="0,4,2,0" />
                <ToggleButton x:Name="OnTopToggle" Style="{StaticResource PanelToggle}" Padding="8,0" Margin="0,4,2,0"
                              ToolTip="Keep this window on top of other programs" Click="OnToggleOnTop"
                              WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource PinIcon}" />
                </ToggleButton>
                <Button Style="{StaticResource CloseCaptionButton}" ToolTip="Close (Esc)"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </StackPanel>
            <TextBlock Text="ARTWORK" DockPanel.Dock="Left" Margin="14,0,0,0" FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock x:Name="TrackText" Margin="10,0,8,0" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
        </DockPanel>

        <!-- The cover, as big as fits, letterboxed to keep its shape. Drag it to move the window. -->
        <Grid x:Name="ArtArea" Grid.Row="1" Margin="10,0,10,10" Background="Transparent"
              MouseLeftButtonDown="OnArtMouseDown" ContextMenuOpening="OnArtContextMenuOpening">
            <Grid.ContextMenu>
                <ContextMenu x:Name="ArtMenu">
                    <MenuItem x:Name="CopyMenuItem" Header="Copy image" Click="OnCopyImage" />
                    <MenuItem x:Name="SaveMenuItem" Header="Save image…" Click="OnSaveImage" />
                    <Separator />
                    <MenuItem x:Name="EditMenuItem" Click="OnEditInfo">
                        <MenuItem.Header>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+I" Margin="28,0,0,0"
                                           Foreground="{DynamicResource FaintTextBrush}" />
                                <TextBlock Text="Edit info…" />
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem x:Name="OnTopMenuItem" Header="Keep on top" Click="OnToggleOnTop" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Image x:Name="ArtImage" Stretch="Uniform" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Shown when the track has no artwork: a soft card in the theme's colours. -->
            <Viewbox x:Name="Placeholder" Stretch="Uniform" MaxWidth="440" MaxHeight="440">
                <Grid Width="240" Height="240">
                    <Border CornerRadius="22" Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                    <Border CornerRadius="22" Background="{DynamicResource AccentGradientBrush}" Opacity="0.14" />
                    <Border CornerRadius="22" Margin="18" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="64" Height="56" HorizontalAlignment="Center">
                            <Path Data="{StaticResource MusicIcon}" Fill="{DynamicResource AccentGradientBrush}" />
                        </Viewbox>
                        <TextBlock x:Name="PlaceholderTitle" Text="Nothing playing" Margin="0,20,0,0" FontSize="13"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="PlaceholderText" Text="Artwork appears here when music plays." Margin="0,4,0,0"
                                   FontSize="10" MaxWidth="170" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
