<Window x:Class="WinampInspiredVisualizer.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record - Lucent"
        Icon="Assets/Lucent.ico"
        Width="820" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing" KeyDown="OnKey">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A level meter's track; the fill and peak line are sized from code. -->
        <Style x:Key="MeterTrack" TargetType="Border">
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <StackPanel>
            <!-- Title bar -->
            <Grid Height="40">
                <TextBlock Text="RECORD" Margin="20,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseButton">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The input, its format, its level, and the live plugins -->
                <StackPanel x:Name="InputArea">
                    <TextBlock Style="{StaticResource OptionLabel}" Text="Input" Margin="2,4,0,6" />
                    <Button x:Name="InputButton" Style="{StaticResource PickerButton}" HorizontalContentAlignment="Stretch"
                            Click="OnChooseInput">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                                  Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                            <TextBlock x:Name="InputText" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Channels" />
                    <Button x:Name="ChannelsButton" Style="{StaticResource PickerButton}" HorizontalContentAlignment="Stretch"
                            Click="OnChooseChannels">
                        <DockPanel>
                            <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                                  Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                            <TextBlock x:Name="ChannelsText" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Sample rate" />
                    <Border Style="{StaticResource SegmentBar}">
                        <UniformGrid x:Name="RatePanel" Rows="1" />
                    </Border>

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Bit depth" />
                    <Border Style="{StaticResource SegmentBar}">
                        <UniformGrid x:Name="BitsPanel" Rows="1" />
                    </Border>
                    <TextBlock x:Name="FormatHint" Style="{StaticResource OptionHint}" />

                    <!-- Level -->
                    <DockPanel Margin="2,16,0,6">
                        <Border x:Name="ClipLight" DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" Opacity="0.25"
                                Background="#E5484D" ToolTip="Lights up when the sound reaches full scale. Click to clear it."
                                MouseLeftButtonDown="OnClearClip" Cursor="Hand">
                            <TextBlock Text="CLIP" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="PeakText" DockPanel.Dock="Right" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="Level" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border x:Name="LeftTrack" Style="{StaticResource MeterTrack}">
                        <Grid>
                            <Border x:Name="LeftFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentGradientBrush}" />
                            <Border x:Name="LeftHold" HorizontalAlignment="Left" Width="2" Background="{DynamicResource TextBrush}" />
                        </Grid>
                    </Border>
                    <Border x:Name="RightTrack" Style="{StaticResource MeterTrack}" Margin="0,4,0,0">
                        <Grid>
                            <Border x:Name="RightFill" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentGradientBrush}" />
                            <Border x:Name="RightHold" HorizontalAlignment="Left" Width="2" Background="{DynamicResource TextBrush}" />
                        </Grid>
                    </Border>
                    <!-- Offered when a stereo recording only has sound on one side: a mono mic in one input. -->
                    <StackPanel x:Name="MonoHint" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="MonoHintText" Style="{StaticResource OptionHint}" Margin="2,0,0,6" />
                        <Button x:Name="MonoButton" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="OnUseMono"
                                ToolTip="Records just that input, as a mono file that plays in both ears. Not while recording." />
                    </StackPanel>
                    <CheckBox x:Name="ListenSwitch" Style="{StaticResource SwitchToggle}" Margin="0,14,0,0" Content="Hear it through the speakers"
                              Click="OnListen" />
                    <TextBlock x:Name="ListenHint" Style="{StaticResource OptionHint}" />

                    <!-- Live plugins -->
                    <DockPanel Margin="2,18,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="CHAINS" x:Name="ChainsButton"
                                Click="OnChains" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="ADD PLUGIN" x:Name="AddPluginButton"
                                Margin="0,0,8,0" Click="OnAddPlugin" />
                        <TextBlock Text="Live plugins" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="PluginList" />
                    <TextBlock x:Name="PluginHint" Style="{StaticResource OptionHint}" />
                    <CheckBox x:Name="DrySwitch" Style="{StaticResource SwitchToggle}" Margin="0,10,0,0"
                              Content="Also keep a copy without the plugins" Click="OnOptionSwitch" />
                </StackPanel>

                <!-- Naming, where it goes, and the track marks -->
                <StackPanel x:Name="FileArea" Grid.Column="2">
                    <TextBlock Style="{StaticResource OptionLabel}" Text="Name" Margin="2,4,0,6" />
                    <TextBox x:Name="NameInput" Style="{StaticResource TextInput}" TextChanged="OnNameChanged" />

                    <TextBlock Style="{StaticResource OptionLabel}" Text="File name" />
                    <TextBox x:Name="TemplateInput" Style="{StaticResource TextInput}" TextChanged="OnNameChanged" />
                    <WrapPanel x:Name="TokenPanel" Margin="0,8,0,0" />
                    <TextBlock x:Name="FileNameText" FontSize="12" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Save to" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="CHANGE" Margin="10,0,0,0"
                                x:Name="FolderButton" Click="OnChooseFolder" />
                        <TextBlock x:Name="FolderText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                    <TextBlock x:Name="SpaceHint" Style="{StaticResource OptionHint}" />
                    <CheckBox x:Name="LibrarySwitch" Style="{StaticResource SwitchToggle}" Margin="0,8,0,0"
                              Content="Show recordings in the Library" Click="OnOptionSwitch" />

                    <TextBlock Style="{StaticResource OptionLabel}" Text="Track marks" />
                    <CheckBox x:Name="DetectSwitch" Style="{StaticResource SwitchToggle}" Content="Mark song changes Lucent hears"
                              Click="OnOptionSwitch" />
                    <CheckBox x:Name="CueSwitch" Style="{StaticResource SwitchToggle}" Margin="0,8,0,0"
                              Content="Save a .cue sheet beside the recording" Click="OnOptionSwitch" />
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="KeyButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="SET UP"
                                Margin="10,0,0,0" VerticalAlignment="Center" Click="OnKeyButton"
                                ToolTip="Enter your own ACRCloud key" />
                        <CheckBox x:Name="IdentifySwitch" Style="{StaticResource SwitchToggle}"
                                  Content="Name the songs with ACRCloud" Click="OnOptionSwitch" />
                    </DockPanel>
                    <TextBlock x:Name="IdentifyHint" Style="{StaticResource OptionHint}" />
                    <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OptionHint}"
                                   Text="In ACRCloud's console, make an Audio &amp; Video Recognition project with the ACRCloud Music bucket and Line-in audio, then copy its host, access key, and access secret here. Lookups count on your ACRCloud account, and the key stays on this computer, encrypted for your Windows account." />
                        <TextBlock Style="{StaticResource OptionLabel}" Text="Host" />
                        <TextBox x:Name="HostInput" Style="{StaticResource TextInput}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Text="Access key" />
                        <TextBox x:Name="AccessKeyInput" Style="{StaticResource TextInput}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Text="Access secret" />
                        <TextBox x:Name="SecretInput" Style="{StaticResource TextInput}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PillButton}" Content="SAVE KEY" Click="OnSaveKey" />
                            <Button x:Name="RemoveKeyButton" Style="{StaticResource PillButton}" Content="REMOVE" Margin="8,0,0,0" Click="OnRemoveKey" />
                            <Button Style="{StaticResource PillButton}" Content="ACRCLOUD CONSOLE" Margin="8,0,0,0" Click="OnOpenConsole" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource OptionHint}"
                               Text="Press New track (or M) as each song starts. The marks go into the WAV file as cue points, so Next and Previous in Lucent skip from song to song, and DJ software and editors show them. Lucent's own guesses are only made while recording, about 20 seconds after each change." />
                    <ScrollViewer Margin="0,8,0,0" MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TrackList" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ProblemText" Margin="22,14,20,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="#E5484D" />

            <!-- Transport -->
            <Border Margin="20,16,20,18" Padding="14,10" CornerRadius="8" Background="{DynamicResource SurfaceRaisedBrush}">
                <DockPanel LastChildFill="True">
                    <Button x:Name="RecordButton" DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Click="OnRecord"
                            ToolTip="Start recording (R)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#E5484D" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="RecordText" Text="Record" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MarkButton" DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                            Content="New track" Click="OnMark" IsEnabled="False"
                            ToolTip="Mark a new song starting now (M)" />
                    <Button x:Name="SplitButton" DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                            Content="New file" Click="OnSplit" IsEnabled="False"
                            ToolTip="Finish this file and carry straight on in a new one, without missing a sample (N)" />
                    <Button x:Name="ShowFileButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                            Content="Show in folder" Click="OnShowFile" Visibility="Collapsed" />
                    <Button x:Name="QueueButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                            Content="Add to queue" Click="OnAddToQueue" Visibility="Collapsed" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="0:00:00" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="StatusText" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
