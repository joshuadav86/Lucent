<Window x:Class="WinampInspiredVisualizer.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lucent"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceRaisedBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Asks for one line of text, e.g. a playlist's name. -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}" Padding="18,16,18,16">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="Hint" Style="{StaticResource OptionHint}" Margin="0,4,0,12" />
            <TextBox x:Name="Answer" Style="{StaticResource TextInput}" KeyDown="OnAnswerKeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource PickerButton}" Content="Cancel" Height="32" Padding="16,0" Click="OnCancel" />
                <Button x:Name="OkButton" Style="{StaticResource PickerButton}" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
