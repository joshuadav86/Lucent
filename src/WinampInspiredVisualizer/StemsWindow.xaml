<Window x:Class="WinampInspiredVisualizer.StemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stems - Lucent"
        Icon="Assets/Lucent.ico"
        Width="760" Height="420" MinWidth="520" MinHeight="320"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnClosed">

    <!-- Same custom title bar as the main window, with native resizing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource PanelSheenBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" Height="36" ToolTip="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/Lucent-64.png" Width="14" Height="14" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="STEMS" Margin="9,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SongText" Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- What did the splitting: the graphics card, or the processor and why. -->
        <TextBlock x:Name="NoteText" Grid.Row="1" Margin="12,6,12,4" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource FaintTextBrush}" />

        <!-- One row per stem: its name, mute and solo, and its waveform with the playhead. Click a waveform to play from there. -->
        <Grid x:Name="Rows" Grid.Row="2" Margin="10,4,10,0" />

        <DockPanel Grid.Row="3" Margin="10,10,10,10" LastChildFill="False">
            <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource PillButton}" Height="30" MinWidth="76"
                    Padding="12,0" Content="PLAY" ToolTip="Play or pause (Space)" Click="OnPlayPause" />
            <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Height="30" Padding="12,0" Margin="6,0,0,0"
                    Content="STOP" ToolTip="Stop and go back to the start" Click="OnStop" />
            <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Button x:Name="KeepButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Height="30" Padding="12,0"
                    Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}" Click="OnKeep"
                    ToolTip="Keep only the stems you're hearing in the editor; the rest are taken out (Ctrl+Z undoes it)" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Height="30" Padding="12,0"
                    Content="SAVE AS FILES…" Click="OnSave"
                    ToolTip="Save the vocals, drums, bass and other instruments as four files, in a folder next to the song" />
        </DockPanel>
    </Grid>
</Window>
