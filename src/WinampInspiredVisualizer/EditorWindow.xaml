<Window x:Class="WinampInspiredVisualizer.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:WinampInspiredVisualizer.Editor"
        Title="Audio editor - Lucent"
        Icon="Assets/Lucent.ico"
        Width="1240" Height="700" MinWidth="980" MinHeight="480"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        Closing="OnClosing"
        Closed="OnClosed">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Icons only the editor uses, on the same 16 x 16 grid as the app's. -->
        <Geometry x:Key="UndoIcon">M5,2.5 L1.5,6 L5,9.5 M1.5,6 H10 A4,4 0 0 1 10,14 H7</Geometry>
        <Geometry x:Key="RedoIcon">M11,2.5 L14.5,6 L11,9.5 M14.5,6 H6 A4,4 0 0 0 6,14 H9</Geometry>
        <Geometry x:Key="ZoomInIcon">M6.5,1.5 A5,5 0 1 1 6.49,1.5 Z M10.2,10.2 L14.5,14.5 M4,6.5 H9 M6.5,4 V9</Geometry>
        <Geometry x:Key="ZoomOutIcon">M6.5,1.5 A5,5 0 1 1 6.49,1.5 Z M10.2,10.2 L14.5,14.5 M4,6.5 H9</Geometry>
        <Geometry x:Key="ZoomFitIcon">M1,8 H15 M4,5 L1,8 L4,11 M12,5 L15,8 L12,11</Geometry>
        <!-- The waves taller (arrows out from the centre line) or shorter (arrows in). -->
        <Geometry x:Key="WaveTallerIcon">M1,8 H15 M8,1.5 V6 M5.5,4 L8,1.5 L10.5,4 M8,10 V14.5 M5.5,12 L8,14.5 L10.5,12</Geometry>
        <Geometry x:Key="WaveShorterIcon">M1,8 H15 M8,1.5 V6 M5.5,3.5 L8,6 L10.5,3.5 M8,10 V14.5 M5.5,12.5 L8,10 L10.5,12.5</Geometry>
        <Geometry x:Key="ChevronLeftIcon">M5,1 L1,5 L5,9</Geometry>
        <!-- A clock face, for the history panel. -->
        <Geometry x:Key="HistoryIcon">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M8,4.5 V8 L10.5,9.5</Geometry>

        <!-- A small glyph button on a plugin in the chain (move it, take it out). -->
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- An insert's name in the channel strip: click it to bring the plugin's window back. -->
        <Style x:Key="SlotName" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="4" Padding="4,3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An insert's power button in the channel strip: a dot, lit while the plugin is on. -->
        <Style x:Key="SlotPower" TargetType="ToggleButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="11" Background="Transparent">
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="Transparent" StrokeThickness="1.5"
                                     Stroke="{DynamicResource FaintTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An empty insert slot in the channel strip: click it to add a plugin there. -->
        <Style x:Key="EmptySlot" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="6" Padding="4,0" Background="Transparent"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One step in the history list: lit while it's where the audio is, dimmed once undone. -->
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="6" Padding="10,6" Margin="0,0,0,2" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin progress bar in the accent colours. -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource HairlineBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentGradientBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text button for the processing bar and the save buttons. -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- An icon button that dims when there's nothing for it to do (Undo with no history). -->
        <Style x:Key="DimmingIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A switch in the toolbar (Loop, Snap, Spectrogram), lit while it's on. -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource PanelToggle}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- A small label and value above a slider in the tool cards. -->
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
        </Style>

        <Style x:Key="PopupCard" TargetType="Border">
            <Setter Property="Margin" Value="16" />
            <Setter Property="Width" Value="320" />
            <Setter Property="Padding" Value="16,12,16,16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image Source="Assets/Lucent-64.png" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="AUDIO EDITOR" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FileTitle" Margin="14,0,0,0" FontSize="12" MaxWidth="560"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="FullScreenButton" Style="{StaticResource CaptionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="FullScreenIcon" Style="{StaticResource CaptionIcon}" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" ToolTip="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource MinimizeIcon}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeRestore">
                    <Path x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Data="{StaticResource MaximizeIcon}" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Transport, position and view controls -->
        <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The listening volume: only what's heard, never the audio itself -->
                    <Grid VerticalAlignment="Center" ToolTip="Listening volume (Shift+Up and Shift+Down). It changes only what you hear, not the sound itself; the Volume tool does that.">
                        <Path Data="{StaticResource SpeakerIcon}" Fill="{DynamicResource MutedTextBrush}" />
                        <Path Data="{StaticResource SpeakerWavesIcon}" Stroke="{DynamicResource MutedTextBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Width="90" Minimum="0" Maximum="1"
                            Margin="8,0,6,0" VerticalAlignment="Center" Focusable="False" ValueChanged="OnVolumeChanged"
                            ToolTip="Listening volume (Shift+Up and Shift+Down). It changes only what you hear, not the sound itself; the Volume tool does that." />
                    <TextBlock x:Name="VolumeText" Width="34" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <editor:LevelMeter x:Name="Meter" Width="230" Margin="0,0,14,0" VerticalAlignment="Center"
                                       BarBrush="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource HairlineBrush}"
                                       LabelBrush="{DynamicResource MutedTextBrush}" />
                    <ToggleButton x:Name="SpectrogramToggle" Style="{StaticResource ToolToggle}" Content="Spectrogram"
                                  Click="OnViewToggle"
                                  ToolTip="Show the frequencies over time instead of the waveform (V). Hum, hiss, clipping, and an MP3's cut-off show up clearly." />
                    <ToggleButton x:Name="HandToggle" Style="{StaticResource ToolToggle}" Content="Hand" Click="OnHandToggle"
                                  ToolTip="The hand tool (G): drag a clip's waveform to slide it left or right, leaving silence behind it. Turn it off to select again." />
                    <ToggleButton x:Name="SnapToggle" Style="{StaticResource ToolToggle}" Content="Snap" Click="OnSnapToggle"
                                  ToolTip="Snap the cursor and selection to the nearest zero crossing, so cuts don't click. Hold Ctrl to place them freely." />
                    <Border Width="1" Height="20" Margin="4,0,8,0" Background="{DynamicResource HairlineBrush}" />
                    <Button x:Name="UndoButton" Style="{StaticResource DimmingIconButton}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource UndoIcon}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource DimmingIconButton}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource RedoIcon}" />
                    </Button>
                    <ToggleButton x:Name="InsertsToggle" Style="{StaticResource ToolToggle}" Margin="4,0,0,0" Content="Inserts"
                                  Click="OnInsertsToggle"
                                  ToolTip="The channel strip: your plugins in order, top to bottom (I). Click an empty slot to add one." />
                    <ToggleButton x:Name="HistoryToggle" Style="{StaticResource ToolToggle}" Margin="0" Click="OnHistoryToggle"
                                  ToolTip="Everything you've done to the sound, in order (H). Click a step to go back to it.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource HistoryIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="History" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource HairlineBrush}" />
                    <Button Style="{StaticResource IconButton}" Click="OnZoomOut" ToolTip="Zoom out (-, the mouse wheel, or pinch)">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ZoomOutIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnZoomIn" ToolTip="Zoom in (+, the mouse wheel, or pinch)">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ZoomInIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnZoomFit" ToolTip="Show the whole sound (0)">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ZoomFitIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnWaveShorter" Margin="6,0,0,0"
                            ToolTip="Make the waves shorter (Ctrl+Down, or Alt+wheel).">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource WaveShorterIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnWaveTaller"
                            ToolTip="Make the waves taller, to see quiet parts (Ctrl+Up, or Alt+wheel)">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource WaveTallerIcon}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Width="40" Height="40"
                            ToolTip="Play from the cursor, or play the selection (Space)" Click="OnPlay">
                        <Path x:Name="PlayIcon" Style="{StaticResource SolidIcon}" Data="{StaticResource PlayIcon}" Margin="2,0,0,0" />
                    </Button>
                    <Button x:Name="PlaySelectionButton" Style="{StaticResource ToolButton}" Margin="10,0,6,0"
                            Content="Play selection" ToolTip="Play only the selected part" Click="OnPlaySelection" />
                    <ToggleButton x:Name="LoopToggle" Style="{StaticResource ToolToggle}" Content="Loop" Click="OnLoopToggle"
                                  ToolTip="Play the selection round and round (L), to hear a change while you make it" />
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PositionText" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas, Segoe UI" Text="0:00.000" />
                        <TextBlock x:Name="LengthText" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The whole song, with the visible part marked -->
        <editor:OverviewView x:Name="Overview" Grid.Row="2" Height="38" Margin="14,10,14,0"
                             WaveBrush="{DynamicResource FaintTextBrush}"
                             BackgroundBrush="{DynamicResource SurfaceBrush}"
                             WindowBrush="{DynamicResource AccentBrush}"
                             WindowBorderBrush="{DynamicResource AccentBrush}"
                             ToolTip="The whole sound. Click or drag to move around; the wheel zooms." />

        <!-- The waveform, with the channel strip and the history beside it while they're open -->
        <Grid Grid.Row="3" Margin="14,8,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The channel strip: the plugins in the order the sound goes through them, top to bottom, like a
                 mixer's insert slots. -->
            <Border x:Name="PluginBar" Grid.Column="1" Width="250" Margin="10,0,0,0" Visibility="Collapsed" CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    Padding="8,10,8,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Click="OnInsertsToggle"
                                ToolTip="Hide the channel strip (the plugins stay open)">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource CloseIcon}" />
                        </Button>
                        <Button x:Name="ChainMenuButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                Click="OnChainMenu" ToolTip="Save this chain, open one you saved, bring in an FX chain from REAPER, or close every plugin">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CHAINS" VerticalAlignment="Center" />
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="6,1,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="INSERTS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock x:Name="PluginHint" Style="{StaticResource OptionHint}" Margin="4,0,4,8" TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                            <ToggleButton x:Name="ChainBypassToggle" Style="{StaticResource ToolToggle}" Margin="0,0,3,0" Content="Bypass"
                                          Click="OnChainBypass"
                                          ToolTip="Play without the plugins, to compare (B). Play goes through every plugin that's on, and changes in their windows are heard straight away." />
                            <Button x:Name="PluginApplyButton" Style="{StaticResource ToolButton}" Margin="3,0,0,0" Click="OnApplyPlugin"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="Run the selection (or the whole sound) through every plugin that's switched on, as one step you can undo">
                                <TextBlock Text="Apply" FontWeight="SemiBold" />
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChainPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="HistoryPanel" Grid.Column="2" Width="270" Margin="10,0,0,0" Visibility="Collapsed" CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    Padding="8,10,8,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Click="OnHistoryToggle" ToolTip="Close the history">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource CloseIcon}" />
                        </Button>
                        <TextBlock Text="HISTORY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource OptionHint}" Margin="6,6,4,0"
                               Text="Click a step to go back to it. The steps after it stay here, dimmed, until you make a new change." />
                    <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource HistoryItem}" SelectionChanged="OnHistoryPicked"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>
            <editor:WaveformView x:Name="Waveform"
                                 WaveBrush="{DynamicResource AccentBrush}"
                                 SelectedWaveBrush="#F2F0EA"
                                 LaneBrush="{DynamicResource SurfaceBrush}"
                                 SelectionBrush="#2EF2F0EA"
                                 LineBrush="{DynamicResource HairlineBrush}"
                                 LabelBrush="{DynamicResource MutedTextBrush}"
                                 CursorBrush="{DynamicResource AccentBrush}"
                                 PlayheadBrush="{DynamicResource TextBrush}" />
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <TextBlock x:Name="LoadingText" Text="Opening the sound…" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ProgressBar x:Name="LoadingProgress" Style="{StaticResource ThinProgress}" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>

        <!-- Processing -->
        <Border x:Name="ProcessBar" Grid.Row="5" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="14,10,14,8">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="NormalizeButton" Style="{StaticResource ToolButton}" Click="OnNormalize"
                            ToolTip="Make it as loud as it can be without distorting, or match a loudness level">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Normalize" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GainButton" Style="{StaticResource ToolButton}" Content="Volume…" Click="OnGain"
                            ToolTip="Make it louder or quieter" />
                    <Button x:Name="PitchButton" Style="{StaticResource ToolButton}" Content="Pitch…" Click="OnPitch"
                            ToolTip="Move the pitch up or down by up to an octave" />
                    <Button x:Name="TempoButton" Style="{StaticResource ToolButton}" Content="Tempo…" Click="OnTempo"
                            ToolTip="Make it faster or slower, keeping the pitch (or not)" />
                    <Button Style="{StaticResource ToolButton}" Content="Fade in" Click="OnFadeIn"
                            ToolTip="Fade up from silence over the selection (or the first 3 seconds)" />
                    <Button Style="{StaticResource ToolButton}" Content="Fade out" Click="OnFadeOut"
                            ToolTip="Fade down to silence over the selection (or the last 3 seconds)" />
                    <Border Width="1" Height="20" Margin="4,0,10,0" Background="{DynamicResource HairlineBrush}" />
                    <Button x:Name="EqButton" Style="{StaticResource ToolButton}" Content="EQ…" Click="OnEq"
                            ToolTip="A parametric equalizer drawn over the selection's spectrum and heard live while you shape it" />
                    <Button x:Name="DynamicsButton" Style="{StaticResource ToolButton}" Content="Dynamics…" Click="OnDynamics"
                            ToolTip="A compressor to even out the level, or a true-peak limiter to make it louder without clipping" />
                    <Button x:Name="RepairButton" Style="{StaticResource ToolButton}" Click="OnRepair"
                            ToolTip="Take out hum, clicks, background noise, or a DC offset">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Repair" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ChannelsButton" Style="{StaticResource ToolButton}" Click="OnChannels"
                            ToolTip="Swap, mix, invert, or widen the channels, convert to mono, or edit one channel alone">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Channels" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StemsButton" Style="{StaticResource ToolButton}" Content="Stems…" Click="OnStems"
                            ToolTip="Split the music into vocals, drums, bass and the other instruments: remove the vocals, keep only them, or save each as a file" />
                    <Button x:Name="AnalyzeButton" Style="{StaticResource ToolButton}" Content="Analyze…" Click="OnAnalyze"
                            ToolTip="Peak, true peak, loudness, loudness range, DC offset, clipping, and the spectrum of the selection (or the sound)" />
                    <Border Width="1" Height="20" Margin="4,0,10,0" Background="{DynamicResource HairlineBrush}" />
                    <Button Style="{StaticResource ToolButton}" Content="Split" Click="OnSplit"
                            ToolTip="Split into clips at the cursor, or around the selection, to move them around (S)" />
                    <Button x:Name="TrimButton" Style="{StaticResource ToolButton}" Content="Trim to selection" Click="OnTrim"
                            ToolTip="Keep only the selected part" />
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Content="Delete" Click="OnDelete"
                            ToolTip="Cut out the selected part (Delete)" />
                    <Button Style="{StaticResource ToolButton}" Content="Silence" Click="OnSilence"
                            ToolTip="Replace the selection with silence" />
                    <Button Style="{StaticResource ToolButton}" Content="Reverse" Click="OnReverse"
                            ToolTip="Play the selection backwards" />
                    <Button x:Name="EditMenuButton" Style="{StaticResource ToolButton}" Click="OnEditMenu"
                            ToolTip="Cut, copy, and paste (Ctrl+X, C, V), and how joins are crossfaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Edit" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MarkersButton" Style="{StaticResource ToolButton}" Click="OnMarkers"
                            ToolTip="Add a marker (M), go to one ([ and ]), or select between two">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Markers" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Margin="4,0,10,0" Background="{DynamicResource HairlineBrush}" />
                    <Button x:Name="PluginsButton" Style="{StaticResource ToolButton}" Click="OnPlugins"
                            ToolTip="Use a VST3 effect installed on this computer: reverb, EQ, compression, and more">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Plugins" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Content="Batch…" Click="OnBatch"
                            ToolTip="Process and convert many sounds at once: normalize, limit, trim silence, remove hum, and more" />
                </WrapPanel>
                <TextBlock x:Name="ScopeHint" Style="{StaticResource OptionHint}" Margin="2,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Status and saving -->
        <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel x:Name="SaveButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveAsButton" Style="{StaticResource ToolButton}" Content="Save as new version…" Click="OnSaveAs"
                            ToolTip="Save the edit as a new file, in any format, and keep the original" />
                    <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Margin="0" Click="OnSave"
                            Foreground="{DynamicResource AccentBrush}" ToolTip="Replace the original file with the edit (Ctrl+S)">
                        <TextBlock Text="Save" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <ProgressBar x:Name="BusyProgress" Style="{StaticResource ThinProgress}" Width="140" />
                        <Button x:Name="CancelButton" Style="{StaticResource PillButton}" Content="CANCEL" Margin="10,0,0,0"
                                Click="OnCancelBusy" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="ShowFileButton" Style="{StaticResource PillButton}" Content="SHOW IN FOLDER" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="OnShowFile" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Volume -->
        <Popup x:Name="GainPopup" PlacementTarget="{Binding ElementName=GainButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="GainValue" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Change the volume by" />
                    </DockPanel>
                    <Slider x:Name="GainSlider" Minimum="-24" Maximum="24" Value="3" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="OnGainChanged" />
                    <TextBlock Style="{StaticResource OptionHint}"
                               Text="Every 6 dB doubles or halves the level. Above 0 dB, loud parts may distort; Normalize avoids that." />
                    <Button Style="{StaticResource ToolButton}" Content="Apply" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="OnApplyGain" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Pitch -->
        <Popup x:Name="PitchPopup" PlacementTarget="{Binding ElementName=PitchButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="PitchValue" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Move the pitch by" />
                    </DockPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="28" Height="28" Content="−"
                                ToolTip="0.1 semitone lower" Click="OnPitchDown" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="+"
                                ToolTip="0.1 semitone higher" Click="OnPitchUp" />
                        <Slider x:Name="PitchSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" Margin="4,0" VerticalAlignment="Center" ValueChanged="OnPitchChanged" />
                    </DockPanel>
                    <Border Style="{StaticResource SegmentBar}" Margin="0,12,0,0">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="KeepSpeedChoice" Style="{StaticResource SegmentButton}" GroupName="PitchMode"
                                         Content="Keep the speed" IsChecked="True" Click="OnPitchModeChanged" />
                            <RadioButton x:Name="ChangeSpeedChoice" Style="{StaticResource SegmentButton}" GroupName="PitchMode"
                                         Content="Change the speed" Click="OnPitchModeChanged" />
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="PitchHint" Style="{StaticResource OptionHint}" />
                    <Button Style="{StaticResource ToolButton}" Content="Apply" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="OnApplyPitch" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Tempo -->
        <Popup x:Name="TempoPopup" PlacementTarget="{Binding ElementName=TempoButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="TempoValue" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Play it at" />
                    </DockPanel>
                    <Slider x:Name="TempoSlider" Minimum="50" Maximum="200" Value="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="OnTempoChanged" />
                    <Border Style="{StaticResource SegmentBar}" Margin="0,12,0,0">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="TempoKeepPitch" Style="{StaticResource SegmentButton}" GroupName="TempoMode"
                                         Content="Keep the pitch" IsChecked="True" Click="OnTempoModeChanged" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="TempoMode"
                                         Content="Pitch changes too" Click="OnTempoModeChanged" />
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="TempoHint" Style="{StaticResource OptionHint}" />
                    <Button Style="{StaticResource ToolButton}" Content="Apply" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="OnApplyTempo" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Equalizer -->
        <Popup x:Name="EqPopup" PlacementTarget="{Binding ElementName=EqButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnToolPopupClosed">
            <Border Style="{StaticResource PopupCard}" Width="620">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="FLAT" Click="OnEqReset"
                                ToolTip="Put every band back to 0 dB" />
                        <TextBlock Style="{StaticResource OptionLabel}" Margin="0" VerticalAlignment="Center"
                                   Text="Drag a handle to shape the sound. The wheel makes a band narrower or wider; double-click switches it off." TextWrapping="Wrap" />
                    </DockPanel>
                    <Border CornerRadius="8" Background="{DynamicResource BackgroundBrush}" Padding="2">
                        <editor:EqCurveView x:Name="EqCurve" Height="210"
                                            CurveBrush="{DynamicResource AccentBrush}" GridBrush="{DynamicResource HairlineBrush}"
                                            LabelBrush="{DynamicResource FaintTextBrush}" SpectrumBrush="{DynamicResource HoverBrush}"
                                            HandleTextBrush="{DynamicResource AccentForegroundBrush}" />
                    </Border>
                    <DockPanel Margin="0,10,0,0">
                        <CheckBox x:Name="EqBandOn" DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" Content="On"
                                  Click="OnEqBandControl" />
                        <TextBlock x:Name="EqBandTitle" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>
                    <Border Style="{StaticResource SegmentBar}" Margin="0,8,0,0">
                        <UniformGrid x:Name="EqShapes" Rows="1">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="EqShape" Tag="Peak" Content="Bell" Click="OnEqShape" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="EqShape" Tag="LowShelf" Content="Low shelf" Click="OnEqShape" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="EqShape" Tag="HighShelf" Content="High shelf" Click="OnEqShape" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="EqShape" Tag="HighPass" Content="Low cut" Click="OnEqShape" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="EqShape" Tag="LowPass" Content="High cut" Click="OnEqShape" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="EqShape" Tag="Notch" Content="Notch" Click="OnEqShape" />
                        </UniformGrid>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock x:Name="EqFrequencyValue" DockPanel.Dock="Right" Style="{StaticResource CardValue}" />
                                <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Frequency" />
                            </DockPanel>
                            <Slider x:Name="EqFrequencySlider" Minimum="0" Maximum="1000" ValueChanged="OnEqBandSlider" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock x:Name="EqGainValue" DockPanel.Dock="Right" Style="{StaticResource CardValue}" />
                                <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Gain" />
                            </DockPanel>
                            <Slider x:Name="EqGainSlider" Minimum="-18" Maximum="18" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    ValueChanged="OnEqBandSlider" />
                        </StackPanel>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="EqQValue" DockPanel.Dock="Right" Style="{StaticResource CardValue}" />
                                <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Width (Q)" />
                            </DockPanel>
                            <Slider x:Name="EqQSlider" Minimum="0" Maximum="1000" ValueChanged="OnEqBandSlider" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="EqPreviewButton" Style="{StaticResource ToolButton}" Content="Preview" Click="OnEqPreview"
                                ToolTip="Play the selection (or from the cursor) through the equalizer; changes are heard as you make them" />
                        <Button Style="{StaticResource ToolButton}" Margin="0" Click="OnApplyEq" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock Text="Apply" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Compressor and limiter -->
        <Popup x:Name="DynamicsPopup" PlacementTarget="{Binding ElementName=DynamicsButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnToolPopupClosed">
            <Border Style="{StaticResource PopupCard}" Width="420">
                <StackPanel>
                    <Border Style="{StaticResource SegmentBar}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="CompressorChoice" Style="{StaticResource SegmentButton}" GroupName="Dynamics"
                                         Content="Compressor" Click="OnDynamicsMode" />
                            <RadioButton x:Name="LimiterChoice" Style="{StaticResource SegmentButton}" GroupName="Dynamics"
                                         Content="Limiter" Click="OnDynamicsMode" />
                        </UniformGrid>
                    </Border>
                    <StackPanel x:Name="CompressorPanel" />
                    <StackPanel x:Name="LimiterPanel" />
                    <DockPanel Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="DynamicsPreviewButton" Style="{StaticResource ToolButton}" Content="Preview" Click="OnDynamicsPreview"
                                    ToolTip="Play the selection (or from the cursor) through it; changes are heard as you make them" />
                            <Button Style="{StaticResource ToolButton}" Margin="0" Click="OnApplyDynamics" Foreground="{DynamicResource AccentBrush}">
                                <TextBlock Text="Apply" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ReductionText" Style="{StaticResource CardValue}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Stereo width -->
        <Popup x:Name="WidthPopup" PlacementTarget="{Binding ElementName=ChannelsButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="WidthValue" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Stereo width" />
                    </DockPanel>
                    <Slider x:Name="WidthSlider" Minimum="0" Maximum="200" Value="120" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OnWidthChanged" />
                    <TextBlock Style="{StaticResource OptionHint}"
                               Text="100% leaves it as it is. Lower narrows it towards mono; higher spreads it wider. Much past 150% can sound hollow in mono." />
                    <Button Style="{StaticResource ToolButton}" Content="Apply" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="OnApplyWidth" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Stems -->
        <Popup x:Name="StemsPopup" PlacementTarget="{Binding ElementName=StemsButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}" Width="360">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Keep" />
                    <WrapPanel x:Name="StemChoices" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource PillButton}" Content="NO VOCALS" Click="OnStemsKaraoke"
                                ToolTip="Everything but the vocals, for karaoke or a backing track" />
                        <Button Style="{StaticResource PillButton}" Content="ONLY VOCALS" Margin="8,0,0,0" Click="OnStemsVocals"
                                ToolTip="Just the vocals (an a cappella)" />
                    </StackPanel>
                    <TextBlock x:Name="StemsHint" Style="{StaticResource OptionHint}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource ToolButton}" Content="Save stems as files…" Click="OnSaveStems"
                                ToolTip="Save the vocals, drums, bass and other instruments as four files, in a folder next to this one" />
                        <Button x:Name="StemsApplyButton" Style="{StaticResource ToolButton}" Margin="0" Click="OnApplyStems"
                                Foreground="{DynamicResource AccentBrush}" Content="Apply" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Noise reduction -->
        <Popup x:Name="NoisePopup" PlacementTarget="{Binding ElementName=RepairButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}" Width="360">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="1. Teach it what the noise sounds like" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="10,0,0,0" Content="Learn"
                                Click="OnLearnNoise" ToolTip="Learn the noise from the selection" />
                        <TextBlock x:Name="NoiseProfileText" Style="{StaticResource OptionHint}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource OptionLabel}" Text="2. Select what to clean (or nothing, for the whole sound), then" />
                    <DockPanel>
                        <TextBlock x:Name="NoiseAmountValue" DockPanel.Dock="Right" Style="{StaticResource CardValue}" />
                        <TextBlock Style="{StaticResource OptionHint}" Margin="0" Text="Turn the noise down by" />
                    </DockPanel>
                    <Slider x:Name="NoiseAmountSlider" Minimum="3" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="OnNoiseSlider" Margin="0,4,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="NoiseSensitivityValue" DockPanel.Dock="Right" Style="{StaticResource CardValue}" />
                        <TextBlock Style="{StaticResource OptionHint}" Margin="0" Text="Treat as noise up to" />
                    </DockPanel>
                    <Slider x:Name="NoiseSensitivitySlider" Minimum="0" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="OnNoiseSlider" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource OptionHint}"
                               Text="Gentle settings sound the most natural. If the music sounds watery, turn both down a little." />
                    <Button x:Name="NoiseApplyButton" Style="{StaticResource ToolButton}" Content="Reduce noise" HorizontalAlignment="Right"
                            Margin="0,12,0,0" Click="OnApplyNoise" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Click removal -->
        <Popup x:Name="ClickPopup" PlacementTarget="{Binding ElementName=RepairButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="ClickValue" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Style="{StaticResource OptionLabel}" Margin="0" Text="Sensitivity" />
                    </DockPanel>
                    <Slider x:Name="ClickSlider" Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="OnClickSlider" />
                    <TextBlock Style="{StaticResource OptionHint}"
                               Text="Higher finds quieter clicks and crackle, but may soften sharp drum hits. Try it on a selection first." />
                    <Button Style="{StaticResource ToolButton}" Content="Remove clicks" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Click="OnApplyClicks" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Analysis -->
        <Popup x:Name="AnalysisPopup" PlacementTarget="{Binding ElementName=AnalyzeButton}" Placement="Top" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource PopupCard}" Width="560">
                <StackPanel>
                    <TextBlock x:Name="AnalysisHeading" Style="{StaticResource OptionLabel}" Margin="0,0,0,8" />
                    <TextBlock x:Name="AnalysisText" FontFamily="Consolas, Segoe UI" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               LineHeight="19" />
                    <Border CornerRadius="8" Background="{DynamicResource BackgroundBrush}" Padding="2" Margin="0,10,0,0">
                        <editor:EqCurveView x:Name="AnalysisSpectrum" Height="150" ShowCurve="False" IsHitTestVisible="False"
                                            CurveBrush="{DynamicResource AccentBrush}" GridBrush="{DynamicResource HairlineBrush}"
                                            LabelBrush="{DynamicResource FaintTextBrush}" SpectrumBrush="{DynamicResource AccentSoftBrush}" />
                    </Border>
                    <TextBlock Style="{StaticResource OptionHint}" Text="The average spectrum. A sharp drop high up is the cut-off of a lossy (MP3, AAC) encode." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="ShowClippingButton" Style="{StaticResource ToolButton}" Content="Show clipping" Click="OnShowClipping"
                                ToolTip="Mark every clipped spot in red on the waveform. F3 goes to the next one." />
                        <Button Style="{StaticResource ToolButton}" Margin="0" Content="Close" Click="OnCloseAnalysis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
