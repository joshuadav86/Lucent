<Window x:Class="WinampInspiredVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winamp-Inspired Visualizer"
        Width="1040" Height="780" MinWidth="600" MinHeight="520"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnClosed">
    <Grid x:Name="RootGrid" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PlaylistRow" Height="230" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Now playing -->
        <DockPanel x:Name="HeaderPanel" Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add files" Click="OnAddFiles" />
                <Button Content="Add folder" Click="OnAddFolder" />
                <Button Content="Clear" Click="OnClearPlaylist" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="NowPlayingTitle" Text="Nothing playing"
                           FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="NowPlayingArtist" Text="Add files or drag music here"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Visualizer: a Direct3D surface is placed in here from code -->
        <Border x:Name="VisualizerFrame" Grid.Row="1" Margin="0,16,0,0"
                Background="Black" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" />

        <!-- Visual controls -->
        <DockPanel x:Name="VisualBar" Grid.Row="2" Margin="0,8,0,12">
            <Button DockPanel.Dock="Right" Content="⛶ Fullscreen" ToolTip="Fullscreen visuals (F11, Esc to exit)"
                    Click="OnToggleFullscreen" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" ToolTip="Previous visual (B)" Click="OnPreviousPreset" />
                <TextBlock x:Name="PresetName" Text="Loading visuals…" MinWidth="180" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="8,0" FontSize="14"
                           Foreground="{StaticResource TextBrush}" />
                <Button Content="▶" ToolTip="Next visual (N)" Click="OnNextPreset" />
                <TextBlock x:Name="VisualizerStatus" Margin="16,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Playlist -->
        <Border x:Name="PlaylistPanel" Grid.Row="3" CornerRadius="12" Background="{StaticResource PanelBrush}" Padding="6">
            <Grid>
                <ListBox x:Name="PlaylistView" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Extended"
                         MouseDoubleClick="OnPlaylistDoubleClick"
                         KeyDown="OnPlaylistKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Indicator}"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Track.Title, Mode=OneWay}" />
                                    <Run Text="{Binding ArtistSuffix, Mode=OneWay}"
                                         Foreground="{StaticResource MutedTextBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                           Text="{Binding Track.DurationText}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyPlaylistHint" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Drag music files or folders here&#x0a;MP3, FLAC, WAV, AAC/M4A, ALAC, WMA, OGG, Opus, AIFF" />
            </Grid>
        </Border>

        <!-- Transport -->
        <Grid x:Name="TransportPanel" Grid.Row="4" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock x:Name="ElapsedText" DockPanel.Dock="Left" Text="0:00" Width="56"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Text="0:00" Width="56" TextAlignment="Right"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <Slider x:Name="SeekBar" Minimum="0" Maximum="1" IsEnabled="False"
                        Thumb.DragStarted="OnSeekDragStarted"
                        Thumb.DragCompleted="OnSeekDragCompleted"
                        ValueChanged="OnSeekValueChanged" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Slider x:Name="VolumeSlider" Width="140" Minimum="0" Maximum="1" Value="0.8"
                            ValueChanged="OnVolumeChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="⏮" ToolTip="Previous" Click="OnPrevious" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}"
                            Content="▶ Play" ToolTip="Play / Pause (Space)" Click="OnPlayPause" />
                    <Button Content="⏹" ToolTip="Stop" Click="OnStop" />
                    <Button Content="⏭" ToolTip="Next" Click="OnNext" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
