<Window x:Class="WinampInspiredVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lucid"
        Icon="Assets/Lucid.ico"
        Width="520" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{DynamicResource SurfaceBrush}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing"
        Closed="OnClosed">

    <!-- The player: a small window like Winamp's main window. The visuals, queue and library
         open in their own windows, which snap to this one and move with it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <Grid x:Name="WindowRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/Lucid-64.png" Width="14" Height="14" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="LUCID" Margin="9,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="TitleButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <ToggleButton x:Name="AudioToolsButton" Style="{StaticResource PanelToggle}" Padding="7,0" Margin="0,0,2,0"
                                  ToolTip="Edit or convert songs" Click="OnAudioTools"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Style="{StaticResource LineIcon}" Data="M2,6.5 V9.5 M5,3.5 V12.5 M8,1.5 V14.5 M11,4.5 V11.5 M14,6.5 V9.5" />
                    </ToggleButton>
                    <ToggleButton x:Name="OptionsButton" Style="{StaticResource PanelToggle}" Padding="7,0"
                                  ToolTip="Options: graphics, visual changes and themes (O)" Click="OnToggleOptions"
                                  WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource OptionsIcon}" StrokeThickness="1.3" />
                    </ToggleButton>

                    <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
                           VerticalOffset="-8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Opened="OnOptionsOpened" Closed="OnOptionsClosed">
                        <Border Margin="16" Width="340" Padding="14,14,14,16" CornerRadius="12"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                            <StackPanel x:Name="OptionsPanel">
                                <Border Style="{StaticResource SegmentBar}">
                                    <UniformGrid Rows="1">
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="OptionsTab" Tag="Graphics" Content="Graphics" Click="OnOptionsTab" IsChecked="True" />
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="OptionsTab" Tag="Visuals" Content="Visual changes" Click="OnOptionsTab" />
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="OptionsTab" Tag="Theme" Content="Theme" Click="OnOptionsTab" />
                                    </UniformGrid>
                                </Border>

                                <StackPanel x:Name="GraphicsTab">
                                    <TextBlock Style="{StaticResource OptionLabel}" Text="Resolution" />
                                    <Border Style="{StaticResource SegmentBar}">
                                        <UniformGrid Rows="1">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Resolution" Tag="Window" Content="Window" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Resolution" Tag="FullHd" Content="1080p" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Resolution" Tag="QuadHd" Content="1440p" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Resolution" Tag="UltraHd" Content="4K" Click="OnOptionChosen" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Style="{StaticResource OptionHint}"
                                               Text="Above your window's own size, visuals are drawn bigger and shrunk to fit: smoother and more detailed, but more work for the graphics card." />

                                    <TextBlock Style="{StaticResource OptionLabel}" Text="Detail" />
                                    <Border Style="{StaticResource SegmentBar}">
                                        <UniformGrid Rows="1">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Detail" Tag="Low" Content="Low" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Detail" Tag="Normal" Content="Normal" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Detail" Tag="High" Content="High" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Detail" Tag="Ultra" Content="Ultra" Click="OnOptionChosen" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Style="{StaticResource OptionHint}"
                                               Text="Finer detail in the 3D and fractal visuals. Ultra looks best with a higher resolution." />

                                    <TextBlock Style="{StaticResource OptionLabel}" Text="Glow" />
                                    <Border Style="{StaticResource SegmentBar}">
                                        <UniformGrid Rows="1">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Glow" Tag="Off" Content="Off" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Glow" Tag="Soft" Content="Soft" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Glow" Tag="Normal" Content="Normal" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="Glow" Tag="Strong" Content="Strong" Click="OnOptionChosen" />
                                        </UniformGrid>
                                    </Border>

                                    <CheckBox x:Name="HdrSwitch" Style="{StaticResource SwitchToggle}" Content="HDR" Margin="0,18,0,0"
                                              Click="OnOptionSwitched" />
                                    <TextBlock x:Name="HdrHint" Style="{StaticResource OptionHint}" />
                                    <CheckBox x:Name="FrameRateSwitch" Style="{StaticResource SwitchToggle}" Content="Show frame rate"
                                              Margin="0,14,0,0" Click="OnOptionSwitched" />
                                </StackPanel>

                                <StackPanel x:Name="VisualsTab" Visibility="Collapsed">
                                    <CheckBox x:Name="AutoCycleSwitch" Style="{StaticResource SwitchToggle}"
                                              Content="Change visuals on the beat" Margin="0,18,0,0" Click="OnOptionSwitched" />
                                    <TextBlock Style="{StaticResource OptionLabel}" Text="Change about every" />
                                    <Border Style="{StaticResource SegmentBar}">
                                        <UniformGrid Rows="1">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="AutoCycleSeconds" Tag="10" Content="10 s" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="AutoCycleSeconds" Tag="15" Content="15 s" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="AutoCycleSeconds" Tag="25" Content="25 s" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="AutoCycleSeconds" Tag="45" Content="45 s" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="AutoCycleSeconds" Tag="90" Content="90 s" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="AutoCycleSeconds" Tag="180" Content="3 min" Click="OnOptionChosen" />
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Style="{StaticResource OptionHint}"
                                               Text="Also in the player bar: click the arrow next to AUTO." />

                                    <TextBlock Style="{StaticResource OptionLabel}" Text="Transition length" />
                                    <Border Style="{StaticResource SegmentBar}">
                                        <UniformGrid Rows="1">
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="TransitionSpeed" Tag="Quick" Content="Quick" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="TransitionSpeed" Tag="Smooth" Content="Smooth" Click="OnOptionChosen" />
                                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="TransitionSpeed" Tag="Slow" Content="Slow" Click="OnOptionChosen" />
                                        </UniformGrid>
                                    </Border>

                                    <CheckBox x:Name="MorphsOnlySwitch" Style="{StaticResource SwitchToggle}"
                                              Content="Morphing transitions only" Margin="0,18,0,0" Click="OnOptionSwitched" />
                                    <TextBlock Style="{StaticResource OptionHint}"
                                               Text="Visuals melt, glow, fly or fold into each other, without the wipes and fades." />
                                </StackPanel>

                                <StackPanel x:Name="ThemeTab" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource OptionLabel}" Text="Colours for everything around the visuals" />
                                    <UniformGrid x:Name="ThemeSwatches" Columns="2" Margin="-2,0,-8,-6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Height="34" Width="40" ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource MinimizeIcon}" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Height="34" Width="40" ToolTip="Close Lucid"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The display: time and meter on the left, the scrolling title and track details on the right. -->
            <Border Grid.Row="1" Margin="10,0,10,0" Padding="14,10,14,10" CornerRadius="10"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="138" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="Transparent" Cursor="Hand" HorizontalAlignment="Left"
                                ToolTip="Click to switch between time played and time left"
                                MouseLeftButtonUp="OnTimeClick">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="PlayStateIcon" Data="{StaticResource StopIcon}" Width="10" Height="10" Stretch="Uniform"
                                      Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,4,10,0" />
                                <TextBlock x:Name="TimeText" Text="0:00" FontSize="30" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MeterHost" Height="26" Margin="0,6,10,0" Cursor="Hand"
                                ToolTip="Click to switch between spectrum bars, a waveform, or nothing"
                                MouseLeftButtonUp="OnMeterClick" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit info…" InputGestureText="Ctrl+I" Click="OnNowPlayingEditInfo" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <DockPanel>
                            <!-- Heart: make the song that's playing a favourite. -->
                            <Button x:Name="TrackFavoriteButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Margin="6,-2,-6,-2" IsEnabled="False"
                                    ToolTip="Add this song to your favourites (H)" Click="OnToggleTrackFavorite">
                                <Path x:Name="TrackFavoriteIcon" Data="{StaticResource HeartIcon}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Button>
                            <!-- The title scrolls when it's too long to fit, like Winamp's. -->
                            <Canvas x:Name="MarqueeArea" Height="20" ClipToBounds="True" SizeChanged="OnMarqueeSizeChanged">
                                <StackPanel x:Name="MarqueeStrip" Orientation="Horizontal">
                                    <TextBlock x:Name="NowPlayingText" Text="Nothing playing" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock x:Name="NowPlayingRepeat" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Canvas>
                        </DockPanel>
                        <TextBlock x:Name="TrackDetails" Text="Drop music on any Lucid window to begin" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                        <DockPanel Margin="0,10,0,0">
                            <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Path Data="{StaticResource SpeakerIcon}" Fill="{DynamicResource MutedTextBrush}" />
                                <Path Data="{StaticResource SpeakerWavesIcon}" Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Text="80%" Width="34" FontSize="11"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FaintTextBrush}" />
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.8" Margin="10,0,6,0"
                                    ToolTip="Volume (mouse wheel over the player changes it too)"
                                    ValueChanged="OnVolumeChanged" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Seek bar -->
            <Slider x:Name="SeekBar" Grid.Row="2" Minimum="0" Maximum="1" IsEnabled="False" Margin="14,8,14,0"
                    Thumb.DragStarted="OnSeekDragStarted"
                    Thumb.DragCompleted="OnSeekDragCompleted"
                    ValueChanged="OnSeekValueChanged" />

            <!-- Transport, shuffle and repeat, and the switches for the other windows -->
            <DockPanel Grid.Row="3" Margin="10,2,10,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Previous track (Z)" Click="OnPrevious">
                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource PreviousTrackIcon}" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Width="40" Height="40" Margin="2,0"
                            ToolTip="Play / Pause (Space)" Click="OnPlayPause">
                        <Path x:Name="PlayPauseIcon" Style="{StaticResource SolidIcon}" Data="{StaticResource PlayIcon}"
                              Margin="2,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Stop" Click="OnStop">
                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource StopIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Next track (X)" Click="OnNext">
                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource NextTrackIcon}" />
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0,0,0"
                            ToolTip="Add music" Click="OnOpenMenu">
                        <Path Style="{StaticResource SolidIcon}" Data="{StaticResource EjectIcon}" />
                    </Button>
                    <ToggleButton x:Name="ShuffleButton" Style="{StaticResource PanelToggle}" Padding="7,0" Margin="6,0,0,0"
                                  ToolTip="Shuffle (S)" Click="OnToggleShuffle">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ShuffleIcon}" />
                    </ToggleButton>
                    <ToggleButton x:Name="RepeatButton" Style="{StaticResource PanelToggle}" Padding="7,0"
                                  ToolTip="Repeat (R)" Click="OnCycleRepeat">
                        <Grid>
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource RepeatIcon}" />
                            <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="8" FontWeight="Bold" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>

                <!-- Each lights up while its window is open. -->
                <StackPanel x:Name="WindowToggles" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent">
                    <StackPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Dock all windows to the player" InputGestureText="D" Click="OnArrangeWindows" />
                            <MenuItem Header="Fill the screen" InputGestureText="G" Click="OnFillScreen" />
                            <MenuItem Header="Shrink everything" InputGestureText="K" Click="OnShrinkWindows" />
                        </ContextMenu>
                    </StackPanel.ContextMenu>
                    <ToggleButton x:Name="VisualsToggle" Style="{StaticResource PanelToggle}" Padding="7,0" FontSize="11"
                                  Content="Visuals" ToolTip="Show or hide the visuals (W)" Click="OnToggleVisuals" />
                    <ToggleButton x:Name="QueueToggle" Style="{StaticResource PanelToggle}" Padding="7,0" FontSize="11"
                                  Content="Queue" ToolTip="Show or hide the queue (Q)" Click="OnToggleQueue" />
                    <ToggleButton x:Name="LibraryToggle" Style="{StaticResource PanelToggle}" Padding="7,0" FontSize="11"
                                  Content="Library" ToolTip="Show or hide the library (L)" Click="OnToggleLibrary" />
                    <ToggleButton x:Name="ArtToggle" Style="{StaticResource PanelToggle}" Padding="7,0" FontSize="11"
                                  Content="Art" ToolTip="Show the playing song's artwork in its own window (C)" Click="OnToggleArtwork" />
                    <ToggleButton x:Name="EqualizerToggle" Style="{StaticResource PanelToggle}" Padding="7,0" FontSize="11"
                                  Content="EQ" ToolTip="Show or hide the equalizer (E)" Click="OnToggleEqualizer" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
