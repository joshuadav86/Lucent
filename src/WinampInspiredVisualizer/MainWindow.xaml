<Window x:Class="WinampInspiredVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winamp-Inspired Visualizer"
        Width="1180" Height="760" MinWidth="720" MinHeight="460"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        Closed="OnClosed">

    <!-- Our own title bar: the window keeps native resizing and snapping. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGradientBrush}" VerticalAlignment="Center" />
                <TextBlock Text="VISUALIZER" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="VisualizerStatus" Margin="18,0,0,0" FontSize="11" MaxWidth="520"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="#E0A84F" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" ToolTip="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource MinimizeIcon}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeRestore">
                    <Path x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Data="{StaticResource MaximizeIcon}" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Visuals and the queue drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A Direct3D surface is placed in here from code. -->
            <Border x:Name="VisualizerFrame" Grid.Column="0" Background="Black" />

            <Border x:Name="PlaylistPanel" Grid.Column="1" Width="330"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="10,14,6,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="8,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" ToolTip="Add files" Click="OnAddFiles">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource AddIcon}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Add a folder" Click="OnAddFolder">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource FolderIcon}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Clear the queue" Click="OnClearPlaylist">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource ClearIcon}" />
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Queue" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="QueueCount" Text="Empty" FontSize="11" Margin="0,1,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="PlaylistView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Extended"
                             MouseDoubleClick="OnPlaylistDoubleClick"
                             KeyDown="OnPlaylistKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="1.5" Margin="0,2,0,2"
                                            Background="{StaticResource AccentGradientBrush}"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenTrue}}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                        <TextBlock Text="{Binding Track.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Track.Artist}" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Track.DurationText}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{StaticResource FaintTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyPlaylistHint" Grid.Row="1" IsHitTestVisible="False"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{StaticResource MusicIcon}" Fill="{StaticResource FaintTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop music here" Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="MP3 · FLAC · WAV · M4A · ALAC · WMA · OGG · Opus · AIFF" Margin="0,4,0,0"
                                   FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource FaintTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Player bar -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,6,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock x:Name="ElapsedText" DockPanel.Dock="Left" Text="0:00" Width="44" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Text="0:00" Width="44" FontSize="11"
                               TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Slider x:Name="SeekBar" Minimum="0" Maximum="1" IsEnabled="False" Margin="6,0"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted"
                            ValueChanged="OnSeekValueChanged" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Now playing -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="NowPlayingArtist" Text="Add music to the queue to begin" FontSize="12"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <!-- Transport -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Stop" Click="OnStop">
                            <Path Style="{StaticResource SolidIcon}" Data="{StaticResource StopIcon}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Previous track" Click="OnPrevious" Margin="6,0">
                            <Path Style="{StaticResource SolidIcon}" Data="{StaticResource PreviousTrackIcon}" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                                ToolTip="Play / Pause (Space)" Click="OnPlayPause">
                            <Path x:Name="PlayPauseIcon" Style="{StaticResource SolidIcon}" Data="{StaticResource PlayIcon}"
                                  Margin="2,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Next track" Click="OnNext" Margin="6,0">
                            <Path Style="{StaticResource SolidIcon}" Data="{StaticResource NextTrackIcon}" />
                        </Button>
                        <Button x:Name="QueueButton" Style="{StaticResource IconButton}"
                                ToolTip="Show or hide the queue (Q)" Click="OnToggleQueue">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource QueueIcon}" />
                        </Button>
                    </StackPanel>

                    <!-- Visuals and volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Previous visual (B)" Click="OnPreviousPreset">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowLeftIcon}" />
                        </Button>
                        <Button x:Name="PresetPickerButton" Style="{StaticResource PickerButton}" Width="190" Margin="4,0"
                                ToolTip="Choose a visual (V)" Click="OnTogglePresetPicker">
                            <DockPanel>
                                <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronUpIcon}"
                                      Stroke="{StaticResource MutedTextBrush}" Margin="8,0,0,0" />
                                <TextBlock x:Name="PresetName" Text="Loading visuals…" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Next visual (N)" Click="OnNextPreset">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowRightIcon}" />
                        </Button>

                        <!-- The visual picker: every visual in one list, opened from the name above. -->
                        <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetPickerButton}"
                               Placement="Top" VerticalOffset="-10" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" Closed="OnPresetPopupClosed">
                            <Border Margin="16" Width="260" Padding="6" CornerRadius="12"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="VISUALS" Margin="12,8,12,6" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ListBox x:Name="PresetList" MaxHeight="440" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonUp="OnPresetListClick"
                                             KeyDown="OnPresetListKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="Label" Text="{Binding}" FontSize="13"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button x:Name="AutoCycleButton" Style="{StaticResource PillButton}" Content="AUTO"
                                Margin="6,0,14,0" Foreground="{StaticResource AccentBrush}"
                                ToolTip="Move to a new visual on the beat every 25 seconds or so (A)"
                                Click="OnToggleAutoCycle" />
                        <Grid VerticalAlignment="Center">
                            <Path Data="{StaticResource SpeakerIcon}" Fill="{StaticResource MutedTextBrush}" />
                            <Path Data="{StaticResource SpeakerWavesIcon}" Stroke="{StaticResource MutedTextBrush}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="1" Value="0.8" Margin="8,0,10,0"
                                ValueChanged="OnVolumeChanged" />
                        <Button Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                ToolTip="Fullscreen visuals (F11, Esc to exit)" Click="OnToggleFullscreen">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource FullscreenIcon}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
