<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows 10 SDK version brings in the WinRT APIs, for Lucent's place in Windows' media controls
      (the volume flyout and lock screen, see Audio/MediaControls.cs). It still runs on any Windows 10 or 11:
      the version below (1809, the oldest .NET's WinRT support works on) is what the code is checked
      against, and on anything older the media controls quietly fall back to plain media-key hotkeys.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Lucent</AssemblyName>
    <Product>Lucent</Product>
    <ApplicationIcon>Assets\Lucent.ico</ApplicationIcon>
    <RootNamespace>WinampInspiredVisualizer</RootNamespace>
    <!-- CI sets the last number to the build number, so every build installs over the one before. -->
    <Version>0.1.0</Version>
    <!-- Program.Main, so Velopack can run before the app starts. -->
    <StartupObject>WinampInspiredVisualizer.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucent.Core\Lucent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Lucent.ico" />
    <Resource Include="Assets\Lucent-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders are compiled when the app starts, so they ship as plain files people can edit. -->
    <None Include="Presets\*.hlsl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Shaders\*.hlsl*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Copies inside Lucent.exe too, for when it's run without its folder (say, straight from the zip). -->
    <EmbeddedResource Include="Presets\*.hlsl" LogicalName="Presets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Shaders\*.hlsl*" LogicalName="Shaders/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The plugin helper that runs VST3 effects for the editor (src/PluginHost), when it has been built (see the
    README; CI always builds it). It's a program of its own, so it ships beside Lucent.exe.
  -->
  <ItemGroup Condition="Exists('..\..\build\PluginHost\Release\LucentPluginHost.exe')">
    <None Include="..\..\build\PluginHost\Release\LucentPluginHost.exe" Link="LucentPluginHost.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    The MP3 encoder (LAME, from NAudio.Lame) is a native DLL that NAudio.Lame loads from the app's folder.
    Keep it out of the single-file bundle so it ships beside Lucent.exe, where it can be found (and,
    as its LGPL licence asks, swapped for another build).
  -->
  <Target Name="KeepLameBesideTheApp" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Condition="'%(None.Filename)' == 'libmp3lame.32' Or '%(None.Filename)' == 'libmp3lame.64'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

  <!--
    WebView2's loader (for the Bandcamp sign-in page) is a native DLL that WebView2 loads from the app's
    folder. Like LAME, it ships beside Lucent.exe rather than inside the single-file bundle.
  -->
  <Target Name="KeepWebView2LoaderBesideTheApp" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Filename)' == 'WebView2Loader'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
