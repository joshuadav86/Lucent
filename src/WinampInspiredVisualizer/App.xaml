<Application x:Class="WinampInspiredVisualizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0E0F14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#171922" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38E0A0" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8EAF0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8FA3" />
    </Application.Resources>
</Application>
