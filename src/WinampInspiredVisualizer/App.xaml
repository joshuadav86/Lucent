<Application x:Class="WinampInspiredVisualizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <!-- Palette: these are the Midnight theme's colours. Themes/ThemeManager.cs swaps them at runtime,
             so anything coloured from here uses DynamicResource. -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#09090C" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#101015" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#16161D" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1D1D26" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#1E1E28" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECECF1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7D7D8C" />
        <SolidColorBrush x:Key="FaintTextBrush" Color="#4A4A57" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2550" />
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#22D3EE" Offset="1" />
        </LinearGradientBrush>
        <!-- Glyphs drawn on top of the accent gradient (the play button). -->
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

        <!-- Skin: the Lucent skin's shapes, type and finish. Themes/SkinManager.cs swaps these at runtime
             (building its brushes from the theme's colours), so anything shaped from here uses DynamicResource. -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <!-- The time and title in the player's display. -->
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <x:Static x:Key="DisplayWeight" Member="FontWeights.SemiBold" />
        <CornerRadius x:Key="TinyCorner">6</CornerRadius>
        <CornerRadius x:Key="SegmentCorner">7</CornerRadius>
        <CornerRadius x:Key="ControlCorner">8</CornerRadius>
        <CornerRadius x:Key="BarCorner">9</CornerRadius>
        <CornerRadius x:Key="PanelCorner">10</CornerRadius>
        <CornerRadius x:Key="CardCorner">12</CornerRadius>
        <CornerRadius x:Key="TrackCorner">3</CornerRadius>
        <!-- Pills, knobs and the play button: fully round, or nearly square in the boxier skins. -->
        <CornerRadius x:Key="RoundCorner">999</CornerRadius>
        <!-- Each window's outline, and a finish laid over its background (light, metal, frost). -->
        <SolidColorBrush x:Key="WindowFrameBrush" Color="#1E1E28" />
        <SolidColorBrush x:Key="PanelSheenBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="Transparent" />
        <!-- The player's display: its fill and edge, a shadow along its top and left, scan lines over it, and its text. -->
        <SolidColorBrush x:Key="DisplayBrush" Color="#09090C" />
        <SolidColorBrush x:Key="DisplayEdgeBrush" Color="#1E1E28" />
        <SolidColorBrush x:Key="DisplayInsetBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DisplayLinesBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DisplayTimeBrush" Color="#ECECF1" />
        <SolidColorBrush x:Key="DisplayTitleBrush" Color="#ECECF1" />
        <!-- The transport buttons: a face, a light top and left edge and a dark bottom and right edge, and the glyph.
             The play button shares the edges, and adds a gloss and a glow that some skins leave on. -->
        <SolidColorBrush x:Key="ButtonFaceBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonLightEdgeBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonDarkEdgeBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonGlyphBrush" Color="#7D7D8C" />
        <SolidColorBrush x:Key="PlayGlossBrush" Color="Transparent" />
        <sys:Double x:Key="PlayGlowRest">0</sys:Double>
        <!-- DisplayGlowEffect (a glow round the display) is only set by skins that have one. -->

        <!-- Icons are drawn as vector shapes so they look the same on every version of Windows,
             without depending on an icon font being installed. -->
        <Geometry x:Key="PlayIcon">M1,0 L13,7 L1,14 Z</Geometry>
        <Geometry x:Key="PauseIcon">M0,0 H4 V14 H0 Z M8,0 H12 V14 H8 Z</Geometry>
        <Geometry x:Key="StopIcon">M2,0 H10 A2,2 0 0 1 12,2 V10 A2,2 0 0 1 10,12 H2 A2,2 0 0 1 0,10 V2 A2,2 0 0 1 2,0 Z</Geometry>
        <Geometry x:Key="PreviousTrackIcon">M0,0 H2 V12 H0 Z M13,0 V12 L3,6 Z</Geometry>
        <Geometry x:Key="NextTrackIcon">M0,0 L10,6 L0,12 Z M11,0 H13 V12 H11 Z</Geometry>
        <Geometry x:Key="AddIcon">M8,1 V15 M1,8 H15</Geometry>
        <Geometry x:Key="FolderIcon">M1,3.5 Q1,2 2.5,2 H6 L7.5,4 H13.5 Q15,4 15,5.5 V12.5 Q15,14 13.5,14 H2.5 Q1,14 1,12.5 Z</Geometry>
        <Geometry x:Key="ClearIcon">M1,4 H15 M6,4 V1.5 H10 V4 M3,4 L4,15 H12 L13,4</Geometry>
        <Geometry x:Key="ArrowLeftIcon">M15,8 H1 M6,3 L1,8 L6,13</Geometry>
        <Geometry x:Key="ArrowRightIcon">M1,8 H15 M10,3 L15,8 L10,13</Geometry>
        <Geometry x:Key="HandIcon">M4.5,9 V4.25 A1.25,1.25 0 0 1 7,4.25 V8 M7,8 V2.75 A1.25,1.25 0 0 1 9.5,2.75 V8 M9.5,8 V3.75 A1.25,1.25 0 0 1 12,3.75 V8.5 M12,8.5 V6.25 A1.25,1.25 0 0 1 14.5,6.25 V10 Q14.5,15 9.5,15 H8.5 Q6,15 4.5,13 L2,9.75 A1.25,1.25 0 0 1 4,8.25 L4.5,9</Geometry>
        <Geometry x:Key="MagnetIcon">M3,2.5 H6 V8 A2,2 0 0 0 10,8 V2.5 H13 V8 A5,5 0 0 1 3,8 Z M3,5.5 H6 M10,5.5 H13</Geometry>
        <Geometry x:Key="TabIcon">M1.5,8 H11 M7.5,4.5 L11,8 L7.5,11.5 M14,3.5 V12.5</Geometry>
        <Geometry x:Key="ChevronUpIcon">M1,5 L5,1 L9,5</Geometry>
        <Geometry x:Key="ChevronDownIcon">M1,1 L5,5 L9,1</Geometry>
        <Geometry x:Key="ChevronRightIcon">M1,1 L5,5 L1,9</Geometry>
        <Geometry x:Key="CheckIcon">M1,5 L4.5,8.5 L11,1.5</Geometry>
        <Geometry x:Key="PlaySmallIcon">M0,0 L10,6 L0,12 Z</Geometry>
        <Geometry x:Key="RefreshIcon">M13.5,8 A5.5,5.5 0 1 1 11.89,4.11 M8.9,3.85 L11.89,4.11 L11.63,1.12</Geometry>
        <Geometry x:Key="SortIcon">M1,3 H15 M1,8 H11 M1,13 H7</Geometry>
        <Geometry x:Key="CollapseAllIcon">M4,1 L8,5 L12,1 M4,15 L8,11 L12,15 M1,8 H15</Geometry>
        <Geometry x:Key="ExpandAllIcon">M4,5 L8,1 L12,5 M4,11 L8,15 L12,11 M1,8 H15</Geometry>
        <Geometry x:Key="SearchIcon">M11.5,6.5 A5,5 0 1 1 1.5,6.5 A5,5 0 1 1 11.5,6.5 Z M10.1,10.1 L14.5,14.5</Geometry>
        <Geometry x:Key="PanelLeftIcon">M3,2 H13 Q15,2 15,4 V12 Q15,14 13,14 H3 Q1,14 1,12 V4 Q1,2 3,2 Z M6,2 V14 M2.5,5 H4.5 M2.5,8 H4.5</Geometry>
        <Geometry x:Key="PanelRightIcon">M3,2 H13 Q15,2 15,4 V12 Q15,14 13,14 H3 Q1,14 1,12 V4 Q1,2 3,2 Z M10,2 V14 M11.5,5 H13.5 M11.5,8 H13.5</Geometry>
        <Geometry x:Key="CollapseLeftIcon">M7.5,3 L2.5,8 L7.5,13 M13.5,3 L8.5,8 L13.5,13</Geometry>
        <Geometry x:Key="CollapseRightIcon">M2.5,3 L7.5,8 L2.5,13 M8.5,3 L13.5,8 L8.5,13</Geometry>
        <Geometry x:Key="OptionsIcon">M13.31,6.58 L15.23,6.98 L15.23,9.02 L13.31,9.42 L12.76,10.75 L13.83,12.39 L12.39,13.83 L10.75,12.76 L9.42,13.31 L9.02,15.23 L6.98,15.23 L6.58,13.31 L5.25,12.76 L3.61,13.83 L2.17,12.39 L3.24,10.75 L2.69,9.42 L0.77,9.02 L0.77,6.98 L2.69,6.58 L3.24,5.25 L2.17,3.61 L3.61,2.17 L5.25,3.24 L6.58,2.69 L6.98,0.77 L9.02,0.77 L9.42,2.69 L10.75,3.24 L12.39,2.17 L13.83,3.61 L12.76,5.25 Z M10.4,8 A2.4,2.4 0 1 1 5.6,8 A2.4,2.4 0 1 1 10.4,8 Z</Geometry>
        <!-- A framed picture (the artwork window) and a pin (keep a window on top). -->
        <Geometry x:Key="ArtworkIcon">M3,1.5 H13 Q14.5,1.5 14.5,3 V13 Q14.5,14.5 13,14.5 H3 Q1.5,14.5 1.5,13 V3 Q1.5,1.5 3,1.5 Z M1.5,11.5 L5.5,7.5 L9.5,11.5 L11.5,9.5 L14.5,12.5 M9.75,5.25 A1.25,1.25 0 1 1 12.25,5.25 A1.25,1.25 0 1 1 9.75,5.25 Z</Geometry>
        <!-- The analyzer: a frame with a heatmap's bands and a waveform along the bottom. -->
        <Geometry x:Key="AnalyzerIcon">M3,1.5 H13 Q14.5,1.5 14.5,3 V13 Q14.5,14.5 13,14.5 H3 Q1.5,14.5 1.5,13 V3 Q1.5,1.5 3,1.5 Z M4,5 H7 M9,5 H12 M4,8 H12 M3.5,12 L5,10.5 L6.5,12.5 L8,10 L9.5,12.5 L11,10.5 L12.5,12</Geometry>
        <Geometry x:Key="PinIcon">M9.5,1.5 L14.5,6.5 M10.75,2.75 L7,6.5 L4,6.5 L9.5,12 L9.5,9 L13.25,5.25 M6.75,9.25 L1.75,14.25</Geometry>
        <Geometry x:Key="FullscreenIcon">M1,5 V1 H5 M11,1 H15 V5 M15,11 V15 H11 M5,15 H1 V11</Geometry>
        <Geometry x:Key="SpeakerIcon">M1,5 H4 L8,1 V15 L4,11 H1 Z</Geometry>
        <Geometry x:Key="SpeakerWavesIcon">M11,5 Q13,8 11,11 M13.5,2.5 Q17,8 13.5,13.5</Geometry>
        <Geometry x:Key="MinimizeIcon">M0,5.5 H10</Geometry>
        <Geometry x:Key="MaximizeIcon">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
        <Geometry x:Key="RestoreIcon">M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</Geometry>
        <!-- Full screen in a title bar: corners pointing out, and in to leave it. -->
        <Geometry x:Key="FullScreenCaptionIcon">M0.5,3.5 V0.5 H3.5 M6.5,0.5 H9.5 V3.5 M9.5,6.5 V9.5 H6.5 M3.5,9.5 H0.5 V6.5</Geometry>
        <Geometry x:Key="ExitFullScreenCaptionIcon">M3.5,0.5 V3.5 H0.5 M6.5,0.5 V3.5 H9.5 M9.5,6.5 H6.5 V9.5 M3.5,9.5 V6.5 H0.5</Geometry>
        <Geometry x:Key="CloseIcon">M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5</Geometry>
        <!-- The visual picker's glyph on a 20 x 20 grid: a screen drawn as a line, with a spark filled in. -->
        <Geometry x:Key="VisualsScreenIcon">M4.75,3.75 H15.25 A3,3 0 0 1 18.25,6.75 V13.25 A3,3 0 0 1 15.25,16.25 H4.75 A3,3 0 0 1 1.75,13.25 V6.75 A3,3 0 0 1 4.75,3.75 Z</Geometry>
        <Geometry x:Key="VisualsSparkIcon">M9.1,6.2 Q9.98,9.72 13.5,10.6 Q9.98,11.48 9.1,15 Q8.22,11.48 4.7,10.6 Q8.22,9.72 9.1,6.2 Z M14.4,5.1 Q14.86,6.54 16.3,7 Q14.86,7.46 14.4,8.9 Q13.94,7.46 12.5,7 Q13.94,6.54 14.4,5.1 Z</Geometry>
        <Geometry x:Key="HeartIcon">M8,14 C8,14 1.2,9.6 1.2,5.4 A3.3,3.3 0 0 1 8,4.2 A3.3,3.3 0 0 1 14.8,5.4 C14.8,9.6 8,14 8,14 Z</Geometry>
        <Geometry x:Key="StarIcon">M8,1 L10.1,5.6 L15,6.1 L11.3,9.4 L12.4,14.3 L8,11.8 L3.6,14.3 L4.7,9.4 L1,6.1 L5.9,5.6 Z</Geometry>
        <Geometry x:Key="ListIcon">M1,3 H11 M1,8 H11 M1,13 H8 M13,10 V16 M10,13 H16</Geometry>
        <Geometry x:Key="EjectIcon">M7,0 L14,8 H0 Z M0,10 H14 V12.5 H0 Z</Geometry>
        <!-- A plus: the Sources button, where music, radio, and the music apps come in. -->
        <Geometry x:Key="SourcesIcon">M6,1 V11 M1,6 H11</Geometry>
        <Geometry x:Key="ShuffleIcon">M1,4 H3.5 Q6.5,4 8,8 Q9.5,12 12.5,12 H15 M1,12 H3.5 Q6.5,12 8,8 Q9.5,4 12.5,4 H15 M13,2 L15,4 L13,6 M13,10 L15,12 L13,14</Geometry>
        <Geometry x:Key="RepeatIcon">M2,8.5 V6.5 Q2,4 4.5,4 H13.5 M11.5,2 L13.5,4 L11.5,6 M14,7.5 V9.5 Q14,12 11.5,12 H2.5 M4.5,10 L2.5,12 L4.5,14</Geometry>
        <GeometryGroup x:Key="MusicIcon">
            <EllipseGeometry Center="6,21" RadiusX="4.5" RadiusY="3.5" />
            <EllipseGeometry Center="22,18" RadiusX="4.5" RadiusY="3.5" />
            <PathGeometry Figures="M9,21 V4.5 L26,1 V18 H24.5 V6.5 L10.5,9.6 V21 Z" />
        </GeometryGroup>

        <!-- A solid icon that takes its colour from the button it sits in. -->
        <Style x:Key="SolidIcon" TargetType="Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A line-drawn icon that takes its colour from the button it sits in. -->
        <Style x:Key="LineIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionIcon" TargetType="Path" BasedOn="{StaticResource LineIcon}">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeStartLineCap" Value="Flat" />
            <Setter Property="StrokeEndLineCap" Value="Flat" />
            <Setter Property="StrokeLineJoin" Value="Miter" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        </Style>

        <!-- Borderless icon button: just a glyph that brightens on hover. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The player's previous, stop, next and eject buttons. Lucent draws them as bare glyphs; other skins
             give them a face and raised edges, like hardware buttons. -->
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonGlyphBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="{DynamicResource ControlCorner}" Background="{DynamicResource ButtonFaceBrush}" />
                            <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Background="{TemplateBinding Background}" />
                            <Border x:Name="LightEdge" CornerRadius="{DynamicResource ControlCorner}" BorderThickness="1,1,0,0"
                                    BorderBrush="{DynamicResource ButtonLightEdgeBrush}" />
                            <Border x:Name="DarkEdge" CornerRadius="{DynamicResource ControlCorner}" BorderThickness="0,0,1,1"
                                    BorderBrush="{DynamicResource ButtonDarkEdgeBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <!-- Pressed in: the edges swap, so a raised button looks pushed down. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                                <Setter TargetName="LightEdge" Property="BorderBrush" Value="{DynamicResource ButtonDarkEdgeBrush}" />
                                <Setter TargetName="DarkEdge" Property="BorderBrush" Value="{DynamicResource ButtonLightEdgeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big play button: round in most skins, nearly square in the boxier ones. -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="{DynamicResource RoundCorner}" Background="{DynamicResource AccentGradientBrush}"
                                    Opacity="{DynamicResource PlayGlowRest}">
                                <Border.Effect>
                                    <BlurEffect Radius="14" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="{DynamicResource RoundCorner}" Background="{DynamicResource AccentGradientBrush}" />
                            <Border CornerRadius="{DynamicResource RoundCorner}" Background="{DynamicResource PlayGlossBrush}" />
                            <Border x:Name="LightEdge" CornerRadius="{DynamicResource RoundCorner}" BorderThickness="1,1,0,0"
                                    BorderBrush="{DynamicResource ButtonLightEdgeBrush}" />
                            <Border x:Name="DarkEdge" CornerRadius="{DynamicResource RoundCorner}" BorderThickness="0,0,1,1"
                                    BorderBrush="{DynamicResource ButtonDarkEdgeBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                                <Setter TargetName="LightEdge" Property="BorderBrush" Value="{DynamicResource ButtonDarkEdgeBrush}" />
                                <Setter TargetName="DarkEdge" Property="BorderBrush" Value="{DynamicResource ButtonLightEdgeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text button used for "Auto". -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource RoundCorner}" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar switch for a side panel: lit in the accent colour while the panel is open. -->
        <Style x:Key="PanelToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="9,0,11,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inside the options panel: a label above each setting, and a quieter hint below some. -->
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
        <Style x:Key="OptionHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,6,0,0" />
        </Style>

        <!-- A row of choices where exactly one is picked: SegmentButtons inside a SegmentBar. -->
        <Style x:Key="SegmentBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource BarCorner}" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource SegmentCorner}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A one-line text box, e.g. for naming a playlist. -->
        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A search box: a magnifying glass, then what's typed, with a faint hint (the box's Tag) while it's empty.
             The right padding leaves room for a clear button laid over the box's right end. -->
        <Style x:Key="SearchInput" TargetType="TextBox" BasedOn="{StaticResource TextInput}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0,0,26,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <DockPanel>
                                <Path x:Name="Glass" DockPanel.Dock="Left" Style="{StaticResource LineIcon}" Data="{StaticResource SearchIcon}"
                                      Stroke="{DynamicResource FaintTextBrush}" Margin="8,0,4,0" />
                                <Grid Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="2,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource FaintTextBrush}" IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FaintTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Glass" Property="Stroke" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An on/off switch with its label on the left. -->
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="2,0,12,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="36" Height="20" CornerRadius="{DynamicResource RoundCorner}"
                                    Background="{DynamicResource FaintTextBrush}">
                                <Border x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left"
                                        CornerRadius="{DynamicResource RoundCorner}" Background="{DynamicResource TextBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource AccentForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One theme in the theme picker: a small preview in that theme's own colours, ringed when chosen. -->
        <Style x:Key="ThemeSwatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="{DynamicResource CardCorner}" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FaintTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The visual name in the player bar: a quiet button that opens the visual picker. -->
        <Style x:Key="PickerButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window caption buttons. -->
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hairline slider: a thin track that fills with the accent, thumb appears on hover. -->
        <Style x:Key="SliderEdgeButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="{DynamicResource TrackCorner}" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdgeButton}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource AccentGradientBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdgeButton}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource HairlineBrush}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Opacity="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="12" Height="12" CornerRadius="{DynamicResource RoundCorner}" Background="{DynamicResource TextBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The seek bar: a thicker track in the accent colours with a playhead that always shows
             where the song is, so it reads differently from the thin, quiet volume bar. -->
        <Style x:Key="SeekEdgeButton" TargetType="RepeatButton" BasedOn="{StaticResource SliderEdgeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="6" CornerRadius="{DynamicResource TrackCorner}" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SeekSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SeekEdgeButton}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource AccentGradientBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SeekEdgeButton}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource HoverBrush}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Head" Width="12" Height="12" CornerRadius="{DynamicResource RoundCorner}"
                                                        Background="{DynamicResource TextBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Head" Property="Width" Value="14" />
                                                    <Setter TargetName="Head" Property="Height" Value="14" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The volume bar: thin and filled in a quiet grey, not the accent colour of the seek bar. -->
        <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdgeButton}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource MutedTextBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdgeButton}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource HairlineBrush}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Opacity="0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="10" Height="10" CornerRadius="{DynamicResource RoundCorner}" Background="{DynamicResource TextBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, unobtrusive scroll bar for the playlist. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="{DynamicResource TrackCorner}" Background="{DynamicResource HoverBrush}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="12,8" Margin="0,1" CornerRadius="{DynamicResource ControlCorner}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus (right-click menus and the drop-down menus built in code). -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- Scrolls when there are more items than fit on the screen. -->
                        <Border MinWidth="190" Padding="4" CornerRadius="{DynamicResource PanelCorner}"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <ScrollViewer Focusable="False" CanContentScroll="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- An item with items of its own (like Resolution) shows an arrow and opens them beside it. -->
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row" Padding="10,7" CornerRadius="{DynamicResource TinyCorner}" Background="Transparent">
                                <DockPanel>
                                    <Path x:Name="Check" DockPanel.Dock="Left" Width="14" Margin="0,0,8,0"
                                          Data="{StaticResource CheckIcon}" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Hidden" />
                                    <Path x:Name="Arrow" DockPanel.Dock="Right" Margin="16,0,0,0"
                                          Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource MutedTextBrush}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      TextBlock.FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="6" VerticalOffset="-5"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="150" Padding="4" CornerRadius="{DynamicResource PanelCorner}"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                    <ScrollViewer Focusable="False" CanContentScroll="False"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{DynamicResource HairlineBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder headings in the library: a chevron that turns when the folder is open. -->
        <Style x:Key="FolderHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Padding="8,8,8,6" CornerRadius="{DynamicResource TinyCorner}" Background="Transparent">
                            <DockPanel>
                                <Path x:Name="Chevron" DockPanel.Dock="Left" Margin="2,0,10,0" VerticalAlignment="Center"
                                      Data="{StaticResource ChevronRightIcon}" Stroke="{DynamicResource MutedTextBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <!-- A heading the library has highlighted (its Expander's Tag is true). -->
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource FolderHeaderToggle}" Content="{TemplateBinding Header}"
                                          Tag="{TemplateBinding Tag}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Application.Resources>
</Application>
