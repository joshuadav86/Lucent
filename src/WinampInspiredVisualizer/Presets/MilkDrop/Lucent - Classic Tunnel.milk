per_frame_init_1=spin = 0; hue = rand(100) * 0.0628;
per_frame_1=// The tunnel turns faster on loud bass, and the colours drift round the wheel.
per_frame_2=spin = spin * 0.95 + (bass_att - 1) * 0.004;
per_frame_3=rot = spin + 0.01 * sin(time * 0.23);
per_frame_4=hue = hue + 0.01 + treb * 0.005;
per_frame_5=wave_r = 0.5 + 0.5 * sin(hue);
per_frame_6=wave_g = 0.5 + 0.5 * sin(hue + 2.094);
per_frame_7=wave_b = 0.5 + 0.5 * sin(hue + 4.188);
per_frame_8=zoom = 1.02 + 0.03 * above(bass, 1.3);
per_frame_9=q1 = 0.04 * sin(time * 0.31);
per_frame_10=q2 = 0.04 * cos(time * 0.27);
per_pixel_1=// Faster towards the edges, so the middle reads as a far-off tunnel mouth.
per_pixel_2=zoom = zoom + rad * 0.06 * (1 + mid_att * 0.3);
per_pixel_3=dx = q1 * (1 - rad);
per_pixel_4=dy = q2 * (1 - rad);
