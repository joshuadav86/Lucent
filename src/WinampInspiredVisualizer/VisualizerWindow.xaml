<local:ToolWindow x:Class="WinampInspiredVisualizer.VisualizerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:WinampInspiredVisualizer.Windows"
                  Title="Lucid visuals"
                  Width="820" Height="560" MinWidth="360" MinHeight="240"
                  Background="{DynamicResource SurfaceBrush}"
                  StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <Grid x:Name="WindowRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource VisualsScreenIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Data="{StaticResource VisualsSparkIcon}" Fill="{DynamicResource AccentBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="VISUALS" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VisualizerStatus" Margin="16,0,0,0" FontSize="11" MaxWidth="460"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="#E0A84F" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Height="34" Width="40" ToolTip="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeRestore">
                        <Path x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Data="{StaticResource MaximizeIcon}" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Height="34" Width="40" ToolTip="Hide the visuals (W)"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnHideWindow">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- A Direct3D surface is placed in here from code. Double-click it for fullscreen. -->
            <Border x:Name="VisualizerFrame" Grid.Row="1" Background="Black" />

            <!-- Visuals bar -->
            <Grid x:Name="BottomBar" Grid.Row="2" Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Frame rate readout, shown when "Show frame rate" is on in Options. -->
                <TextBlock x:Name="FrameRateText" Grid.Column="0" Text="– fps" Margin="4,0,12,0" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed"
                           ToolTip="Frames drawn per second, the size the visuals are drawn at, and whether HDR is on. Turn it off in Options." />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Previous visual (B)" Click="OnPreviousPreset">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowLeftIcon}" />
                    </Button>
                    <Button x:Name="PresetPickerButton" Style="{StaticResource PickerButton}" Width="220" Margin="4,0"
                            Padding="10,0,12,0" ToolTip="Choose a visual (V)" Click="OnTogglePresetPicker">
                        <DockPanel>
                            <!-- A screen with a spark in it: marks this as the place to pick the visuals. -->
                            <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource VisualsScreenIcon}"
                                      Stroke="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Path Data="{StaticResource VisualsSparkIcon}" Fill="{DynamicResource AccentBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </Grid>
                            <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronUpIcon}"
                                  Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                            <TextBlock x:Name="PresetName" Text="Loading visuals…" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Next visual (N)" Click="OnNextPreset">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowRightIcon}" />
                    </Button>

                    <!-- The visual picker: every visual in one list, opened from the name above. -->
                    <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetPickerButton}"
                           Placement="Top" VerticalOffset="-10" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Closed="OnPresetPopupClosed">
                        <Border Margin="16" Width="260" Padding="6" CornerRadius="12"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="VISUALS" Margin="12,8,12,6" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <ListBox x:Name="PresetList" MaxHeight="440" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="OnPresetListClick"
                                         KeyDown="OnPresetListKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="Label" Text="{Binding}" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Auto mode: the pill turns it on or off (right-click it, or use the arrow, to choose how often it changes). -->
                    <Button x:Name="AutoCycleButton" Style="{StaticResource PillButton}" Content="AUTO · 25s"
                            Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}"
                            Click="OnToggleAutoCycle" MouseRightButtonUp="OnAutoCycleRightClick" />
                    <Button x:Name="AutoCycleIntervalButton" Style="{StaticResource IconButton}" Width="22" Height="26"
                            Margin="1,0,6,0" ToolTip="How often Auto changes the visual" Click="OnAutoCycleIntervalMenu">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronUpIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32"
                            ToolTip="Fullscreen visuals (F11, Esc to exit)" Click="OnToggleFullscreen">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource FullscreenIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</local:ToolWindow>
