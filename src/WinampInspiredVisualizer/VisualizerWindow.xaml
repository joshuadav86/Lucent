<local:ToolWindow x:Class="WinampInspiredVisualizer.VisualizerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:WinampInspiredVisualizer.Windows"
                  Title="Lucid visuals"
                  Width="820" Height="560" MinWidth="360" MinHeight="240"
                  Background="{DynamicResource SurfaceBrush}"
                  StateChanged="OnWindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Grid x:Name="WindowRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="34" Background="{DynamicResource TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource VisualsScreenIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Path Data="{StaticResource VisualsSparkIcon}" Fill="{DynamicResource AccentBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="VISUALS" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VisualizerStatus" Margin="16,0,0,0" FontSize="11" MaxWidth="460"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="#E0A84F" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Height="34" Width="40" ToolTip="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximizeRestore">
                        <Path x:Name="MaximizeIcon" Style="{StaticResource CaptionIcon}" Data="{StaticResource MaximizeIcon}" />
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Height="34" Width="40" ToolTip="Hide the visuals (W)"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnHideWindow">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- A Direct3D surface is placed in here from code. Double-click it for fullscreen. -->
            <Border x:Name="VisualizerFrame" Grid.Row="1" Background="Black" />

            <!-- Visuals bar -->
            <Grid x:Name="BottomBar" Grid.Row="2" Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Frame rate readout, shown when "Show frame rate" is on in Options. -->
                <TextBlock x:Name="FrameRateText" Grid.Column="0" Text="– fps" Margin="4,0,12,0" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed"
                           ToolTip="Frames drawn per second, the size the visuals are drawn at, and whether HDR is on. Turn it off in Options." />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Previous visual (B)" Click="OnPreviousPreset">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowLeftIcon}" />
                    </Button>
                    <Button x:Name="PresetPickerButton" Style="{StaticResource PickerButton}" Width="220" Margin="4,0"
                            Padding="10,0,12,0" ToolTip="Choose a visual (V)" Click="OnTogglePresetPicker">
                        <DockPanel>
                            <!-- A screen with a spark in it: marks this as the place to pick the visuals. -->
                            <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource LineIcon}" Data="{StaticResource VisualsScreenIcon}"
                                      Stroke="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Path Data="{StaticResource VisualsSparkIcon}" Fill="{DynamicResource AccentBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </Grid>
                            <Path DockPanel.Dock="Right" Style="{StaticResource LineIcon}" Data="{StaticResource ChevronUpIcon}"
                                  Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                            <TextBlock x:Name="PresetName" Text="Loading visuals…" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Next visual (N)" Click="OnNextPreset">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ArrowRightIcon}" />
                    </Button>

                    <!-- The visual picker: tag tick boxes on the left, the visuals (in family folders) on the right. -->
                    <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetPickerButton}"
                           Placement="Top" VerticalOffset="-10" HorizontalOffset="-156" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Closed="OnPresetPopupClosed">
                        <Border Margin="16" Width="500" Padding="6" CornerRadius="{DynamicResource CardCorner}"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                            </Border.Effect>
                            <Border.Resources>
                                <!-- A tag's tick box: a small rounded box that fills with the accent colour when ticked. -->
                                <Style x:Key="TagCheck" TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="Row" Padding="6,5" Margin="0,1" CornerRadius="{DynamicResource TinyCorner}" Background="Transparent">
                                                    <DockPanel>
                                                        <Border x:Name="Box" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0"
                                                                CornerRadius="4" BorderThickness="1.2" VerticalAlignment="Center"
                                                                BorderBrush="{DynamicResource FaintTextBrush}" Background="Transparent">
                                                            <Path x:Name="Tick" Data="{StaticResource CheckIcon}" Width="8" Height="7" Stretch="Uniform"
                                                                  Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  Visibility="Hidden" />
                                                        </Border>
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="420" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Search, then which visuals to show (and for Auto to play from): all, the favourites, or one of your lists. -->
                                <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="4,4,4,2">
                                    <Button x:Name="ListPickerButton" DockPanel.Dock="Right" Style="{StaticResource PickerButton}"
                                            Height="28" Padding="10,0" ToolTip="Show all visuals, your favourites or one of your lists"
                                            Click="OnListMenu">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ListPickerLabel" Text="All visuals" FontSize="12" MaxWidth="130"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                                                  Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <!-- Family folders on or off. -->
                                    <Button x:Name="GroupFamiliesButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="0,0,6,0"
                                            Content="FOLDERS" ToolTip="Show or hide the family folders" Click="OnToggleGroupFamilies" />
                                    <!-- Search: shows only the visuals with every typed word in their name, family or tags.
                                         (No right-click menu: opening one would close the picker. Ctrl+V still pastes.) -->
                                    <Grid Margin="0,0,8,0">
                                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" Tag="Search by name, family or tag"
                                                 ToolTip="Type to find visuals by name, family or tag. Enter shows the first one, Esc clears the search."
                                                 ContextMenuService.IsEnabled="False"
                                                 TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                                        <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed"
                                                ToolTip="Clear the search (Esc)" Click="OnClearSearch">
                                            <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                                        </Button>
                                    </Grid>
                                </DockPanel>
                                <TextBlock x:Name="ListHint" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource OptionHint}"
                                           Margin="12,4,12,6" Visibility="Collapsed" />

                                <!-- Tags: tick some to show only the visuals with any of them. -->
                                <Border Grid.Row="2" Grid.Column="0" Margin="0,4,6,0" Padding="0,0,6,0"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="6,2,0,4" Height="24">
                                            <Button x:Name="ClearTagsButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" Height="22"
                                                    Padding="8,0" Content="CLEAR" Visibility="Collapsed"
                                                    ToolTip="Untick every tag and show all the visuals again" Click="OnClearTags" />
                                            <TextBlock Text="TAGS" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </DockPanel>
                                        <TextBlock x:Name="TagHint" DockPanel.Dock="Bottom" Style="{StaticResource OptionHint}" Margin="6,8,0,4"
                                                   Text="Tick tags to show only the visuals with any of them." />
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="TagList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox x:Name="TagBox" Style="{StaticResource TagCheck}" IsChecked="{Binding IsChecked}"
                                                                  Click="OnTagClick">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="11" Margin="8,0,2,0"
                                                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </CheckBox>
                                                        <DataTemplate.Triggers>
                                                            <!-- None of the visuals in the chosen list have this tag. -->
                                                            <DataTrigger Binding="{Binding Count}" Value="0">
                                                                <Setter TargetName="TagBox" Property="Opacity" Value="0.45" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <ListBox x:Name="PresetList" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         PreviewMouseLeftButtonUp="OnPresetListClick"
                                         KeyDown="OnPresetListKeyDown"
                                         ContextMenuOpening="OnPresetListMenu">
                                    <ListBox.ContextMenu>
                                        <ContextMenu />
                                    </ListBox.ContextMenu>
                                    <!-- Family folders: open or close them; they stay that way next time. -->
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.ContainerStyle>
                                                <Style TargetType="GroupItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="GroupItem">
                                                                <Expander Style="{StaticResource FolderExpander}" IsExpanded="True"
                                                                          Loaded="OnFamilyFolderLoaded"
                                                                          Expanded="OnFamilyFolderExpanded"
                                                                          Collapsed="OnFamilyFolderCollapsed">
                                                                    <Expander.Header>
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11"
                                                                                       Margin="8,0,2,0" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource FaintTextBrush}" />
                                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                                        </DockPanel>
                                                                    </Expander.Header>
                                                                    <ItemsPresenter />
                                                                </Expander>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel ToolTip="{Binding StyleText}">
                                                <!-- Star: click to make it a favourite. -->
                                                <Button x:Name="Star" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                        Margin="6,-4,-4,-4" ToolTip="Favourite" Click="OnStarClick">
                                                    <Path x:Name="StarShape" Data="{StaticResource StarIcon}" Stroke="{DynamicResource FaintTextBrush}"
                                                          StrokeThickness="1.2" StrokeLineJoin="Round" Fill="Transparent"
                                                          Width="12" Height="12" Stretch="Uniform" />
                                                </Button>
                                                <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter TargetName="StarShape" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="StarShape" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="Star" Property="ToolTip" Value="Remove from favourites" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="FavoriteButton" Style="{StaticResource PanelToggle}" Padding="8,0"
                                  ToolTip="Make this visual a favourite (F)" Click="OnToggleFavorite">
                        <Path x:Name="FavoriteIcon" Data="{StaticResource StarIcon}" StrokeThickness="1.3" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                    </ToggleButton>
                    <!-- Auto mode: the pill turns it on or off (right-click it, or use the arrow, to choose how often it changes). -->
                    <Button x:Name="AutoCycleButton" Style="{StaticResource PillButton}" Content="AUTO · 25s"
                            Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}"
                            Click="OnToggleAutoCycle" MouseRightButtonUp="OnAutoCycleRightClick" />
                    <Button x:Name="AutoCycleIntervalButton" Style="{StaticResource IconButton}" Width="22" Height="26"
                            Margin="1,0,6,0" ToolTip="How often Auto changes the visual" Click="OnAutoCycleIntervalMenu">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronUpIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32"
                            ToolTip="Fullscreen visuals (F11, Esc to exit)" Click="OnToggleFullscreen">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource FullscreenIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</local:ToolWindow>
