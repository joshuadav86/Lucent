<Window x:Class="WinampInspiredVisualizer.TrackInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit info - Lucent"
        Icon="Assets/Lucent.ico"
        Width="900" Height="660" MinWidth="740" MinHeight="560"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnWindowStateChanged"
        Closing="OnClosing"
        Closed="OnClosed">

    <!-- Same custom chrome as the main window: our own title bar, native resizing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The small label above each box. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>

        <!-- A text box in the theme's colours. Its Tag is shown faintly while it's empty,
             for "(several values)" when the chosen tracks differ. -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource SegmentCorner}" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <TextBlock x:Name="Hint" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{TemplateBinding FontSize}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource FaintTextBrush}" IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LongFieldBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,7" />
        </Style>

        <!-- The main button: Save. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AccentGradientBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The artwork buttons: pills that fade when they can't be used. -->
        <Style x:Key="ArtworkButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A small picture in the row of a file's pictures, ringed when chosen. -->
        <Style x:Key="PictureThumb" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" Margin="0,0,6,6" Padding="2" CornerRadius="{DynamicResource ControlCorner}" BorderThickness="2"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FaintTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource CloseCaptionButton}"
                    ToolTip="Close (Esc)" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseWindow">
                <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
            </Button>
            <TextBlock DockPanel.Dock="Left" Text="Edit info" Margin="24,0,0,0" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="SubtitleText" Margin="12,1,12,0" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
        </DockPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="24,6,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Artwork: the chosen picture big, the file's other pictures below, and what can be done with them. -->
            <StackPanel Grid.Column="0">
                <Border x:Name="ArtworkFrame" Width="264" Height="264" CornerRadius="{DynamicResource CardCorner}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="1" AllowDrop="True"
                        DragEnter="OnArtworkDragOver" DragOver="OnArtworkDragOver" DragLeave="OnArtworkDragLeave"
                        Drop="OnArtworkDrop">
                    <Grid>
                        <Image x:Name="ArtworkImage" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel x:Name="ArtworkEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Path Data="{StaticResource MusicIcon}" Fill="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ArtworkEmptyTitle" Text="No artwork" Margin="0,12,0,0" FontSize="13"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="ArtworkEmptyText" Margin="0,4,0,0" FontSize="11" MaxWidth="210"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource FaintTextBrush}"
                                       Text="Drop a picture here, or copy one and press Ctrl+V." />
                        </StackPanel>
                        <Border x:Name="DropHint" Visibility="Collapsed" CornerRadius="{DynamicResource CardCorner}" BorderThickness="2"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                Opacity="0.94" IsHitTestVisible="False">
                            <TextBlock Text="Drop to use as the cover" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="ArtworkInfo" Margin="2,10,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="ArtworkNote" Margin="2,3,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource FaintTextBrush}" />

                <ListBox x:Name="PictureList" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                         ItemContainerStyle="{StaticResource PictureThumb}" SelectionChanged="OnPictureSelected">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="46" Height="46" ToolTip="{Binding Label}">
                                <Border CornerRadius="5" Background="{DynamicResource SurfaceRaisedBrush}" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource ArtworkButton}" Content="Choose…" Click="OnChooseImage"
                            ToolTip="Pick a picture file to use as the front cover" />
                    <Button Style="{StaticResource ArtworkButton}" Content="Paste" Click="OnPasteImage"
                            ToolTip="Use a picture you've copied (Ctrl+V)" />
                    <Button x:Name="RemoveImageButton" Style="{StaticResource ArtworkButton}" Content="Remove"
                            Click="OnRemoveImage" ToolTip="Take this picture out of the file" />
                    <Button x:Name="SaveImageButton" Style="{StaticResource ArtworkButton}" Content="Save as…"
                            Click="OnSaveImage" ToolTip="Save this picture as an image file" />
                </WrapPanel>
            </StackPanel>

            <!-- Tags and file details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="InfoTab" Tag="Song" Content="Sound"
                                     MinWidth="86" IsChecked="True" Click="OnTab" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="InfoTab" Tag="Lyrics" Content="Lyrics"
                                     MinWidth="86" Click="OnTab" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="InfoTab" Tag="File" Content="File details"
                                     MinWidth="104" Click="OnTab" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SongTab" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
                            <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Artist" />
                            <TextBox x:Name="ArtistBox" Style="{StaticResource FieldBox}"
                                     ToolTip="Put a semicolon between names for more than one artist" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Album" />
                            <TextBox x:Name="AlbumBox" Style="{StaticResource FieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Album artist" />
                            <TextBox x:Name="AlbumArtistBox" Style="{StaticResource FieldBox}"
                                     ToolTip="Who the whole album is by, such as Various Artists for a compilation" />
                        </StackPanel>

                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Year" />
                                <TextBox x:Name="YearBox" Style="{StaticResource FieldBox}" Width="76" MaxLength="4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Track" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TrackBox" Style="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                    <TextBlock Text="of" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox x:Name="TrackCountBox" Style="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Disc" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="DiscBox" Style="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                    <TextBlock Text="of" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox x:Name="DiscCountBox" Style="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="BPM" />
                                <TextBox x:Name="BpmBox" Style="{StaticResource FieldBox}" Width="64" MaxLength="3"
                                         ToolTip="Beats per minute: how fast the sound is" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Key" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="KeyBox" Style="{StaticResource FieldBox}" Width="64" MaxLength="12"
                                             ToolTip="The musical key, like Am or F#, as DJ apps read it" />
                                    <Button x:Name="DetectButton" Style="{StaticResource PillButton}" Margin="8,0,0,0" Content="Detect"
                                            IsEnabled="False" Click="OnDetectTempoAndKey"
                                            ToolTip="Listen to the song and fill in its BPM and key (one track at a time)" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Genre" />
                            <DockPanel>
                                <Button x:Name="GenreButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Width="32" Height="32" Margin="4,0,0,0" ToolTip="Common genres" Click="OnGenreSuggestions">
                                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" />
                                </Button>
                                <TextBox x:Name="GenreBox" Style="{StaticResource FieldBox}" />
                            </DockPanel>
                            <Popup x:Name="GenrePopup" PlacementTarget="{Binding ElementName=GenreBox}" Placement="Bottom"
                                   VerticalOffset="-10" HorizontalOffset="-16" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="OnGenrePopupClosed">
                                <Border Margin="16" Width="380" Padding="12,12,6,6" CornerRadius="{DynamicResource CardCorner}"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="COMMON GENRES" Margin="2,0,0,10" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <WrapPanel x:Name="GenreChips" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Composer" />
                            <TextBox x:Name="ComposerBox" Style="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Comment" />
                            <TextBox x:Name="CommentBox" Style="{StaticResource LongFieldBox}" Height="76" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <DockPanel x:Name="LyricsTab" Grid.Row="1" Margin="0,16,10,0" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" Text="Lyrics" />
                    <TextBox x:Name="LyricsBox" Style="{StaticResource LongFieldBox}" Padding="10,8" />
                </DockPanel>

                <ScrollViewer x:Name="FileTab" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="2,0,10,0">
                        <!-- Rows are filled in from code: a label on the left, the value on the right. -->
                        <Grid x:Name="DetailsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock Margin="112,10,0,0" FontSize="12">
                            <Hyperlink x:Name="OpenFolderLink" Click="OnOpenFolder" TextDecorations="None"
                                       Foreground="{DynamicResource AccentBrush}">Show in File Explorer</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Files that couldn't be read or saved, and why. -->
        <Border x:Name="ProblemPanel" Grid.Row="2" Margin="24,0,24,14" Padding="14,10" CornerRadius="{DynamicResource PanelCorner}"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProblemTitle" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="110" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ProblemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Margin="0,2" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Footer: the date switch, messages, and the buttons. -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,12,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="264" VerticalAlignment="Center">
                    <CheckBox x:Name="KeepDatesSwitch" Style="{StaticResource SwitchToggle}" Content="Keep the files' dates"
                              IsChecked="True" />
                    <TextBlock x:Name="KeepDatesHint" Style="{StaticResource OptionHint}" Margin="2,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="28,0,16,0" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Style="{StaticResource PickerButton}" Height="34" Padding="18,0"
                            Click="OnCancel">
                        <TextBlock Text="Cancel" FontSize="13" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Content="Save"
                            ToolTip="Save the changes into the files (Ctrl+S)" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
