<Window x:Class="WinampInspiredVisualizer.RadioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Online radio - Lucent"
        Icon="Assets/Lucent.ico"
        Width="820" Height="600" MinWidth="620" MinHeight="380"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A row in the left column or the station list, as in the plugin browser. -->
        <Style x:Key="StationRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="{DynamicResource TinyCorner}" Padding="8,5" Margin="0,0,0,1"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2">
                <TextBlock Text="ONLINE RADIO" Margin="20,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseButton">
                    <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <!-- The search, and the sort and filters beside it. -->
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="14,0,14,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SortButton" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="OnSortMenu" />
                    <Button x:Name="QualityButton" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="OnQualityMenu" />
                    <Button x:Name="CountryButton" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="OnCountryMenu" />
                    <Button x:Name="VideoButton" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="OnVideoFilter" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" Tag="Search stations by name, genre, or country"
                             ToolTip="Type to find stations by name, genre, or country. Enter plays the first one, Down goes to the list, Esc clears the search."
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />
                    <Button x:Name="ClearSearchButton" Style="{StaticResource IconButton}" Width="22" Height="22"
                            HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed"
                            ToolTip="Clear the search (Esc)" Click="OnClearSearch">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </Grid>
            </DockPanel>

            <!-- Featured, favorites, recently played, every station, or one genre. -->
            <Border Grid.Row="2" Grid.Column="0" Margin="10,0,6,0" Padding="0,0,6,0"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Sections" />
                </ScrollViewer>
            </Border>

            <ScrollViewer x:Name="StationScroller" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="StationRows" Margin="0,0,4,0" />
            </ScrollViewer>

            <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="14,8,14,12">
                <TextBlock x:Name="StationCount" DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Content="PLAY AN ADDRESS…" Margin="0,0,10,0"
                        ToolTip="Play a station that isn't listed, from its stream's address (or its .pls, .m3u or .m3u8 link), audio or video"
                        Click="OnPlayAddress" />
                <TextBlock FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource FaintTextBrush}"
                           Text="Stations from radio-browser.info, a free directory kept up by its listeners."
                           ToolTip="Radio Browser lists about 50,000 stations. Lucent shows the ones that were on the air at its last check, and the camera marks the ones with video." />
            </DockPanel>
        </Grid>
    </Border>
</Window>
