<local:ToolWindow x:Class="WinampInspiredVisualizer.QueueWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:WinampInspiredVisualizer.Windows"
                  Title="Lucent queue"
                  Width="520" Height="320" MinWidth="300" MinHeight="160"
                  Background="{DynamicResource SurfaceBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <local:ToolWindow.Resources>
        <!-- In a classic skin: tight rows in the skin's colours and font, with no hover, as in Winamp's playlist. -->
        <Style x:Key="ClassicRowItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="3,0" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ClassicSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClassicRowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource ClassicFont}" />
            <Setter Property="FontSize" Value="{DynamicResource ClassicFontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ClassicTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ClassicCurrentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A classic skin's playlist row: "Artist - Title", and the length on the right. -->
        <DataTemplate x:Key="ClassicRow">
            <Grid Height="{DynamicResource ClassicRowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ClassicRowText}" Text="{Binding ClassicText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Style="{StaticResource ClassicRowText}" Text="{Binding Track.DurationText}" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>
    </local:ToolWindow.Resources>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Grid Margin="6,6,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,0,0,6" Height="34" Background="{DynamicResource TitleBarBrush}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Favourite songs and saved playlists: play them, or save the queue as one. -->
                    <Button x:Name="PlaylistsButton" Style="{StaticResource PickerButton}" Height="28" Padding="10,0" Margin="0,0,6,0"
                            ToolTip="Play your favorite sounds or a saved playlist, or save the queue as a playlist"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnPlaylistsMenu">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ListIcon}"
                                  Stroke="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Playlists" FontSize="12" VerticalAlignment="Center" />
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                                  Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" x:Name="AddFilesButton" Width="32" Height="32" ToolTip="Add files"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnAddFiles">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource AddIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" x:Name="AddFolderButton" Width="32" Height="32" ToolTip="Add a folder"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnAddFolder">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource FolderIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" x:Name="ClearQueueButton" Width="32" Height="32" ToolTip="Clear the queue"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClearQueue">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource ClearIcon}" />
                    </Button>
                    <local:LockButton Style="{StaticResource PanelToggle}" Padding="8,0" Margin="0,0,2,0" />
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Hide the queue (Q)"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnHideWindow">
                        <Path Style="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="QueueTitle" Text="QUEUE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="QueueCount" Text="Empty" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource FaintTextBrush}" />
                </StackPanel>
            </DockPanel>

            <ListBox x:Name="PlaylistView" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Extended"
                     MouseDoubleClick="OnPlaylistDoubleClick"
                     KeyDown="OnPlaylistKeyDown"
                     ContextMenuOpening="OnQueueMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="QueueMenu">
                        <MenuItem Header="Play" Click="OnPlaySelected" />
                        <MenuItem Header="Remove from the queue" InputGestureText="Del" Click="OnRemoveSelected" />
                        <Separator x:Name="SongMenuItemsStart" />
                        <MenuItem Header="Edit info…" InputGestureText="Ctrl+I" Click="OnEditInfo" />
                        <MenuItem x:Name="OpenInEditorItem" Header="Open in editor…" Click="OnOpenInEditor" />
                        <MenuItem Header="Convert to…" Click="OnConvert" />
                        <MenuItem Header="Show in File Explorer" Click="OnShowInExplorer" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="1.5" Margin="0,2,0,2"
                                    Background="{DynamicResource AccentGradientBrush}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenTrue}}" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                <TextBlock Text="{Binding Track.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Track.Artist}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Track.DurationText}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Another app's playlist (Spotify's), in place of the queue while Lucent controls that app. -->
            <ListBox x:Name="RemoteListView" Grid.Row="1" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     MouseDoubleClick="OnRemoteListDoubleClick"
                     KeyDown="OnRemoteListKeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="RemotePlayItem" Header="Play" Click="OnRemoteListPlay" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="1.5" Margin="0,2,0,2"
                                    Background="{DynamicResource AccentGradientBrush}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenTrue}}" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                <TextBlock Text="{Binding Track.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Track.Artist}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Track.DurationText}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="RemoteListNote" Grid.Row="2" Visibility="Collapsed" Margin="10,6,8,0" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />

            <StackPanel x:Name="EmptyPlaylistHint" Grid.Row="1" IsHitTestVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{StaticResource MusicIcon}" Fill="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Drop music here" Margin="0,12,0,0" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="MP3 · FLAC · WAV · M4A · ALAC · WMA · OGG · Opus · AIFF" Margin="0,4,0,0"
                           FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</local:ToolWindow>
