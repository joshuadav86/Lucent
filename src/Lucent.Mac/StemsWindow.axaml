<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="using:Lucent.Mac.Windows"
        x:Class="Lucent.Mac.StemsWindow"
        Title="Stems - Lucent"
        Width="760" Height="420" MinWidth="520" MinHeight="320"
        CanResize="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource SurfaceBrush}">

    <!-- Same custom title bar as the main window, with native resizing. -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1">
        <Grid Background="{DynamicResource PanelSheenBrush}" RowDefinitions="36,Auto,*,Auto">

            <DockPanel Grid.Row="0" Background="{DynamicResource TitleBarBrush}" w:Chrome.IsCaption="True">
                <Button DockPanel.Dock="Right" Theme="{StaticResource CloseCaptionButton}" Height="36" ToolTip.Tip="Close"
                        Click="OnCloseWindow">
                    <Path Theme="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image x:Name="TitleIcon" Width="14" Height="14" VerticalAlignment="Center"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="STEMS" Margin="9,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SongText" Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource FaintTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <!-- What did the splitting: the graphics card, or the processor and why. -->
            <TextBlock x:Name="NoteText" Grid.Row="1" Margin="12,6,12,4" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource FaintTextBrush}" />

            <!-- One row per stem: its name, mute and solo, and its waveform with the playhead. Click a waveform to play from there. -->
            <Grid x:Name="Rows" Grid.Row="2" Margin="10,4,10,0" />

            <DockPanel Grid.Row="3" Margin="10" LastChildFill="False">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Theme="{StaticResource PillButton}" Height="30" MinWidth="76"
                        Padding="12,0" Content="PLAY" ToolTip.Tip="Play or pause (Space)" Click="OnPlayPause" />
                <Button DockPanel.Dock="Left" Theme="{StaticResource PillButton}" Height="30" Padding="12,0" Margin="6,0,0,0"
                        Content="STOP" ToolTip.Tip="Stop and go back to the start" Click="OnStop" />
                <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button x:Name="KeepButton" DockPanel.Dock="Right" Theme="{StaticResource PillButton}" Height="30" Padding="12,0"
                        Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}" Click="OnKeep"
                        ToolTip.Tip="Keep only the stems you're hearing in the editor; the rest are taken out (⌘Z undoes it)" />
                <Button DockPanel.Dock="Right" Theme="{StaticResource PillButton}" Height="30" Padding="12,0"
                        Content="SAVE AS FILES…" Click="OnSave"
                        ToolTip.Tip="Save the vocals, drums, bass and other instruments as four files, in a folder next to the song" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
