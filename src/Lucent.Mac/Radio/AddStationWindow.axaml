<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="using:Lucent.Mac.Windows"
        x:Class="Lucent.Mac.AddStationWindow"
        Title="Lucent"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceRaisedBrush}">

    <!-- Asks for a station that isn't listed: its stream's address (or a .pls/.m3u file) and a name. -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1" w:Chrome.IsCaption="True"
            Background="{DynamicResource PanelSheenBrush}" Padding="18,16,18,16">
        <StackPanel>
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Add a station" />
            <TextBlock x:Name="Hint" Theme="{StaticResource OptionHint}" Margin="0,4,0,12" />

            <TextBlock Theme="{StaticResource OptionHint}" Text="Stream address" Margin="0,0,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Theme="{StaticResource PickerButton}" Content="File…" Height="30" Padding="12,0" Margin="8,0,0,0"
                        ToolTip.Tip="Read the address from a .pls or .m3u file the station's website gave you" Click="OnChooseFile" />
                <TextBox x:Name="Address" Theme="{StaticResource TextInput}" KeyDown="OnFieldKeyDown" />
            </DockPanel>

            <TextBlock Theme="{StaticResource OptionHint}" Text="Name (leave blank to use the name the stream gives itself)" Margin="0,12,0,4" />
            <TextBox x:Name="StationName" Theme="{StaticResource TextInput}" KeyDown="OnFieldKeyDown" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Theme="{StaticResource PickerButton}" Content="Cancel" Height="32" Padding="16,0" Click="OnCancel" />
                <Button Theme="{StaticResource PickerButton}" Content="Just play" Height="32" Padding="16,0" Margin="8,0,0,0"
                        ToolTip.Tip="Play it now. It's kept in Recent, where its star adds it to the favorites later." Click="OnPlay" />
                <Button Theme="{StaticResource PickerButton}" Content="Add to favorites" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" ToolTip.Tip="Keep it in Favorites and play it" Click="OnAddToFavorites" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
