<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="using:Lucent.Mac.Windows"
        x:Class="Lucent.Mac.TrackInfoWindow"
        Title="Edit info - Lucent"
        Width="900" Height="660" MinWidth="740" MinHeight="560"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- An amber for problems, picked in code to read well on the current theme. -->
        <SolidColorBrush x:Key="WarningBrush" Color="#F0A04B" />

        <!-- The small label above each box. -->
        <ControlTheme x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </ControlTheme>

        <!-- A text box in the theme's colours. Its Watermark is shown faintly while it's empty,
             for "(several values)" when the chosen tracks differ. The "warning" class marks a box
             whose value can't be saved. -->
        <ControlTheme x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource SegmentCorner}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style Selector="^ /template/ TextBlock#PART_Watermark">
                <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
                <Setter Property="Opacity" Value="1" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            </Style>
            <Style Selector="^.warning /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            </Style>
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Style>
            <Style Selector="^:pointerover, ^:focus">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Style Selector="^ /template/ Border#PART_BorderElement">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                </Style>
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="LongFieldBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,7" />
        </ControlTheme>

        <!-- The main button: Save. -->
        <ControlTheme x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chrome" CornerRadius="{DynamicResource ControlCorner}" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource AccentGradientBrush}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Chrome">
                <Setter Property="Opacity" Value="0.88" />
            </Style>
            <Style Selector="^:pressed /template/ Border#Chrome">
                <Setter Property="Opacity" Value="0.75" />
            </Style>
            <Style Selector="^:disabled /template/ Border#Chrome">
                <Setter Property="Opacity" Value="0.45" />
            </Style>
        </ControlTheme>

        <!-- The artwork buttons: pills that fade when they can't be used. -->
        <ControlTheme x:Key="ArtworkButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </ControlTheme>

        <!-- A small picture in the row of a file's pictures, ringed when chosen. -->
        <ControlTheme x:Key="PictureThumb" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Ring" Margin="0,0,6,6" Padding="2" CornerRadius="{DynamicResource ControlCorner}" BorderThickness="2"
                            BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Ring">
                <Setter Property="BorderBrush" Value="{DynamicResource FaintTextBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#Ring">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Style>
        </ControlTheme>

        <!-- "Show in Finder": a link in the accent colour. -->
        <ControlTheme x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Background="Transparent" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Opacity" Value="0.8" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- The app-wide list row look (padding, margins) doesn't apply to the picture thumbnails. -->
        <Style Selector="ListBox#PictureList ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TextBlock#StatusText">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock#StatusText.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="WindowRoot" RowDefinitions="52,*,Auto,Auto">

        <!-- Title bar -->
        <DockPanel Grid.Row="0" Background="Transparent" w:Chrome.IsCaption="True">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Theme="{StaticResource CloseCaptionButton}"
                    ToolTip.Tip="Close (Esc)" Click="OnCloseWindow">
                <Path Theme="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
            </Button>
            <TextBlock DockPanel.Dock="Left" Text="Edit info" Margin="24,0,0,0" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="SubtitleText" Margin="12,1,12,0" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
        </DockPanel>

        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="24,6,24,16" ColumnDefinitions="264,28,*">

            <!-- Artwork: the chosen picture big, the file's other pictures below, and what can be done with them. -->
            <StackPanel Grid.Column="0">
                <Border x:Name="ArtworkFrame" Width="264" Height="264" CornerRadius="{DynamicResource CardCorner}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="1" DragDrop.AllowDrop="True">
                    <Grid>
                        <Image x:Name="ArtworkImage" Margin="6" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <StackPanel x:Name="ArtworkEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Path Data="{StaticResource MusicIcon}" Fill="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ArtworkEmptyTitle" Text="No artwork" Margin="0,12,0,0" FontSize="13"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="ArtworkEmptyText" Margin="0,4,0,0" FontSize="12" MaxWidth="210"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Drop a picture here, or copy one and press ⌘V." />
                        </StackPanel>
                        <Border x:Name="DropHint" IsVisible="False" CornerRadius="{DynamicResource CardCorner}" BorderThickness="2"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                Opacity="0.94" IsHitTestVisible="False">
                            <TextBlock Text="Drop to use as the cover" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="ArtworkInfo" Margin="2,10,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="ArtworkNote" Margin="2,3,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <ListBox x:Name="PictureList" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsVisible="False"
                         ItemContainerTheme="{StaticResource PictureThumb}" SelectionChanged="OnPictureSelected">
                    <ListBox.Template>
                        <ControlTemplate>
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="46" Height="46" ToolTip.Tip="{Binding Label}">
                                <Border CornerRadius="5" Background="{DynamicResource SurfaceRaisedBrush}" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Margin="0,10,0,0">
                    <Button Theme="{StaticResource ArtworkButton}" Content="Choose…" Click="OnChooseImage"
                            ToolTip.Tip="Pick a picture file to use as the front cover" />
                    <Button Theme="{StaticResource ArtworkButton}" Content="Paste" Click="OnPasteImage"
                            ToolTip.Tip="Use a picture you've copied (⌘V)" />
                    <Button x:Name="RemoveImageButton" Theme="{StaticResource ArtworkButton}" Content="Remove"
                            Click="OnRemoveImage" ToolTip.Tip="Take this picture out of the file" />
                    <Button x:Name="SaveImageButton" Theme="{StaticResource ArtworkButton}" Content="Save as…"
                            Click="OnSaveImage" ToolTip.Tip="Save this picture as an image file" />
                </WrapPanel>
            </StackPanel>

            <!-- Tags and file details -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">

                <Border Theme="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SongTabButton" Theme="{StaticResource SegmentButton}" GroupName="InfoTab" Tag="Song" Content="Sound"
                                     MinWidth="86" IsChecked="True" Click="OnTab" />
                        <RadioButton x:Name="LyricsTabButton" Theme="{StaticResource SegmentButton}" GroupName="InfoTab" Tag="Lyrics" Content="Lyrics"
                                     MinWidth="86" Click="OnTab" />
                        <RadioButton x:Name="FileTabButton" Theme="{StaticResource SegmentButton}" GroupName="InfoTab" Tag="File" Content="File details"
                                     MinWidth="104" Click="OnTab" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SongTab" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid Margin="0,0,10,0" ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Title" />
                            <TextBox x:Name="TitleBox" Theme="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,14">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Artist" />
                            <TextBox x:Name="ArtistBox" Theme="{StaticResource FieldBox}"
                                     ToolTip.Tip="Put a semicolon between names for more than one artist" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Album" />
                            <TextBox x:Name="AlbumBox" Theme="{StaticResource FieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Album artist" />
                            <TextBox x:Name="AlbumArtistBox" Theme="{StaticResource FieldBox}"
                                     ToolTip.Tip="Who the whole album is by, such as Various Artists for a compilation" />
                        </StackPanel>

                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Theme="{StaticResource FieldLabel}" Text="Year" />
                                <TextBox x:Name="YearBox" Theme="{StaticResource FieldBox}" Width="76" MaxLength="4" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Theme="{StaticResource FieldLabel}" Text="Track" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TrackBox" Theme="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                    <TextBlock Text="of" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox x:Name="TrackCountBox" Theme="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Theme="{StaticResource FieldLabel}" Text="Disc" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="DiscBox" Theme="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                    <TextBlock Text="of" Margin="8,0" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox x:Name="DiscCountBox" Theme="{StaticResource FieldBox}" Width="54" MaxLength="4" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,6">
                                <TextBlock Theme="{StaticResource FieldLabel}" Text="BPM" />
                                <TextBox x:Name="BpmBox" Theme="{StaticResource FieldBox}" Width="64" MaxLength="3"
                                         ToolTip.Tip="Beats per minute: how fast the sound is" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Theme="{StaticResource FieldLabel}" Text="Key" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="KeyBox" Theme="{StaticResource FieldBox}" Width="64" MaxLength="12"
                                             ToolTip.Tip="The musical key, like Am or F#, as DJ apps read it" />
                                    <Button x:Name="DetectButton" Theme="{StaticResource PillButton}" Margin="8,0,0,0" Content="Detect"
                                            IsEnabled="False" Click="OnDetectTempoAndKey"
                                            ToolTip.Tip="Listen to the song and fill in its BPM and key (one track at a time)" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Genre" />
                            <DockPanel>
                                <Button x:Name="GenreButton" DockPanel.Dock="Right" Theme="{StaticResource IconButton}"
                                        Width="32" Height="32" Margin="4,0,0,0" ToolTip.Tip="Common genres" Click="OnGenreSuggestions">
                                    <Path Theme="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}" />
                                </Button>
                                <TextBox x:Name="GenreBox" Theme="{StaticResource FieldBox}" />
                            </DockPanel>
                            <Popup x:Name="GenrePopup" PlacementTarget="{Binding #GenreBox}" Placement="BottomEdgeAlignedLeft"
                                   VerticalOffset="-10" HorizontalOffset="-16" IsLightDismissEnabled="True"
                                   Opened="OnGenrePopupOpened" Closed="OnGenrePopupClosed">
                                <Border x:Name="GenrePanel" Margin="16" Width="380" Padding="12,12,6,6" CornerRadius="{DynamicResource CardCorner}"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                        BoxShadow="0 0 24 0 #99000000">
                                    <StackPanel>
                                        <TextBlock Text="COMMON GENRES" Margin="2,0,0,10" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <WrapPanel x:Name="GenreChips" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,14">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Composer" />
                            <TextBox x:Name="ComposerBox" Theme="{StaticResource FieldBox}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                            <TextBlock Theme="{StaticResource FieldLabel}" Text="Comment" />
                            <TextBox x:Name="CommentBox" Theme="{StaticResource LongFieldBox}" Height="76" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <DockPanel x:Name="LyricsTab" Grid.Row="1" Margin="0,16,10,0" IsVisible="False">
                    <TextBlock DockPanel.Dock="Top" Theme="{StaticResource FieldLabel}" Text="Lyrics" />
                    <TextBox x:Name="LyricsBox" Theme="{StaticResource LongFieldBox}" Padding="10,8" />
                </DockPanel>

                <ScrollViewer x:Name="FileTab" Grid.Row="1" Margin="0,16,0,0" IsVisible="False"
                              VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="2,0,10,0">
                        <!-- Rows are filled in from code: a label on the left, the value on the right. -->
                        <Grid x:Name="DetailsGrid" ColumnDefinitions="112,*" />
                        <Button x:Name="OpenFolderLink" Theme="{StaticResource LinkButton}" Margin="112,10,0,0"
                                HorizontalAlignment="Left" Content="Show in Finder" Click="OnOpenFolder" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Files that couldn't be read or saved, and why. -->
        <Border x:Name="ProblemPanel" Grid.Row="2" Margin="24,0,24,14" Padding="14,10" CornerRadius="{DynamicResource PanelCorner}"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1" IsVisible="False">
            <StackPanel>
                <TextBlock x:Name="ProblemTitle" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}" />
                <ScrollViewer MaxHeight="110" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ProblemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Margin="0,2" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Footer: the date switch, messages, and the buttons. -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,12,24,14" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Width="264" VerticalAlignment="Center">
                    <CheckBox x:Name="KeepDatesSwitch" Theme="{StaticResource SwitchToggle}" Content="Keep the files' dates"
                              IsChecked="True" />
                    <TextBlock x:Name="KeepDatesHint" Theme="{StaticResource OptionHint}" Margin="2,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="28,0,16,0" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Theme="{StaticResource PickerButton}" Height="34" Padding="18,0"
                            Click="OnCancel">
                        <TextBlock Text="Cancel" FontSize="13" />
                    </Button>
                    <Button x:Name="SaveButton" Theme="{StaticResource AccentButton}" Margin="10,0,0,0" Content="Save"
                            ToolTip.Tip="Save the changes into the files (⌘S)" Click="OnSave" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
