<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="using:Lucent.Mac.Windows"
        xmlns:core="using:Lucent.Library"
        x:Class="Lucent.Mac.DuplicatesWindow"
        Title="Duplicates"
        Width="560" Height="560" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">

    <!-- Songs that are in the library more than once, each with its copies: the best one unticked, the rest
         ticked to go to the Trash. -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Border.Resources>
            <!-- A tick box beside each copy, like the visual picker's tag ticks. -->
            <ControlTheme x:Key="CopyCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Name="Row" Padding="8,6" Margin="0,1" CornerRadius="{DynamicResource TinyCorner}" Background="Transparent">
                            <DockPanel>
                                <Border Name="Box" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0"
                                        CornerRadius="4" BorderThickness="1.2" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource FaintTextBrush}" Background="Transparent">
                                    <Path Name="Tick" Data="{StaticResource CheckIcon}" Width="8" Height="7" Stretch="Uniform"
                                          Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6"
                                          StrokeLineCap="Round" StrokeJoin="Round" Opacity="0" />
                                </Border>
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
                <Style Selector="^:pointerover /template/ Border#Row">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Style>
                <Style Selector="^:pointerover /template/ Border#Box">
                    <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
                </Style>
                <Style Selector="^:checked /template/ Border#Box">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Style>
                <Style Selector="^:checked /template/ Path#Tick">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </ControlTheme>
        </Border.Resources>

        <Grid Margin="6,6,4,10" RowDefinitions="Auto,Auto,*,Auto">
            <DockPanel Grid.Row="0" Margin="8,0,0,6" Height="34" Background="{DynamicResource TitleBarBrush}"
                       w:Chrome.IsCaption="True">
                <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="32" Height="32"
                        ToolTip.Tip="Close" Click="OnClose">
                    <Path Theme="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DUPLICATES" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="CountText" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource FaintTextBrush}" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="10,0,10,10" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupList" Margin="2,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:DuplicateGroup">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Heading}" Margin="8,0,8,2" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:DuplicateCopy">
                                            <CheckBox Theme="{StaticResource CopyCheck}" IsChecked="{Binding Remove}"
                                                      ToolTip.Tip="{Binding Item.Path}" DoubleTapped="OnCopyDoubleClick">
                                                <CheckBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Play" Click="OnPlayCopy" />
                                                        <MenuItem Header="Show in Finder" Click="OnShowCopy" />
                                                    </ContextMenu>
                                                </CheckBox.ContextMenu>
                                                <DockPanel>
                                                    <!-- The copy suggested for keeping. -->
                                                    <TextBlock DockPanel.Dock="Right" Text="BEST COPY" FontSize="10"
                                                               FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsBest}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding Location}" FontSize="11" Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FaintTextBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="10,10,6,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Theme="{StaticResource PickerButton}" Content="Close" Height="32" Padding="16,0" Click="OnClose" />
                <Button x:Name="RemoveButton" Theme="{StaticResource PickerButton}" Height="32" Padding="16,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnRemove" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
