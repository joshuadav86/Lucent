<w:ToolWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="using:Lucent.Mac.Windows"
              xmlns:lib="using:Lucent.Mac.Library"
              xmlns:core="using:Lucent.Library"
              xmlns:st="using:Lucent.Streaming"
              x:Class="Lucent.Mac.LibraryWindow"
              Title="Lucent library"
              Width="380" Height="560" MinWidth="280" MinHeight="200"
              Background="{DynamicResource SurfaceBrush}">

    <w:ToolWindow.Styles>
        <!-- Folder headings are rows of the list too (Avalonia's ListBox has no groups), but they look like
             WPF's group headings: no row padding, hover or selection fill of their own. -->
        <Style Selector="ListBoxItem.heading">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ListBoxItem.heading /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.heading:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.heading:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Tag columns: numbers and dates line up on the right. -->
        <Style Selector="TextBlock.cell.right">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- With tag columns, a divider line before the song's time too. -->
        <Style Selector="Border.divided">
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <!-- The search box's hint is faint, as on Windows. -->
        <Style Selector="TextBox#SearchBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </w:ToolWindow.Styles>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <Grid Margin="6,6,4,8" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- The title bar: it moves the window, as WindowChrome's caption does on Windows. -->
            <DockPanel Grid.Row="0" Margin="8,0,0,6" Height="34" Background="{DynamicResource TitleBarBrush}"
                       w:Chrome.IsCaption="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Theme="{StaticResource IconButton}" Width="32" Height="32" ToolTip.Tip="Play the whole library in this order"
                            Click="OnPlayLibrary">
                        <Path Theme="{StaticResource SolidIcon}" Data="{StaticResource PlaySmallIcon}" />
                    </Button>
                    <Button Theme="{StaticResource IconButton}" Width="32" Height="32" ToolTip.Tip="Look for new music now" Click="OnRefreshLibrary">
                        <Path Theme="{StaticResource LineIcon}" Data="{StaticResource RefreshIcon}" />
                    </Button>
                    <Button x:Name="LibraryFoldersButton" Theme="{StaticResource IconButton}" Width="32" Height="32"
                            ToolTip.Tip="Choose which folders are in the library" Click="OnLibraryFolders">
                        <Path Theme="{StaticResource LineIcon}" Data="{StaticResource FolderIcon}" />
                    </Button>
                    <w:LockButton Theme="{StaticResource PanelToggle}" Padding="8,0" Margin="0,0,2,0" />
                    <Button Theme="{StaticResource IconButton}" Width="32" Height="32" ToolTip.Tip="Hide the library (L)" Click="OnHideWindow">
                        <Path Theme="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LIBRARY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="LibraryCount" Text="No folder linked" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                </StackPanel>
            </DockPanel>

            <!-- Search: narrows the list to the songs with every typed word in their title, artist, album, album artist, genre, composer or file name. -->
            <Grid x:Name="SearchRow" Grid.Row="1" Margin="8,0,4,8">
                <TextBox x:Name="SearchBox" Theme="{StaticResource SearchInput}" Watermark="Search sounds, artists, and albums"
                         ToolTip.Tip="Find sounds by title, artist, album, genre, composer, or file name (⌘F). Esc clears it."
                         TextChanged="OnSearchChanged" />
                <Button x:Name="ClearSearchButton" Theme="{StaticResource IconButton}" Width="22" Height="22"
                        HorizontalAlignment="Right" Margin="0,0,3,0" IsVisible="False"
                        ToolTip.Tip="Clear the search (Esc)" Click="OnClearSearch">
                    <Path Theme="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <DockPanel x:Name="FilterRow" Grid.Row="2" Margin="8,0,4,8">
                <!-- Closes every folder heading at once, or opens them all again when they're all closed. -->
                <Button x:Name="FoldAllButton" DockPanel.Dock="Right" Theme="{StaticResource IconButton}" Width="26" Height="26"
                        Margin="2,0,0,0" ToolTip.Tip="Close every folder" Click="OnFoldAllFolders">
                    <Path x:Name="FoldAllIcon" Theme="{StaticResource LineIcon}" Data="{StaticResource CollapseAllIcon}" />
                </Button>
                <Button x:Name="GroupFoldersButton" DockPanel.Dock="Right" Theme="{StaticResource PillButton}"
                        Content="FOLDERS" ToolTip.Tip="Headings by folder, artist, or album, or none" Click="OnToggleGroupFolders" />
                <Button x:Name="PlaylistsButton" DockPanel.Dock="Right" Theme="{StaticResource PillButton}" Margin="0,0,6,0"
                        Content="PLAYLISTS" ToolTip.Tip="Show your saved playlists, or go back to your library folders" Click="OnTogglePlaylists" />
                <Button x:Name="FavoritesOnlyButton" DockPanel.Dock="Right" Theme="{StaticResource PillButton}" Margin="0,0,6,0"
                        Content="FAVORITES" ToolTip.Tip="Show only your favorite sounds, or everything" Click="OnToggleFavoritesOnly" />
                <Button x:Name="SortButton" Theme="{StaticResource PickerButton}" Height="28" Padding="10,0"
                        HorizontalAlignment="Left" ToolTip.Tip="Change the order" Click="OnSortMenu">
                    <!-- A DockPanel, so the label shortens with an ellipsis when the window is narrow. -->
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Theme="{StaticResource LineIcon}" Data="{StaticResource SortIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                        <Path DockPanel.Dock="Right" Theme="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                        <TextBlock x:Name="SortLabel" Text="Newest first" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
            </DockPanel>

            <!-- The tag columns' headings, when any are shown (LibraryWindow.Columns.cs): a click sorts by one and
                 another flips it, a drag moves one, and a right-click chooses them. They line up with the rows'
                 cells: the rows' padding (12) and cover (36 + 2 + 10) on the left, and the padding on the right
                 (the scroll bar floats over the list). -->
            <Grid x:Name="ColumnHeader" Grid.Row="3" Margin="60,0,12,2" IsVisible="False" Background="Transparent"
                  ColumnDefinitions="*,Auto,45" ContextRequested="OnColumnHeaderMenuOpening">
                <TextBlock x:Name="TitleHeading" Grid.Column="0" Text="Title" FontSize="11" Cursor="Hand"
                           ToolTip.Tip="Sort by title" PointerReleased="OnTitleHeadingClick" />
                <StackPanel x:Name="ColumnHeadings" Grid.Column="1" Orientation="Horizontal" />
                <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource HairlineBrush}">
                    <TextBlock x:Name="LengthHeading" Text="Length" FontSize="11" Cursor="Hand" TextAlignment="Right"
                               ToolTip.Tip="Sort by length" PointerReleased="OnLengthHeadingClick" />
                </Border>
            </Grid>

            <ListBox x:Name="LibraryView" Grid.Row="4" Background="Transparent" BorderThickness="0"
                     Focusable="True" FocusAdorner="{x:Null}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Multiple"
                     DoubleTapped="OnLibraryDoubleClick"
                     KeyDown="OnLibraryKeyDown"
                     SelectionChanged="OnLibrarySelectionChanged">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="LibraryMenu">
                        <MenuItem Header="Play now" Click="OnLibraryPlayNow" />
                        <MenuItem Header="Add to queue" Click="OnLibraryAddToQueue" />
                        <MenuItem x:Name="PlayFolderItem" Header="Play this folder" Click="OnLibraryPlayFolder" />
                        <Separator x:Name="SongMenuItemsStart" />
                        <MenuItem Header="Edit info…" InputGesture="Cmd+I" Click="OnLibraryEditInfo" />
                        <MenuItem x:Name="OpenInEditorItem" Header="Open in editor…" Click="OnLibraryOpenInEditor" />
                        <MenuItem Header="Convert to…" Click="OnLibraryConvert" />
                        <MenuItem Header="Show in Finder" Click="OnLibraryShowInExplorer" />
                        <Separator />
                        <MenuItem Header="Find duplicates…" Click="OnFindDuplicates" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.DataTemplates>
                    <!-- A folder heading: a chevron, the folder's name and how many sounds are in it. -->
                    <DataTemplate DataType="lib:FolderHeading" x:CompileBindings="True">
                        <Expander Theme="{StaticResource FolderExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                  Classes.highlighted="{Binding IsHighlighted}" HorizontalAlignment="Stretch"
                                  Margin="{Binding Indent}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" FontSize="11"
                                               Margin="8,0,2,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FaintTextBrush}" />
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="{Binding LabelWeight}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </DockPanel>
                            </Expander.Header>
                        </Expander>
                    </DataTemplate>
                    <DataTemplate DataType="core:LibraryItem" x:CompileBindings="True">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- The song playing: a bar at the row's edge, as in a streaming playlist. -->
                            <Border Grid.Column="0" Width="3" Margin="-9,2,0,2" HorizontalAlignment="Left" CornerRadius="1.5"
                                    Background="{DynamicResource AccentGradientBrush}" IsVisible="{Binding IsCurrent}" />
                            <!-- An empty playlist's stand-in row is just words, with no cover. -->
                            <w:TrackThumb Margin="2,0,0,0" Path="{Binding Path}" IsVisible="{Binding ShowsCover}" />
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Details}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <!-- The tag columns chosen for the library, if any, each as wide as its heading. Each has a divider
                                 line on its left that runs through the row's padding (8) and margin (1), so the lines join up
                                 from row to row. -->
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}" Margin="0,-9" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:LibraryCell">
                                        <Border Width="{Binding Width}" Padding="8,0" BorderThickness="1,0,0,0"
                                                BorderBrush="{DynamicResource HairlineBrush}">
                                            <TextBlock Classes="cell" Classes.right="{Binding AlignRight}" Text="{Binding Text}"
                                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Grid.Column="3" Margin="0,-9" Classes.divided="{Binding HasCells}"
                                    BorderBrush="{DynamicResource HairlineBrush}">
                                <TextBlock Text="{Binding DurationText}" FontSize="11" MinWidth="44" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <StackPanel x:Name="EmptyLibraryHint" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{StaticResource MusicIcon}" Fill="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyLibraryTitle" Text="Link a music folder" Margin="0,12,0,0" FontSize="13"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="EmptyLibraryText" Margin="0,4,0,0" FontSize="12" MaxWidth="220"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                           Text="Every sound inside it shows up here, newest first, and new files appear on their own." />
                <Button x:Name="LinkFolderButton" Theme="{StaticResource PickerButton}" Margin="0,14,0,0" HorizontalAlignment="Center"
                        Click="OnLinkLibraryFolder">
                    <TextBlock Text="Choose a folder" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- A streaming playlist opened from PLAYLISTS: its songs, in place of the list, without playing anything.
                 Double-clicking a song plays it in the app, carrying on through the playlist. -->
            <DockPanel x:Name="RemotePlaylistPanel" Grid.Row="1" Grid.RowSpan="4" IsVisible="False">
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                    <Button DockPanel.Dock="Left" Theme="{StaticResource IconButton}" Width="32" Height="32"
                            ToolTip.Tip="Back to your playlists (Esc)" Click="OnCloseRemotePlaylist">
                        <Path Theme="{StaticResource LineIcon}" Data="{StaticResource ArrowLeftIcon}" />
                    </Button>
                    <Button x:Name="PlayRemotePlaylistButton" DockPanel.Dock="Right" Theme="{StaticResource IconButton}"
                            Width="32" Height="32" Click="OnPlayRemotePlaylist">
                        <Path Theme="{StaticResource SolidIcon}" Data="{StaticResource PlaySmallIcon}" />
                    </Button>
                    <StackPanel Margin="6,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RemotePlaylistName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="RemotePlaylistDetails" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </DockPanel>
                <!-- How the songs are listed: the playlist's own order, by date added, title or artist, as in the queue. -->
                <Button x:Name="RemoteSortButton" DockPanel.Dock="Top" Theme="{StaticResource PickerButton}" Height="28" Padding="10,0"
                        Margin="8,0,4,8" HorizontalAlignment="Left" IsVisible="False"
                        ToolTip.Tip="List the playlist in its own order, by date added, by title or by artist. It still plays in its own order."
                        Click="OnRemoteSortMenu">
                    <StackPanel Orientation="Horizontal">
                        <Path Theme="{StaticResource LineIcon}" Data="{StaticResource SortIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="RemoteSortLabel" Text="Playlist order" FontSize="12" VerticalAlignment="Center" />
                        <Path Theme="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="RemotePlaylistNote" DockPanel.Dock="Bottom" IsVisible="False" Margin="10,6,8,0" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                <ListBox x:Name="RemotePlaylistView" Background="Transparent" BorderThickness="0"
                         Focusable="True" FocusAdorner="{x:Null}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single"
                         DoubleTapped="OnRemotePlaylistDoubleClick"
                         KeyDown="OnRemotePlaylistKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RemoteSongPlayItem" Header="Play" Click="OnRemotePlaylistPlaySong" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="st:RemoteListEntry">
                            <Grid ColumnDefinitions="3,Auto,*,Auto">
                                <Border Grid.Column="0" CornerRadius="1.5" Margin="0,2,0,2"
                                        Background="{DynamicResource AccentGradientBrush}"
                                        IsVisible="{Binding IsCurrent}" />
                                <w:TrackThumb Grid.Column="1" Margin="8,0,0,0" Url="{Binding Track.ListArtUrl}" />
                                <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Track.Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Track.Artist}" FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Track.DurationText}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Border>
</w:ToolWindow>
