<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lucent for macOS: an Avalonia window, the visuals drawn with Metal, and playback through Core
    Audio. It shares Lucent.Core with the Windows app. The visuals' Metal shaders are made from the
    same HLSL files by tools/MetalShaders (it needs DXC, so it runs on Windows or Linux); point
    MetalShadersFolder at its output, or put it in artifacts/metal-shaders.
    The audio editor's native helpers are built on a Mac into artifacts/mac-native (or MacNativeFolder):
    libmp3lame.dylib (MP3 saving, tools/build-lame-mac.sh) and LucentPluginHost (VST3 plugins,
    tools/build-pluginhost-mac.sh). Without them the app still builds and runs, minus those two features.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Lucent</AssemblyName>
    <Product>Lucent</Product>
    <RootNamespace>Lucent.Mac</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <MetalShadersFolder Condition="'$(MetalShadersFolder)' == ''">$(MSBuildThisFileDirectory)../../artifacts/metal-shaders</MetalShadersFolder>
    <!-- DXC's library for macOS (libdxcompiler.dylib, built in CI), which translates the user's own visuals as the app runs. -->
    <DxcLibraryFolder Condition="'$(DxcLibraryFolder)' == ''">$(MSBuildThisFileDirectory)../../artifacts/dxc-mac</DxcLibraryFolder>
    <MacNativeFolder Condition="'$(MacNativeFolder)' == ''">$(MSBuildThisFileDirectory)../../artifacts/mac-native</MacNativeFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SharpMetal" Version="1.1.0" />
    <!-- ONNX Runtime's native library (with Core ML, for the graphics card), for the editor's stem splitter. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
    <!-- In-app updates, the same version as the Windows app's. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- SPIRV-Cross, for translating the user's own visuals to Metal as the app runs (with DXC, below). -->
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <!-- libVLC, VLC's engine, for playing videos (Lucent.Core's Video/VideoStream.cs): libvlc/osx-arm64 or osx-x64. -->
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucent.Core\Lucent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The visuals' HLSL files, for their names, families, tags and particle counts. -->
    <None Include="..\WinampInspiredVisualizer\Presets\*.hlsl" Link="Presets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The MilkDrop presets that come with Lucent, and the credits for them. -->
    <None Include="..\WinampInspiredVisualizer\Presets\MilkDrop\*.milk;..\WinampInspiredVisualizer\Presets\MilkDrop\CREDITS.md" Link="Presets\MilkDrop\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The Winamp AVS presets that come with Lucent, and the credits for them. -->
    <None Include="..\WinampInspiredVisualizer\Presets\AVS\*.avs;..\WinampInspiredVisualizer\Presets\AVS\CREDITS.md" Link="Presets\AVS\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The engine's HLSL, which the user's own visuals are assembled with before they're translated. -->
    <None Include="..\WinampInspiredVisualizer\Shaders\*.hlsl*" Link="Shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Their Metal translations, from tools/MetalShaders. -->
    <None Include="$(MetalShadersFolder)\**\*.metal" Link="Shaders\Metal\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\WinampInspiredVisualizer\Assets\Lucent-64.png" Link="Assets\Lucent-64.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The song a first start puts in the library (see StarterMusic). -->
    <None Include="..\WinampInspiredVisualizer\StarterMusic\*.mp3" Link="StarterMusic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The editor's native helpers, next to Lucent (Mp3Writer and PluginHost look for them there). -->
    <None Include="$(MacNativeFolder)\libmp3lame.dylib" Condition="Exists('$(MacNativeFolder)\libmp3lame.dylib')" Link="libmp3lame.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MacNativeFolder)\LucentPluginHost" Condition="Exists('$(MacNativeFolder)\LucentPluginHost')" Link="LucentPluginHost" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MacNativeFolder)/LICENSE-*.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- libVLC's and LibVLCSharp's licence (LGPL 2.1), and where their source is. -->
    <None Include="..\..\assets\licenses\LICENSE-libVLC.txt" Link="Licenses/LICENSE-libVLC.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The WavPack and Monkey's Audio decoders are ports of theirs (BSD licences). -->
    <None Include="..\..\assets\licenses\LICENSE-WavPack.txt" Link="Licenses/LICENSE-WavPack.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\licenses\LICENSE-MonkeysAudio.txt" Link="Licenses/LICENSE-MonkeysAudio.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DxcLibraryFolder)/libdxcompiler.dylib')">
    <None Include="$(DxcLibraryFolder)/libdxcompiler.dylib" Link="libdxcompiler.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(DxcLibraryFolder)/LICENSE-*.txt" Link="Licenses/DXC/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ONNX Runtime's package copies its Windows DLLs into every build that isn't 32-bit; a Mac has no use for them. -->
  <Target Name="LeaveOutOnnxRuntimeWindowsLibraries" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(Link)' == 'onnxruntime.dll' Or '%(Link)' == 'onnxruntime_providers_shared.dll'" />
    </ItemGroup>
  </Target>

  <!--
    libVLC's plugins that Lucent never uses, left out to keep the download smaller (as on Windows): streaming out,
    saving to files, and the web remote control. A Mac's plugins sit in one folder, named for what they are. Four are
    kept, which decode music only libVLC reads to a WAV for the editor (Lucent.Core's Audio/LibVlcAudioDecoder.cs).
  -->
  <Target Name="LeaveOutUnusedVlcPlugins" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Content.Link)', '^libvlc[\\/][^\\/]+[\\/]lib[\\/]vlc[\\/](plugins[\\/]lib(?!(access_output_file|stream_out_transcode|stream_out_standard|mux_wav)_plugin)(access_output|stream_out|mux)_|share[\\/]lua[\\/]http[\\/])'))" />
    </ItemGroup>
  </Target>

  <Target Name="WarnWithoutMetalShaders" BeforeTargets="Build" Condition="!Exists('$(MetalShadersFolder)')">
    <Warning Text="No Metal shaders in $(MetalShadersFolder), so the app will have no visuals. Make them with: dotnet run --project tools/MetalShaders -- src/WinampInspiredVisualizer artifacts/metal-shaders" />
  </Target>

</Project>
