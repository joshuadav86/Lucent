<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="using:Lucent.Mac.Windows"
        x:Class="Lucent.Mac.PromptWindow"
        Title="Lucent"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceRaisedBrush}">

    <!-- Asks for one line of text, e.g. a playlist's name. -->
    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1" w:Chrome.IsCaption="True"
            Background="{DynamicResource PanelSheenBrush}" Padding="18,16,18,16">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="Hint" Theme="{StaticResource OptionHint}" Margin="0,4,0,12" />
            <TextBox x:Name="Answer" Theme="{StaticResource TextInput}" KeyDown="OnAnswerKeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Theme="{StaticResource PickerButton}" Content="Cancel" Height="32" Padding="16,0" Click="OnCancel" />
                <Button x:Name="OkButton" Theme="{StaticResource PickerButton}" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
