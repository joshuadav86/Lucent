<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="using:Lucent.Mac.Windows"
        x:Class="Lucent.Mac.VideoExportWindow"
        Title="Record video - Lucent"
        Width="500" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- The same look as the converter's (ExportWindow.axaml). -->
        <ControlTheme x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="PART_Track" CornerRadius="2" Background="{DynamicResource HairlineBrush}" />
                        <Border Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentGradientBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowFrameBrush}" BorderThickness="1"
            Background="{DynamicResource PanelSheenBrush}">
        <StackPanel>
            <!-- Title bar -->
            <Grid Height="40" Background="Transparent" w:Chrome.IsCaption="True">
                <TextBlock Text="RECORD VIDEO" Margin="20,0,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <Button Theme="{StaticResource CloseCaptionButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip.Tip="Close" Click="OnCloseButton">
                    <Path Theme="{StaticResource CaptionIcon}" Data="{StaticResource CloseIcon}" />
                </Button>
            </Grid>

            <StackPanel x:Name="OptionsArea" Margin="20,0,20,0">
                <TextBlock x:Name="TrackText" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,0"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBlock Theme="{StaticResource OptionLabel}" Text="Visual" />
                <Button x:Name="VisualButton" Theme="{StaticResource PickerButton}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Click="OnChooseVisual">
                    <DockPanel>
                        <Path DockPanel.Dock="Right" Theme="{StaticResource LineIcon}" Data="{StaticResource ChevronDownIcon}"
                              Stroke="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" />
                        <TextBlock x:Name="VisualText" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <TextBlock x:Name="VisualHint" Theme="{StaticResource OptionHint}" />

                <TextBlock Theme="{StaticResource OptionLabel}" Text="Record" />
                <Border Theme="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton x:Name="WholeSong" Theme="{StaticResource SegmentButton}" GroupName="Part"
                                     Content="The whole song" Click="OnPartChosen" />
                        <RadioButton x:Name="PartOfSong" Theme="{StaticResource SegmentButton}" GroupName="Part"
                                     Content="Part of it" Click="OnPartChosen" />
                    </UniformGrid>
                </Border>
                <StackPanel x:Name="RangePanel">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="From" FontSize="12" Width="44" Margin="2,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="FromInput" Theme="{StaticResource TextInput}" Width="96" TextChanged="OnRangeChanged" />
                        <TextBlock Text="to" FontSize="12" Margin="14,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBox x:Name="ToInput" Theme="{StaticResource TextInput}" Width="96" HorizontalAlignment="Left"
                                 TextChanged="OnRangeChanged" />
                    </DockPanel>
                    <TextBlock x:Name="RangeHint" Theme="{StaticResource OptionHint}" />
                </StackPanel>

                <TextBlock Theme="{StaticResource OptionLabel}" Text="Size" />
                <Border Theme="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Size" Tag="1080" Content="1080p" Click="OnOptionChosen" />
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Size" Tag="1440" Content="1440p" Click="OnOptionChosen" />
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Size" Tag="2160" Content="4K" Click="OnOptionChosen" />
                    </UniformGrid>
                </Border>

                <TextBlock Theme="{StaticResource OptionLabel}" Text="Frame rate" />
                <Border Theme="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="FrameRate" Tag="30" Content="30 fps" Click="OnOptionChosen" />
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="FrameRate" Tag="60" Content="60 fps" Click="OnOptionChosen" />
                    </UniformGrid>
                </Border>

                <TextBlock Theme="{StaticResource OptionLabel}" Text="Quality" />
                <Border Theme="{StaticResource SegmentBar}">
                    <UniformGrid Rows="1">
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Quality" Tag="Good" Content="Good" Click="OnOptionChosen" />
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Quality" Tag="High" Content="High" Click="OnOptionChosen" />
                        <RadioButton Theme="{StaticResource SegmentButton}" GroupName="Quality" Tag="Best" Content="Best" Click="OnOptionChosen" />
                    </UniformGrid>
                </Border>
                <TextBlock x:Name="QualityHint" Theme="{StaticResource OptionHint}" />

                <TextBlock Theme="{StaticResource OptionLabel}" Text="Save as" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Theme="{StaticResource PillButton}" Content="CHANGE" Margin="10,0,0,0"
                            Click="OnChooseFile" />
                    <TextBlock x:Name="FileText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" />
                </DockPanel>
                <TextBlock Theme="{StaticResource OptionHint}"
                           Text="Drawn frame by frame with the detail and glow set in Options, so nothing is ever skipped: it can take more or less time than the song lasts. The visuals and music carry on as usual meanwhile." />
            </StackPanel>

            <!-- Progress and the result -->
            <StackPanel x:Name="ProgressArea" Margin="20,16,20,0" IsVisible="False">
                <ProgressBar x:Name="Progress" Theme="{StaticResource ThinProgress}" />
                <TextBlock x:Name="ProgressText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <DockPanel Margin="20,18,20,18" LastChildFill="False">
                <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Theme="{StaticResource DialogButton}" Margin="8,0,0,0"
                        Foreground="{DynamicResource AccentBrush}" Click="OnPrimary">
                    <TextBlock x:Name="PrimaryText" Text="Record" FontWeight="SemiBold" />
                </Button>
                <Button x:Name="SecondaryButton" DockPanel.Dock="Right" Theme="{StaticResource DialogButton}" Content="Cancel"
                        Click="OnSecondary" />
                <Button x:Name="ShowFileButton" DockPanel.Dock="Left" Theme="{StaticResource DialogButton}" Content="Show in Finder"
                        IsVisible="False" Click="OnShowFile" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
