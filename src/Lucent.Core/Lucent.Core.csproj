<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The parts of Lucent that don't depend on Windows: audio analysis, the equalizer, the editor's
    effects, export, tags, the library, playlists and settings. Shared by the Windows app now and
    by a Mac app later, so nothing in here may use WPF, Direct3D or Windows-only APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lucent.Core</AssemblyName>
    <RootNamespace>Lucent</RootNamespace>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <!--
      ONNX Runtime's .NET side, for the stem splitter. Each app brings the native library that fits it:
      DirectML's build on Windows (any DirectX 12 graphics card), the standard one (with Core ML) on a Mac.
      1.23.0 is the newest with both a DirectML build and Intel Mac libraries.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.0" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <!-- A managed MP3 decoder, for online radio: the same on every platform, and it decodes a stream frame by frame. -->
    <PackageReference Include="NLayer.NAudioSupport" Version="1.4.0" />
    <!-- A managed AAC and HE-AAC (AAC+) decoder, for the AAC radio stations, the same on every platform. MIT. -->
    <PackageReference Include="SharpJaad.AAC" Version="0.1.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <!--
      libVLC's .NET side, for playing videos (see Video/VideoStream.cs). Each app brings libVLC itself, built for it:
      VideoLAN.LibVLC.Windows on Windows, VideoLAN.LibVLC.Mac on a Mac. LGPL 2.1, like libVLC.
    -->
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lucent Classic, Lucent's own classic Winamp skin. Drawn by tools/ClassicSkin/make_lucent_classic.py. -->
    <EmbeddedResource Include="ClassicSkins\LucentClassic.wsz" LogicalName="LucentClassic.wsz" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Lucent's Spotify app, for signing in to Spotify (see Streaming/SpotifySignIn.cs). CI passes the
      SPOTIFY_CLIENT_ID repository secret as -p:SpotifyClientId; a build without it just can't sign in.
    -->
    <AssemblyMetadata Include="SpotifyClientId" Value="$(SpotifyClientId)" />
    <!--
      Where crash reports go (see Diagnostics/CrashReporter.cs): the LUCENT_CRASH_DSN repository secret, a
      Sentry project's DSN, passed by CI as -p:CrashReportDsn. A build without it sends no crash reports.
    -->
    <AssemblyMetadata Include="CrashReportDsn" Value="$(CrashReportDsn)" />
    <!--
      Lucent's Last.fm app, for scrobbling (see Lastfm/LastfmClient.cs): the LASTFM_API_KEY and LASTFM_SHARED_SECRET
      repository secrets, passed by CI as -p:LastfmApiKey and -p:LastfmSharedSecret. A build without them can't sign in.
    -->
    <AssemblyMetadata Include="LastfmApiKey" Value="$(LastfmApiKey)" />
    <AssemblyMetadata Include="LastfmSharedSecret" Value="$(LastfmSharedSecret)" />
  </ItemGroup>

</Project>
