<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The parts of Lucent that don't depend on Windows: audio analysis, the equalizer, the editor's
    effects, export, tags, the library, playlists and settings. Shared by the Windows app now and
    by a Mac app later, so nothing in here may use WPF, Direct3D or Windows-only APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lucent.Core</AssemblyName>
    <RootNamespace>WinampInspiredVisualizer</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <!--
      ONNX Runtime's .NET side, for the stem splitter. Each app brings the native library that fits it:
      DirectML's build on Windows (any DirectX 12 graphics card), the standard one (with Core ML) on a Mac.
      1.23.0 is the newest with both a DirectML build and Intel Mac libraries.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.0" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
