MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=4.000000
fGammaAdj=1.000000
fDecay=0.980000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=7
bAdditiveWaves=1
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=1
bMaximizeWaveColor=1
bTexWrap=0
bDarkenCenter=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=1.000000
fWaveScale=1.000000
fWaveSmoothing=0.500000
fWaveParam=0.500000
fModWaveAlphaStart=0.500000
fModWaveAlphaEnd=1.200000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=0.990000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.300000
sx=1.000000
sy=1.000000
wave_r=1.000000
wave_g=0.300000
wave_b=0.700000
wave_x=0.500000
wave_y=0.300000
ob_size=0.010000
ob_r=0.100000
ob_g=0.000000
ob_b=0.200000
ob_a=0.300000
ib_size=0.000000
ib_a=0.000000
mv_a=0.000000
shapecode_0_enabled=1
shapecode_0_sides=3
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=12
shapecode_0_x=0.500000
shapecode_0_y=0.500000
shapecode_0_rad=0.050000
shapecode_0_ang=0.000000
shapecode_0_tex_ang=0.000000
shapecode_0_tex_zoom=1.000000
shapecode_0_r=1.000000
shapecode_0_g=1.000000
shapecode_0_b=1.000000
shapecode_0_a=0.400000
shapecode_0_r2=1.000000
shapecode_0_g2=0.000000
shapecode_0_b2=0.500000
shapecode_0_a2=0.000000
shapecode_0_border_r=1.000000
shapecode_0_border_g=1.000000
shapecode_0_border_b=1.000000
shapecode_0_border_a=0.000000
shape_0_init1=t1 = rand(1000) * 0.001;
shape_0_per_frame1=// Twelve sparks thrown out on a spiral; the beat throws them further.
shape_0_per_frame2=k = instance / num_inst;
shape_0_per_frame3=spin = time * 0.5 + k * 6.2832 + t1;
shape_0_per_frame4=reach = 0.1 + 0.3 * k * (0.6 + 0.4 * bass_att);
shape_0_per_frame5=x = 0.5 + cos(spin) * reach * aspecty;
shape_0_per_frame6=y = 0.5 + sin(spin) * reach;
shape_0_per_frame7=ang = spin;
shape_0_per_frame8=r = 0.5 + 0.5 * sin(k * 6 + time);
shape_0_per_frame9=b = 0.5 + 0.5 * cos(k * 4 + time * 0.7);
per_frame_1=q1 = time * 0.05;
per_frame_2=q2 = 1 + floor(bass_att * 2) % 3;
per_frame_3=wave_mystery = 0.5 * sin(time * 0.29);
per_pixel_1=// A gentle breathing zoom, stronger where the image is further out.
per_pixel_2=zoom = zoom - 0.02 * sin(rad * 6 - time * 2) * mid_att;
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_fc_main, uv).xyz * 0.97;
warp_4=`    ret += (tex2D(sampler_noise_lq, uv_orig * 4 + rand_frame.xy).xyz - 0.5) * 0.01;
warp_5=`}
comp_1=`// Folds the picture into a kaleidoscope; the number of folds steps with the bass.
comp_2=`float2 fold(float2 p, float n)
comp_3=`{
comp_4=`    float a = atan2(p.y, p.x) + q1;
comp_5=`    float sector = M_PI_2 / (n * 2.0);
comp_6=`    a = abs(fmod(a + sector * 100.0, sector * 2.0) - sector);
comp_7=`    return float2(cos(a), sin(a)) * length(p);
comp_8=`}
comp_9=`
comp_10=`shader_body
comp_11=`{
comp_12=`    float2 p = (uv - 0.5) * aspect.xy;
comp_13=`    float2 folded = fold(p, q2 + 2.0) * aspect.zw + 0.5;
comp_14=`    ret = tex2D(sampler_main, folded).xyz;
comp_15=`    ret += GetBlur1(folded) * 0.5;
comp_16=`    ret = lerp(ret, ret * hue_shader, 0.5) * 1.2;
comp_17=`}
