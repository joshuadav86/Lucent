wave_0_per_frame1=// The spectrum as a ring around the bloom, its colour following the bass.
wave_0_per_frame2=t1 = 0.25 + 0.1 * bass_att;
wave_0_per_frame3=r = 0.6 + 0.4 * sin(time * 0.7);
wave_0_per_frame4=g = 0.4 + 0.3 * sin(time * 0.5 + 1);
wave_0_per_frame5=b = 1;
wave_0_per_point1=ang = sample * 6.2832 + time * 0.1;
wave_0_per_point2=dist = t1 + value1 * 0.25;
wave_0_per_point3=x = 0.5 + cos(ang) * dist * aspecty;
wave_0_per_point4=y = 0.5 + sin(ang) * dist;
wave_0_per_point5=a = 0.3 + value1;
