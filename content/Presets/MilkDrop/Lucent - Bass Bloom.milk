shape_1_per_frame1=// Six hexagons orbit the middle, each a little window onto the last frame.
shape_1_per_frame2=orbit = instance / num_inst * 6.2832 + time * 0.3;
shape_1_per_frame3=x = 0.5 + cos(orbit) * 0.33 * aspecty;
shape_1_per_frame4=y = 0.5 + sin(orbit) * 0.33;
shape_1_per_frame5=ang = -orbit;
shape_1_per_frame6=tex_ang = time * 0.2;
shape_1_per_frame7=rad = 0.07 + 0.03 * treb_att;
per_frame_1=wave_x = 0.2 + 0.02 * sin(time * 0.4);
per_frame_2=wave_mystery = sin(time * 0.13);
per_frame_3=decay = 0.92 + 0.05 * below(vol, 0.8);
per_frame_4=rot = 0.003 * sin(time * 0.2);
