MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=4.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=2
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.700000
fWaveScale=0.900000
fWaveSmoothing=0.700000
fWaveParam=0.000000
fModWaveAlphaStart=0.750000
fModWaveAlphaEnd=0.950000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.000000
sx=1.000000
sy=1.000000
wave_r=0.500000
wave_g=0.800000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.000000
ob_a=0.000000
ib_size=0.000000
ib_a=0.000000
mv_a=0.000000
b1n=0.000000
b2n=0.000000
b3n=0.000000
b1x=1.000000
b2x=1.000000
b3x=1.000000
b1ed=0.250000
per_frame_init_1=drift = 0;
per_frame_1=// q1/q2 steer the flow in the warp shader; q3 is how hard it pushes.
per_frame_2=drift = drift + 0.01 * (1 + mid_att);
per_frame_3=q1 = cos(drift * 0.7);
per_frame_4=q2 = sin(drift * 0.9);
per_frame_5=q3 = 0.002 + 0.004 * min(bass_att, 2);
per_frame_6=q4 = 0.5 + 0.5 * sin(time * 0.17);
per_frame_7=wave_r = 0.5 + 0.5 * sin(time * 1.1);
per_frame_8=wave_g = 0.5 + 0.5 * sin(time * 1.3 + 2);
per_frame_9=zoom = 1.002;
warp_1=`// Flow the old picture along a slowly turning field of noise, pushed by the bass.
warp_2=`sampler sampler_noise_hq;
warp_3=`float4 texsize_noise_hq;
warp_4=`
warp_5=`shader_body
warp_6=`{
warp_7=`    float2 flow = tex2D(sampler_noise_hq, uv * 0.6 + float2(q1, q2) * 0.05).xy - 0.5;
warp_8=`    float2 swirl = float2(-flow.y, flow.x);
warp_9=`    float2 at = uv + (flow + swirl * q4) * q3 * 8.0;
warp_10=`    ret = tex2D(sampler_main, at).xyz;
warp_11=`    // A touch of the blurred image keeps edges soft, as glass would.
warp_12=`    ret = lerp(ret, GetBlur1(at), 0.15);
warp_13=`    ret *= 0.985;
warp_14=`    ret -= 0.002;
warp_15=`}
comp_1=`// Light through glass: the blur picks out highlights, tinted by the hue shader.
comp_2=`shader_body
comp_3=`{
comp_4=`    float3 base = tex2D(sampler_main, uv).xyz;
comp_5=`    float3 soft = GetBlur2(uv);
comp_6=`    float edge = saturate(length(GetBlur1(uv) - base) * 4.0);
comp_7=`    ret = base * 1.3 + soft * 0.6 + edge * hue_shader * 0.6;
comp_8=`    ret *= 0.9 + 0.2 * rad;
comp_9=`}
