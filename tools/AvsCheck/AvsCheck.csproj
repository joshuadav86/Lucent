<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks Lucent's AVS support without a graphics card: reads and runs Winamp AVS presets for a few
    seconds of made-up music, says which effects each one leaves out, and how long a frame takes, and
    can save a frame of each as a PNG for checking by eye. See Program.cs for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lucent.AvsCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lucent.Core\Lucent.Core.csproj" />
  </ItemGroup>

</Project>
