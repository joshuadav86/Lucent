<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks Lucent full screen (FullScreenLayout in Lucent.Core) lays every window out well: on common
    screens at 100% to 200% scaling, every window fits, at its smallest size or more, with none
    over another or off the screen, and locked windows are left alone. See Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lucent.LayoutCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lucent.Core\Lucent.Core.csproj" />
  </ItemGroup>

</Project>
