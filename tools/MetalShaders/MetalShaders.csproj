<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Translates the visuals' HLSL into Metal for the Mac app: HLSL to SPIR-V with Microsoft's DXC compiler (its command line tool, set $DXC or put it on the PATH),
    then SPIR-V to Metal Shading Language with Khronos's SPIRV-Cross. DXC only ships for Windows and
    Linux, so this runs there (in CI, on Linux) and the Mac build picks up the results.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Lucent.MetalShaders</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translation rules, shared with the Mac app (which translates the user's own visuals as it runs). -->
    <Compile Include="..\..\src\Lucent.Mac\Visuals\MetalTranslation.cs" Link="MetalTranslation.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lucent.Core\Lucent.Core.csproj" />
  </ItemGroup>

</Project>
